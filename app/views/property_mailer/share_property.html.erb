<%
  property_url = "https://agencegaremonaco.com/fr/biens/#{@property.id}-#{@property.slug_for(:fr)}"
  navy   = "#090956"
  accent = "#6E8297"
  ink    = "#212529"
  hero   = @hero_image && (@hero_image.large_url.presence || @hero_image.medium_url.presence || @hero_image.remote_url)
  rental = @property.transaction_type == "rental"

  # (svg, value) pairs for the stat strip — only rendered when the value is present.
  stat = ->(path) {
    %(<svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="vertical-align:middle;">#{path}</svg>)
  }
  icon_rooms    = stat.call(%(<path d="M3 11 12 4l9 7M5 10v10h14V10" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>))
  icon_bedrooms = stat.call(%(<path d="M3 18v-5h18v5M3 13V8a2 2 0 0 1 2-2h6v7M11 13V6h6a2 2 0 0 1 2 2v5M3 18v2M21 18v2" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>))
  icon_baths    = stat.call(%(<path d="M4 12V6a2 2 0 0 1 2-2 2 2 0 0 1 2 2M3 12h18v3a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4v-3ZM6 19l-1 2M18 19l1 2" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>))
  icon_parking  = stat.call(%(<path d="M5 17v-5l2-5h10l2 5v5M5 17v2M19 17v2M5 12h14M8 12.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0ZM19 12.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>))
  icon_area     = stat.call(%(<path d="M4 4h16v16H4zM4 9h3M4 14h3M9 20v-3M14 20v-3" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>))

  stats = []
  stats << [icon_rooms,    @property.num_rooms]                                  if @property.num_rooms.to_i.positive?
  stats << [icon_bedrooms, @property.num_bedrooms]                              if @property.num_bedrooms.to_i.positive?
  stats << [icon_baths,    @property.num_bathrooms]                             if @property.num_bathrooms.to_i.positive?
  stats << [icon_parking,  @property.num_parkings]                              if @property.num_parkings.to_i.positive?
  stats << [icon_area,     "#{@property.living_area.to_i} m&sup2;".html_safe]   if @property.living_area.to_f.positive?
%>
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title><%= @property.title_for(:fr) %></title>
</head>
<body style="margin:0; padding:0; background-color:#f1f1f1; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%;">
  <!-- preview text -->
  <div style="display:none; max-height:0; overflow:hidden; opacity:0;">
    <%= @property.title_for(:fr) %><% if @property.formatted_price %> — <%= @property.formatted_price %> €<% end %>
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f1f1f1;">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px; max-width:600px; background-color:#ffffff;">

          <!-- logo -->
          <tr>
            <td align="center" style="padding:32px 24px 24px;">
              <%= image_tag image_url("logo.png"),
                    alt: "Agence Immobilière de la Gare",
                    width: 280,
                    style: "display:block; width:280px; max-width:80%; height:auto; border:0;" %>
            </td>
          </tr>

          <!-- agent block -->
          <tr>
            <td style="padding:8px 32px 28px; font-family:Arial, Helvetica, sans-serif; color:<%= accent %>; font-size:14px; line-height:1.6;">
              <span style="color:<%= ink %>;"><%= @agent[:name] %></span><br>
              <a href="mailto:<%= @agent[:email] %>" style="color:<%= accent %>; text-decoration:none;"><%= @agent[:email] %></a><br>
              T: <a href="tel:<%= @agent[:phone].delete(' ') %>" style="color:<%= accent %>; text-decoration:none;"><%= @agent[:phone] %></a>
            </td>
          </tr>

          <!-- hero image -->
          <% if hero %>
          <tr>
            <td style="padding:0 32px;">
              <a href="<%= property_url %>" style="text-decoration:none;">
                <%= image_tag hero,
                      alt: @property.title_for(:fr),
                      width: 536,
                      style: "display:block; width:100%; max-width:536px; height:auto; border:0;" %>
              </a>
            </td>
          </tr>
          <% end %>

          <!-- navy detail card -->
          <tr>
            <td style="padding:0 32px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:<%= navy %>; background-image:linear-gradient(135deg,#0d0d6e 0%,<%= navy %> 55%,#060638 100%);">
                <tr>
                  <td style="padding:32px 28px;">

                    <!-- title -->
                    <h1 style="margin:0; font-family:Arial, Helvetica, sans-serif; color:#ffffff; font-size:20px; line-height:1.35; font-weight:bold; text-align:center;">
                      <%= @property.title_for(:fr) %>
                    </h1>

                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr><td style="border-top:1px solid rgba(255,255,255,0.18); font-size:0; line-height:0; padding-top:20px;">&nbsp;</td></tr>
                    </table>

                    <!-- intro -->
                    <% if @property.intro_for(:fr).present? %>
                      <p style="margin:20px 0 0; font-family:Arial, Helvetica, sans-serif; color:rgba(255,255,255,0.88); font-size:14px; line-height:1.7; text-align:center;">
                        <%= @property.intro_for(:fr) %>
                      </p>
                    <% end %>

                    <% if stats.any? %>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr><td style="border-top:1px solid rgba(255,255,255,0.18); font-size:0; line-height:0; padding-top:22px;">&nbsp;</td></tr>
                    </table>

                    <!-- stats strip -->
                    <table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0" style="margin:22px auto 0;">
                      <tr>
                        <% stats.each do |svg, value| %>
                          <td style="padding:0 10px; font-family:Arial, Helvetica, sans-serif; color:#ffffff; font-size:14px; white-space:nowrap;" valign="middle">
                            <%= svg.html_safe %>&nbsp;<span style="vertical-align:middle;"><%= value %></span>
                          </td>
                        <% end %>
                      </tr>
                    </table>
                    <% end %>

                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr><td style="border-top:1px solid rgba(255,255,255,0.18); font-size:0; line-height:0; padding-top:26px;">&nbsp;</td></tr>
                    </table>

                    <!-- CTA button -->
                    <table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0" style="margin:26px auto 0;">
                      <tr>
                        <td align="center" style="background-color:#ffffff;">
                          <a href="<%= property_url %>"
                             style="display:inline-block; padding:13px 38px; font-family:Arial, Helvetica, sans-serif; color:<%= navy %>; font-size:14px; font-weight:bold; text-decoration:none;">
                            Détails
                          </a>
                        </td>
                      </tr>
                    </table>

                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- footer -->
          <tr>
            <td align="center" style="padding:8px 32px 40px; font-family:Arial, Helvetica, sans-serif; color:<%= accent %>; font-size:12px; line-height:1.7;">
              <strong style="color:<%= accent %>;">Agence de la Gare</strong><br>
              3, Rue Langlé<br>
              MC 98000 Monaco<br><br>
              (+377) 93 30 22 36<br>
              <a href="https://agencegaremonaco.com" style="color:<%= accent %>; text-decoration:none;">agencegaremonaco.com</a>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
