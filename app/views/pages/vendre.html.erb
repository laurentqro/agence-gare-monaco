<%= json_ld_faq([
  { question: t("vendre.estimate_title"), answer: t("vendre.estimate_text") },
  { question: t("vendre.admin_title"), answer: t("vendre.admin_text") },
  { question: t("vendre.mandate_title"), answer: t("vendre.mandate_intro") },
  { question: t("vendre.selling_title"), answer: t("vendre.selling_text_1") },
  { question: t("vendre.funds_title"), answer: t("vendre.funds_text_1") }
]) %>

<div class="max-w-4xl mx-auto px-4 py-16">
  <h1 class="heading-page mb-8"><%= t("vendre.title") %></h1>

  <div data-testid="vendre-content" class="text-body space-y-8">
    <p><%= t("vendre.intro") %></p>

    <div>
      <h2 class="heading-section mb-3"><%= t("vendre.estimate_title") %></h2>
      <p><%= t("vendre.estimate_text") %></p>
    </div>

    <div>
      <h2 class="heading-section mb-3"><%= t("vendre.admin_title") %></h2>
      <p class="mb-3"><%= t("vendre.admin_text") %></p>
      <p class="mb-3"><%= t("vendre.admin_docs_intro") %></p>
      <ul class="list-disc list-inside space-y-2 ml-4 mb-3">
        <li><%= t("vendre.admin_doc_1") %></li>
        <li><%= t("vendre.admin_doc_2") %></li>
        <li><%= t("vendre.admin_doc_3") %></li>
        <li><%= t("vendre.admin_doc_4") %></li>
        <li><%= t("vendre.admin_doc_5") %></li>
        <li><%= t("vendre.admin_doc_6") %></li>
        <li><%= t("vendre.admin_doc_7") %></li>
        <li><%= t("vendre.admin_doc_8") %></li>
      </ul>
      <p><%= t("vendre.admin_mandate_intro") %></p>
    </div>

    <div>
      <h2 class="heading-section mb-3"><%= t("vendre.mandate_title") %></h2>
      <p class="mb-4"><%= t("vendre.mandate_intro") %></p>

      <div class="space-y-4 ml-4">
        <div>
          <h3 class="text-base font-semibold text-navy mb-2"><%= t("vendre.mandate_simple_title") %></h3>
          <p class="mb-2"><%= t("vendre.mandate_simple_text_1") %></p>
          <p class="mb-2"><%= t("vendre.mandate_simple_text_2") %></p>
          <p><%= t("vendre.mandate_simple_text_3") %></p>
        </div>

        <div>
          <h3 class="text-base font-semibold text-navy mb-2"><%= t("vendre.mandate_exclusive_title") %></h3>
          <p class="mb-2"><%= t("vendre.mandate_exclusive_text_1") %></p>
          <p class="mb-2"><%= t("vendre.mandate_exclusive_text_2") %></p>
          <p><%= t("vendre.mandate_exclusive_text_3") %></p>
        </div>

        <div>
          <h3 class="text-base font-semibold text-navy mb-2"><%= t("vendre.mandate_coexclusive_title") %></h3>
          <p class="mb-2"><%= t("vendre.mandate_coexclusive_text_1") %></p>
          <p><%= t("vendre.mandate_coexclusive_text_2") %></p>
        </div>
      </div>

      <p class="mt-4"><%= t("vendre.mandate_choice") %></p>
    </div>

    <div>
      <h2 class="heading-section mb-3"><%= t("vendre.selling_title") %></h2>
      <p class="mb-3"><%= t("vendre.selling_text_1") %></p>
      <p class="mb-3"><%= t("vendre.selling_text_2") %></p>
      <p class="mb-3"><%= t("vendre.selling_text_3") %></p>
      <p><%= t("vendre.selling_text_4") %></p>
    </div>

    <div>
      <h2 class="heading-section mb-3"><%= t("vendre.funds_title") %></h2>
      <p class="mb-3"><%= t("vendre.funds_text_1") %></p>
      <p><%= t("vendre.funds_text_2") %></p>
    </div>
  </div>

  <div class="relative mt-16 overflow-hidden rounded-lg" data-testid="vendre-cta">
    <%= image_tag "monaco-panorama.jpg", alt: "", class: "absolute inset-0 w-full h-full object-cover", "aria-hidden": "true" %>
    <div class="absolute inset-0 bg-navy/70"></div>
    <div class="relative z-10 px-8 py-16 text-center">
      <h2 class="text-3xl md:text-4xl font-light text-white mb-4"><%= t("vendre.cta_title") %></h2>
      <p class="text-sm md:text-base text-white/80 max-w-2xl mx-auto"><%= t("vendre.cta_text") %></p>
    </div>
  </div>

  <div class="mt-10">
    <%= render "shared/contact_form", submission: @submission, return_to: "vendre" %>
  </div>
</div>
