<div class="max-w-4xl mx-auto px-4 py-16">
  <h1 class="heading-page mb-8"><%= t("gestion.title") %></h1>

  <div data-testid="gestion-content" class="text-body space-y-8">
    <p><%= t("gestion.intro") %></p>

    <div>
      <h2 class="heading-section mb-3"><%= t("gestion.missions_title") %></h2>
      <p><%= t("gestion.missions_text") %></p>
    </div>

    <div>
      <h2 class="heading-section mb-3"><%= t("gestion.publication_title") %></h2>
      <p class="mb-3"><%= t("gestion.publication_text_1") %></p>
      <p class="mb-3"><%= t("gestion.publication_text_2") %></p>
      <ul class="list-disc list-inside space-y-2 ml-4 mb-3">
        <li><%= t("gestion.publication_item_1") %></li>
        <li><%= t("gestion.publication_item_2") %></li>
        <li><%= t("gestion.publication_item_3") %></li>
      </ul>
      <p class="mb-3"><%= t("gestion.publication_text_3") %></p>
      <ul class="list-disc list-inside space-y-2 ml-4 mb-3">
        <li><%= t("gestion.publication_question_1") %></li>
        <li><%= t("gestion.publication_question_2") %></li>
      </ul>
      <p><%= t("gestion.publication_text_4") %></p>
    </div>

    <div>
      <h2 class="heading-section mb-3"><%= t("gestion.contract_title") %></h2>
      <p class="mb-3"><%= t("gestion.contract_text_1") %></p>
      <p class="mb-3"><%= t("gestion.contract_text_2") %></p>
      <p class="mb-3"><%= t("gestion.contract_text_3") %></p>
      <p><%= t("gestion.contract_text_4") %></p>
    </div>

    <div>
      <h2 class="heading-section mb-3"><%= t("gestion.life_title") %></h2>
      <p class="mb-3"><%= t("gestion.life_text_1") %></p>
      <p class="mb-3"><%= t("gestion.life_text_2") %></p>
      <p><%= t("gestion.life_text_3") %></p>
    </div>

    <div>
      <h2 class="heading-section mb-3"><%= t("gestion.funds_title") %></h2>
      <p class="mb-3"><%= t("gestion.funds_text_1") %></p>
      <p><%= t("gestion.funds_text_2") %></p>
    </div>
  </div>

  <div class="relative mt-16 overflow-hidden rounded-lg" data-testid="gestion-cta">
    <%= image_tag "monaco-panorama.jpg", alt: "", class: "absolute inset-0 w-full h-full object-cover", "aria-hidden": "true" %>
    <div class="absolute inset-0 bg-navy/70"></div>
    <div class="relative z-10 px-8 py-16 text-center">
      <h2 class="text-3xl md:text-4xl font-light text-white mb-4"><%= t("gestion.cta_title") %></h2>
      <p class="text-sm md:text-base text-white/80 max-w-2xl mx-auto"><%= t("gestion.cta_text") %></p>
    </div>
  </div>

  <div class="mt-10">
    <%= render "shared/contact_form", submission: @submission, return_to: "gestion" %>
  </div>
</div>
