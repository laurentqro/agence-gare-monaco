<%# === FAQ Page === %>
<section class="max-w-3xl mx-auto px-4 py-16">
  <h1 class="heading-section text-center mb-8">
    <%= t("homepage.faq_title") %>
  </h1>
  <div class="space-y-8">
    <% t("homepage.faqs").each do |faq| %>
      <div data-testid="faq-item">
        <h2 class="text-lg font-semibold text-navy mb-2"><%= faq[:question] %></h2>
        <p class="text-body"><%= faq[:answer] %></p>
      </div>
    <% end %>
  </div>
</section>
