<div class="max-w-7xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-[#090956] mb-8 text-center"><%= t("contact_form.title") %></h1>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
    <%# Contact information %>
    <div>
      <h2 class="text-lg font-bold text-[#090956] mb-4"><%= t("contact_form.info_title") %></h2>
      <div class="text-xs text-[#212529] leading-relaxed space-y-3">
        <p class="font-semibold">Agence Immobilière de la Gare</p>
        <p class="text-[#6E8297]">
          3, Rue Langlé<br>
          MC 98000 Monaco
        </p>
        <p>
          <span class="text-[#6E8297]"><%= t("contact_form.phone") %>:</span>
          (+377) 93 30 22 36
        </p>
        <p>
          <span class="text-[#6E8297]"><%= t("contact_form.fax") %>:</span>
          (+377) 93 25 05 34
        </p>
        <p>
          <a href="mailto:info@agencegaremonaco.com" class="text-[#090956] hover:text-[#6E8297] font-medium">
            info@agencegaremonaco.com
          </a>
        </p>
      </div>
    </div>

    <%# Contact form %>
    <div>
      <% submission = @submission || ContactSubmission.new %>
      <% if submission.errors.any? %>
        <div data-testid="form-errors" class="bg-red-50 border border-red-200 rounded p-4 mb-6">
          <ul class="text-xs text-red-600 space-y-1">
            <% submission.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with(model: submission, url: contact_submissions_path, method: :post, local: true, class: "space-y-4") do |f| %>
        <%# Honeypot field - hidden from humans, bots fill it %>
        <div style="position: absolute; left: -9999px;" aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" name="website" id="website" tabindex="-1" autocomplete="off">
        </div>

        <div>
          <label for="contact_submission_name" class="block text-xs font-medium text-[#212529] mb-1">
            <%= t("contact_form.name") %> *
          </label>
          <%= f.text_field :name, class: "w-full border border-gray-300 rounded px-3 py-2 text-xs focus:border-[#090956] focus:outline-none", required: true %>
        </div>

        <div>
          <label for="contact_submission_email" class="block text-xs font-medium text-[#212529] mb-1">
            <%= t("contact_form.email") %> *
          </label>
          <%= f.email_field :email, class: "w-full border border-gray-300 rounded px-3 py-2 text-xs focus:border-[#090956] focus:outline-none", required: true %>
        </div>

        <div>
          <label for="contact_submission_subject" class="block text-xs font-medium text-[#212529] mb-1">
            <%= t("contact_form.subject") %>
          </label>
          <%= f.text_field :subject, class: "w-full border border-gray-300 rounded px-3 py-2 text-xs focus:border-[#090956] focus:outline-none" %>
        </div>

        <div>
          <label for="contact_submission_message" class="block text-xs font-medium text-[#212529] mb-1">
            <%= t("contact_form.message") %> *
          </label>
          <%= f.text_area :message, rows: 6, class: "w-full border border-gray-300 rounded px-3 py-2 text-xs focus:border-[#090956] focus:outline-none", required: true %>
        </div>

        <div>
          <%= f.submit t("contact_form.send"), class: "bg-white border border-[#2E4C87] text-[#090956] px-6 py-2 rounded text-xs font-semibold hover:bg-gray-50 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
