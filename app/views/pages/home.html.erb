<% content_for :homepage, "true" %>

<%# === Hero Section with Service Cards === %>
<section data-testid="hero" class="relative h-screen flex flex-col bg-navy overflow-hidden">
  <%# Background video %>
  <video playsinline autoplay muted loop class="absolute inset-0 w-full h-full object-cover">
    <source src="/videos/hero-bg.mp4" type="video/mp4">
  </video>

  <%# Background overlay %>
  <div class="absolute inset-0 bg-black/40 z-10"></div>

  <%# Hero content — all centered %>
  <div class="relative z-20 flex-1 flex items-center justify-center text-center text-white px-4">
    <div>
      <%# Line 1: Header %>
      <h1 class="text-3xl md:text-5xl font-bold tracking-wide mb-4">
        <%= t("homepage.hero_title") %>
      </h1>

      <%# Line 2: Tagline %>
      <p class="text-base md:text-xl font-light tracking-wider mb-6">
        <%= t("homepage.hero_subtitle") %>
      </p>

      <%# Line 3: Separator %>
      <div class="w-20 h-0.5 bg-gold mx-auto mb-8"></div>

      <%# Line 4: Service cards %>
    </div>
  </div>
</section>

<%# === Videos Section === %>
<section data-testid="videos" class="w-full max-w-7xl mx-auto px-4 py-16" data-controller="videos-carousel">
  <h2 class="heading-section !text-2xl md:!text-3xl text-center mb-8">
    <%= t("homepage.videos_title") %>
  </h2>
  <% if @youtube_videos&.any? %>
    <div class="relative">
      <div class="overflow-hidden">
        <div data-videos-carousel-target="track" class="flex transition-transform duration-500 -mx-3">
          <% @youtube_videos.each do |video| %>
            <div data-videos-carousel-target="slide" data-testid="video-slide" class="shrink-0 w-full md:w-1/3 px-3">
              <div class="aspect-video rounded overflow-hidden">
                <iframe src="<%= video.embed_url %>"
                        class="w-full h-full"
                        frameborder="0"
                        loading="lazy"
                        allowfullscreen
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture">
                </iframe>
              </div>
              <p class="text-xs text-dark mt-2"><%= video.title %></p>
            </div>
          <% end %>
        </div>
      </div>
      <button data-videos-carousel-target="prevButton" data-action="videos-carousel#prev" class="hidden absolute -left-2 md:-left-5 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white rounded-full p-2 shadow-lg" aria-label="<%= t('shared.previous', default: 'Previous') %>">
        <svg class="w-5 h-5 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button data-videos-carousel-target="nextButton" data-action="videos-carousel#next" class="hidden absolute -right-2 md:-right-5 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white rounded-full p-2 shadow-lg" aria-label="<%= t('shared.next', default: 'Next') %>">
        <svg class="w-5 h-5 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>
    <div class="text-center mt-10">
      <%= link_to YoutubeVideo::CHANNEL_URL,
            target: "_blank", rel: "noopener noreferrer",
            class: "inline-flex items-center gap-2 px-5 py-3 border border-navy text-navy hover:bg-navy hover:text-white transition-colors text-xs font-semibold uppercase tracking-wide rounded" do %>
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.546 15.568V8.432L15.818 12l-6.272 3.568z"/></svg>
        <span><%= t("homepage.videos_view_channel") %></span>
      <% end %>
    </div>
  <% end %>
</section>

<hr class="max-w-7xl mx-auto border-gray-200">

<%# === Featured Articles === %>
<section data-testid="featured-articles" class="w-full max-w-7xl mx-auto px-4 py-16" data-controller="articles-carousel">
  <h2 class="heading-section !text-2xl md:!text-3xl text-center mb-8">
    <%= t("homepage.featured_articles_title") %>
  </h2>
  <% if @latest_articles.any? %>
    <div class="relative">
      <div class="overflow-hidden">
        <div data-articles-carousel-target="track" class="flex transition-transform duration-500 -mx-3">
          <% @latest_articles.each do |article| %>
            <div data-articles-carousel-target="slide" data-testid="article-slide" class="shrink-0 w-full md:w-1/3 px-3">
              <%= render "shared/article_card", article: article, article_path: "#{locale_articles_path}/#{article.slug}" %>
            </div>
          <% end %>
        </div>
      </div>
      <button data-articles-carousel-target="prevButton" data-action="articles-carousel#prev" class="hidden absolute -left-2 md:-left-5 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white rounded-full p-2 shadow-lg" aria-label="<%= t('shared.previous', default: 'Previous') %>">
        <svg class="w-5 h-5 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button data-articles-carousel-target="nextButton" data-action="articles-carousel#next" class="hidden absolute -right-2 md:-right-5 top-1/2 -translate-y-1/2 bg-white/90 hover:bg-white rounded-full p-2 shadow-lg" aria-label="<%= t('shared.next', default: 'Next') %>">
        <svg class="w-5 h-5 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>
    <div class="text-center mt-10">
      <%= link_to t("homepage.articles_view_all"), locale_articles_path,
            class: "inline-flex items-center gap-2 px-5 py-3 border border-navy text-navy hover:bg-navy hover:text-white transition-colors text-xs font-semibold uppercase tracking-wide rounded" %>
    </div>
  <% end %>
</section>

<%# === Team Photo === %>
<section data-testid="team-photo" class="w-full">
  <%= image_tag "team-2026.jpg", alt: t("homepage.about_title"), class: "w-full h-[70vh] object-cover" %>
</section>

<hr class="max-w-7xl mx-auto border-gray-200">

<%# === About Section === %>
<section data-testid="about" class="max-w-3xl mx-auto px-4 py-16">
  <h2 class="heading-section !text-2xl md:!text-3xl text-center mb-8">
    <%= t("homepage.about_title") %>
  </h2>
  <div class="text-body text-justify space-y-6">
    <div data-citation="history" class="space-y-4">
      <%= simple_format(t("homepage.about_history"), {}, wrapper_tag: "p") %>
    </div>
    <div data-citation="services" class="space-y-4">
      <%= simple_format(t("homepage.about_services"), {}, wrapper_tag: "p") %>
    </div>
    <div data-citation="expertise" class="space-y-4">
      <%= simple_format(t("homepage.about_expertise"), {}, wrapper_tag: "p") %>
    </div>
  </div>
</section>

<hr class="max-w-7xl mx-auto border-gray-200">

<%# === Image Carousel === %>
<section data-testid="carousel" class="w-full" data-controller="carousel">
  <div class="relative overflow-hidden">
    <div data-carousel-target="track" class="flex transition-transform duration-500">
      <div data-testid="carousel-slide" class="min-w-full">
        <img src="/images/carousel/agence-gare-monaco-2025-9.jpg" alt="Agence Immobilière de la Gare Monaco" class="w-full h-[70vh] object-cover" loading="eager">
      </div>
      <div data-testid="carousel-slide" class="min-w-full">
        <img src="/images/carousel/agence-gare-monaco-2025-12.jpg" alt="Agence Immobilière de la Gare Monaco" class="w-full h-[70vh] object-cover" loading="lazy">
      </div>
      <div data-testid="carousel-slide" class="min-w-full">
        <img src="/images/carousel/agence-gare-monaco-2025-34.jpg" alt="Agence Immobilière de la Gare Monaco" class="w-full h-[70vh] object-cover" loading="lazy">
      </div>
      <div data-testid="carousel-slide" class="min-w-full">
        <img src="/images/carousel/agence-gare-monaco-2025-41.jpg" alt="Agence Immobilière de la Gare Monaco" class="w-full h-[70vh] object-cover" loading="lazy">
      </div>
      <div data-testid="carousel-slide" class="min-w-full">
        <img src="/images/carousel/team3.jpg" alt="Équipe Agence Immobilière de la Gare" class="w-full h-[70vh] object-cover" loading="lazy">
      </div>
    </div>
    <%# Navigation buttons %>
    <button data-action="carousel#prev" class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full p-3 shadow-lg" aria-label="Previous">
      <svg class="w-5 h-5 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </button>
    <button data-action="carousel#next" class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full p-3 shadow-lg" aria-label="Next">
      <svg class="w-5 h-5 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </button>
  </div>
</section>

