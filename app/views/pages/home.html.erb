<% content_for :homepage, "true" %>

<%# === Hero Section === %>
<section data-testid="hero" class="relative h-screen flex items-center justify-center bg-[#090956] overflow-hidden">
  <%# Background video %>
  <video playsinline autoplay muted loop class="absolute inset-0 w-full h-full object-cover">
    <source src="/videos/hero-bg.mp4" type="video/mp4">
  </video>

  <%# Background overlay %>
  <div class="absolute inset-0 bg-black/40 z-10"></div>

  <%# Hero content %>
  <div class="relative z-20 text-center text-white px-4">
    <h1 class="text-3xl md:text-5xl font-bold tracking-wide uppercase mb-4">
      <%= t("homepage.hero_title") %>
    </h1>
    <p class="text-sm md:text-lg font-light tracking-wider">
      <%= t("homepage.hero_subtitle") %>
    </p>
  </div>
</section>

<%# === Category Cards === %>
<section data-testid="category-cards" class="max-w-7xl mx-auto px-4 py-16 -mt-20 relative z-30">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <%# Sales Monaco %>
    <a href="<%= locale_sales_monaco_path %>" class="group block bg-white rounded shadow-lg hover:shadow-xl transition-shadow p-8 text-center border border-gray-100">
      <h3 class="text-sm font-bold uppercase tracking-wide text-[#090956] mb-2">
        <%= t("homepage.category_sales_monaco") %>
      </h3>
      <p class="text-xs text-[#6E8297]"><%= t("homepage.category_sales_monaco_desc") %></p>
    </a>

    <%# Rentals Monaco %>
    <a href="<%= locale_rentals_monaco_path %>" class="group block bg-white rounded shadow-lg hover:shadow-xl transition-shadow p-8 text-center border border-gray-100">
      <h3 class="text-sm font-bold uppercase tracking-wide text-[#090956] mb-2">
        <%= t("homepage.category_rentals_monaco") %>
      </h3>
      <p class="text-xs text-[#6E8297]"><%= t("homepage.category_rentals_monaco_desc") %></p>
    </a>

    <%# France %>
    <a href="<%= locale_sales_france_path %>" class="group block bg-white rounded shadow-lg hover:shadow-xl transition-shadow p-8 text-center border border-gray-100">
      <h3 class="text-sm font-bold uppercase tracking-wide text-[#090956] mb-2">
        <%= t("homepage.category_france") %>
      </h3>
      <p class="text-xs text-[#6E8297]"><%= t("homepage.category_france_desc") %></p>
    </a>
  </div>
</section>

<hr class="max-w-7xl mx-auto border-gray-200">

<%# === About Section === %>
<section data-testid="about" class="max-w-7xl mx-auto px-4 py-16">
  <h2 class="text-2xl font-bold text-[#090956] text-center mb-8">
    <%= t("homepage.about_title") %>
  </h2>
  <div class="text-sm leading-relaxed text-[#212529] max-w-3xl mx-auto text-justify space-y-4">
    <%= simple_format(t("homepage.about_text"), {}, wrapper_tag: "p") %>
  </div>
</section>

<hr class="max-w-7xl mx-auto border-gray-200">

<%# === Image Carousel === %>
<section data-testid="carousel" class="w-full" data-controller="carousel">
  <div class="relative overflow-hidden">
    <div data-carousel-target="track" class="flex transition-transform duration-500">
      <div data-testid="carousel-slide" class="min-w-full">
        <img src="/images/carousel/agence-gare-monaco-2025-9.jpg" alt="Agence de la Gare Monaco" class="w-full h-[70vh] object-cover" loading="eager">
      </div>
      <div data-testid="carousel-slide" class="min-w-full">
        <img src="/images/carousel/agence-gare-monaco-2025-12.jpg" alt="Agence de la Gare Monaco" class="w-full h-[70vh] object-cover" loading="lazy">
      </div>
      <div data-testid="carousel-slide" class="min-w-full">
        <img src="/images/carousel/agence-gare-monaco-2025-34.jpg" alt="Agence de la Gare Monaco" class="w-full h-[70vh] object-cover" loading="lazy">
      </div>
      <div data-testid="carousel-slide" class="min-w-full">
        <img src="/images/carousel/agence-gare-monaco-2025-41.jpg" alt="Agence de la Gare Monaco" class="w-full h-[70vh] object-cover" loading="lazy">
      </div>
      <div data-testid="carousel-slide" class="min-w-full">
        <img src="/images/carousel/team3.jpg" alt="Équipe Agence de la Gare" class="w-full h-[70vh] object-cover" loading="lazy">
      </div>
    </div>
    <%# Navigation buttons %>
    <button data-action="carousel#prev" class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full p-3 shadow-lg" aria-label="Previous">
      <svg class="w-5 h-5 text-[#090956]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </button>
    <button data-action="carousel#next" class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full p-3 shadow-lg" aria-label="Next">
      <svg class="w-5 h-5 text-[#090956]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </button>
  </div>
</section>

<hr class="max-w-7xl mx-auto border-gray-200">

<%# === Videos Section === %>
<section data-testid="videos" class="max-w-7xl mx-auto px-4 py-16">
  <h2 class="text-2xl font-bold text-[#090956] text-center mb-8">
    <%= t("homepage.videos_title") %>
  </h2>
  <p class="text-sm text-[#6E8297] text-center">
    <%# YouTube videos will be loaded dynamically via YouTube Data API when API key is provided %>
  </p>
</section>

<%# === Team + Contact Section (with background image) === %>
<section data-testid="team" class="relative bg-[#090956] overflow-hidden">
  <%# Background image %>
  <div class="absolute inset-0">
    <%= image_tag "monaco-panorama.jpg", alt: "", class: "w-full h-full object-cover", "aria-hidden": "true" %>
    <div class="absolute inset-0 bg-[#090956]/75"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 py-16">
    <%# Team %>
    <h2 class="text-2xl font-bold text-white text-center mb-12 uppercase tracking-wide">
      <%= t("homepage.team_title") %>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      <div class="text-center">
        <%= image_tag "team/pierre.jpg", alt: "Pierre Maré", class: "w-36 h-36 mx-auto rounded-full object-cover mb-4 border-2 border-white/30" %>
        <h4 class="text-sm font-bold text-white uppercase tracking-wide">Pierre Maré</h4>
        <p class="text-xs text-white/70 mb-3"><%= t("homepage.team.pierre_role") %></p>
        <a href="mailto:info@agencegaremonaco.com" class="inline-flex items-center justify-center w-10 h-10 border border-white/40 rounded text-white hover:bg-white/10 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </a>
      </div>
      <div class="text-center">
        <%= image_tag "team/adrien.jpg", alt: "Adrien Maré", class: "w-36 h-36 mx-auto rounded-full object-cover mb-4 border-2 border-white/30" %>
        <h4 class="text-sm font-bold text-white uppercase tracking-wide">Adrien Maré</h4>
        <p class="text-xs text-white/70 mb-3"><%= t("homepage.team.adrien_role") %></p>
        <a href="mailto:info@agencegaremonaco.com" class="inline-flex items-center justify-center w-10 h-10 border border-white/40 rounded text-white hover:bg-white/10 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </a>
      </div>
      <div class="text-center">
        <%= image_tag "team/josiane.jpg", alt: "Josiane Alesi", class: "w-36 h-36 mx-auto rounded-full object-cover mb-4 border-2 border-white/30" %>
        <h4 class="text-sm font-bold text-white uppercase tracking-wide">Josiane Alesi</h4>
        <p class="text-xs text-white/70 mb-3"><%= t("homepage.team.josiane_role") %></p>
        <a href="mailto:info@agencegaremonaco.com" class="inline-flex items-center justify-center w-10 h-10 border border-white/40 rounded text-white hover:bg-white/10 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </a>
      </div>
    </div>

    <hr class="border-white/20 mb-16">

    <%# Contact %>
    <div data-testid="contact-section" class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <%# Left: Agency info %>
      <div>
        <p class="text-sm text-white mb-1">Agence de la Gare</p>
        <p class="text-sm text-white mb-1">3, Rue Langlé</p>
        <p class="text-sm text-white mb-4">MC 98000 Monaco</p>

        <p class="text-sm text-white mb-1">Tél : (+377) 93 30 22 36</p>
        <p class="text-sm text-white mb-4">Fax: (+377) 93 25 05 34</p>

        <div class="flex items-center space-x-3 mb-4">
          <a href="https://www.linkedin.com/company/agence-de-la-gare-monaco" class="text-white hover:text-white/70 transition-colors" title="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://www.facebook.com/agencedelagaremonaco" class="text-white hover:text-white/70 transition-colors" title="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://www.instagram.com/agencedelagaremonaco" class="text-white hover:text-white/70 transition-colors" title="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="https://www.youtube.com/channel/UC2w6AJOPj37wDZxXjWLRxtg" class="text-white hover:text-white/70 transition-colors" title="YouTube">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>

        <a href="mailto:info@agencegaremonaco.com" class="inline-block border border-white/40 text-white text-sm px-4 py-2 hover:bg-white/10 transition-colors">
          info@agencegaremonaco.com
        </a>
      </div>

      <%# Right: Contact form %>
      <div>
        <%= form_with model: @submission, url: contact_submissions_path, class: "space-y-4" do |f| %>
          <div>
            <label class="block text-sm font-bold text-white mb-1"><%= t("contact_form.name") %></label>
            <%= f.text_field :name, class: "w-full bg-white/20 border-0 text-white placeholder-white/50 px-3 py-2 text-sm focus:ring-1 focus:ring-white/40 focus:outline-none" %>
          </div>
          <div>
            <label class="block text-sm font-bold text-white mb-1"><%= t("contact_form.email") %></label>
            <%= f.email_field :email, class: "w-full bg-white/20 border-0 text-white placeholder-white/50 px-3 py-2 text-sm focus:ring-1 focus:ring-white/40 focus:outline-none" %>
          </div>
          <div>
            <label class="block text-sm font-bold text-white mb-1"><%= t("contact_form.subject") %></label>
            <%= f.text_field :subject, class: "w-full bg-white/20 border-0 text-white placeholder-white/50 px-3 py-2 text-sm focus:ring-1 focus:ring-white/40 focus:outline-none" %>
          </div>
          <div>
            <label class="block text-sm font-bold text-white mb-1"><%= t("contact_form.message") %></label>
            <%= f.text_area :message, rows: 5, class: "w-full bg-white/20 border-0 text-white placeholder-white/50 px-3 py-2 text-sm focus:ring-1 focus:ring-white/40 focus:outline-none" %>
          </div>
          <%# Honeypot %>
          <div class="absolute -left-[9999px]">
            <%= f.text_field :website, tabindex: "-1", autocomplete: "off" %>
          </div>
          <%= f.submit t("contact_form.send"), class: "border border-white/40 text-white text-sm px-6 py-2 hover:bg-white/10 transition-colors cursor-pointer" %>
        <% end %>
      </div>
    </div>
  </div>
</section>

<%# === Featured Articles === %>
<section data-testid="featured-articles" class="max-w-7xl mx-auto px-4 py-16">
  <h2 class="text-2xl font-bold text-[#090956] text-center mb-8">
    <%= t("homepage.featured_articles_title") %>
  </h2>
  <% if @featured_articles.any? %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% @featured_articles.each do |article| %>
        <a href="<%= locale_articles_path %>/<%=article.slug %>" class="group block bg-white rounded shadow hover:shadow-lg transition-shadow border border-gray-100">
          <div class="p-6">
            <h3 class="text-sm font-bold text-[#090956] group-hover:text-[#6E8297] transition-colors mb-2">
              <%= article.title[I18n.locale.to_s] || article.title[I18n.default_locale.to_s] %>
            </h3>
            <p class="text-xs text-[#6E8297] mb-3">
              <%= truncate(
                (article.body[I18n.locale.to_s] || article.body[I18n.default_locale.to_s]).to_s,
                length: 120
              ) %>
            </p>
            <span class="text-xs font-medium text-[#090956] uppercase tracking-wide"><%= t("homepage.read_more") %> &rarr;</span>
          </div>
        </a>
      <% end %>
    </div>
  <% end %>
</section>

