<% content_for :homepage, "true" %>

<%# === Hero Section with Service Cards === %>
<section data-testid="hero" class="relative h-screen flex flex-col bg-navy overflow-hidden">
  <%# Background video %>
  <video playsinline autoplay muted loop class="absolute inset-0 w-full h-full object-cover">
    <source src="/videos/hero-bg.mp4" type="video/mp4">
  </video>

  <%# Background overlay %>
  <div class="absolute inset-0 bg-black/40 z-10"></div>

  <%# Hero content — all centered %>
  <div class="relative z-20 flex-1 flex items-center justify-center text-center text-white px-4">
    <div>
      <%# Line 1: Header %>
      <h1 class="text-3xl md:text-5xl font-bold tracking-wide mb-4">
        <%= t("homepage.hero_title") %>
      </h1>

      <%# Line 2: Tagline %>
      <p class="text-base md:text-xl font-light tracking-wider mb-6">
        <%= t("homepage.hero_subtitle") %>
      </p>

      <%# Line 3: Separator %>
      <div class="w-20 h-0.5 bg-gold mx-auto mb-8"></div>

      <%# Line 4: Service cards %>
      <div data-testid="hero-cards">
        <div class="grid grid-cols-2 md:grid-cols-5 gap-3 md:gap-4 max-w-5xl mx-auto">
      <%# Buy — Lucide handshake %>
      <a href="<%= locale_sales_path %>" class="hero-card group flex flex-col items-center justify-center bg-white/95 backdrop-blur rounded-lg shadow-lg px-4 py-5 hover:-translate-y-1 hover:shadow-xl transition-all duration-200">
        <svg class="w-10 h-10 text-gold mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m11 17 2 2a1 1 0 1 0 3-3"/>
          <path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/>
          <path d="m21 3 1 11h-2"/>
          <path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/>
          <path d="M3 4h8"/>
        </svg>
        <span class="text-xs font-bold text-navy uppercase tracking-wide"><%= t("homepage.card_buy") %></span>
      </a>

      <%# Rent — Lucide key-round %>
      <a href="<%= locale_rentals_path %>" class="hero-card group flex flex-col items-center justify-center bg-white/95 backdrop-blur rounded-lg shadow-lg px-4 py-5 hover:-translate-y-1 hover:shadow-xl transition-all duration-200">
        <svg class="w-10 h-10 text-gold mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/>
          <circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/>
        </svg>
        <span class="text-xs font-bold text-navy uppercase tracking-wide"><%= t("homepage.card_rent") %></span>
      </a>

      <%# Off-market — Lucide lock %>
      <a href="<%= locale_offmarket_path %>" class="hero-card group flex flex-col items-center justify-center bg-white/95 backdrop-blur rounded-lg shadow-lg px-4 py-5 hover:-translate-y-1 hover:shadow-xl transition-all duration-200">
        <svg class="w-10 h-10 text-gold mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <span class="text-xs font-bold text-navy uppercase tracking-wide"><%= t("homepage.card_offmarket") %></span>
      </a>

      <%# Sell — Lucide gavel %>
      <a href="<%= locale_vendre_path %>" class="hero-card group flex flex-col items-center justify-center bg-white/95 backdrop-blur rounded-lg shadow-lg px-4 py-5 hover:-translate-y-1 hover:shadow-xl transition-all duration-200">
        <svg class="w-10 h-10 text-gold mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m14 13-8.381 8.38a1 1 0 0 1-3.001-3l8.384-8.381"/>
          <path d="m16 16 6-6"/><path d="m21.5 10.5-8-8"/>
          <path d="m8 8 6-6"/><path d="m8.5 7.5 8 8"/>
        </svg>
        <span class="text-xs font-bold text-navy uppercase tracking-wide"><%= t("homepage.card_sell") %></span>
      </a>

      <%# Management — Lucide folder-open %>
      <a href="<%= locale_gestion_path %>" class="hero-card group flex flex-col items-center justify-center bg-white/95 backdrop-blur rounded-lg shadow-lg px-4 py-5 hover:-translate-y-1 hover:shadow-xl transition-all duration-200 col-span-2 md:col-span-1 max-w-[50%] md:max-w-full mx-auto md:mx-0 w-full">
        <svg class="w-10 h-10 text-gold mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2"/>
        </svg>
        <span class="text-xs font-bold text-navy uppercase tracking-wide"><%= t("homepage.card_management") %></span>
      </a>
        </div>
      </div>
    </div>
  </div>
</section>

<%# === Featured Articles === %>
<section data-testid="featured-articles" class="max-w-7xl mx-auto px-4 py-16">
  <h2 class="heading-section !text-2xl md:!text-3xl text-center mb-8">
    <%= t("homepage.featured_articles_title") %>
  </h2>
  <% if @latest_articles.any? %>
    <% featured = @latest_articles.first %>
    <% rest = @latest_articles[1..] %>

    <%= render "shared/article_card_featured", article: featured, article_path: "#{locale_articles_path}/#{featured.slug}" %>

    <% if rest&.any? %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% rest.each do |article| %>
          <%= render "shared/article_card", article: article, article_path: "#{locale_articles_path}/#{article.slug}" %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</section>

<hr class="max-w-7xl mx-auto border-gray-200">

<%# === Videos Section === %>
<section data-testid="videos" class="max-w-7xl mx-auto px-4 py-16">
  <h2 class="heading-section !text-2xl md:!text-3xl text-center mb-8">
    <%= t("homepage.videos_title") %>
  </h2>
  <% if @youtube_videos&.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
      <% @youtube_videos.each do |video| %>
        <div>
          <div class="aspect-video rounded overflow-hidden">
            <iframe src="<%= video.embed_url %>"
                    class="w-full h-full"
                    frameborder="0"
                    loading="lazy"
                    allowfullscreen
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture">
            </iframe>
          </div>
          <p class="text-xs text-dark mt-2"><%= video.title %></p>
        </div>
      <% end %>
    </div>
    <div class="text-center">
      <%= link_to t("homepage.videos_view_channel"), YoutubeVideo::CHANNEL_URL,
            target: "_blank", rel: "noopener noreferrer",
            class: "text-sm text-navy font-semibold hover:underline" %>
    </div>
  <% end %>
</section>

<%# === Team Photo === %>
<section data-testid="team-photo" class="w-full">
  <%= image_tag "team-2026.jpg", alt: t("homepage.about_title"), class: "w-full h-[70vh] object-cover" %>
</section>

<hr class="max-w-7xl mx-auto border-gray-200">

<%# === About Section === %>
<section data-testid="about" class="max-w-3xl mx-auto px-4 py-16">
  <h2 class="heading-section !text-2xl md:!text-3xl text-center mb-8">
    <%= t("homepage.about_title") %>
  </h2>
  <div class="text-body text-justify space-y-6">
    <div data-citation="history" class="space-y-4">
      <%= simple_format(t("homepage.about_history"), {}, wrapper_tag: "p") %>
    </div>
    <div data-citation="services" class="space-y-4">
      <%= simple_format(t("homepage.about_services"), {}, wrapper_tag: "p") %>
    </div>
    <div data-citation="expertise" class="space-y-4">
      <%= simple_format(t("homepage.about_expertise"), {}, wrapper_tag: "p") %>
    </div>
  </div>
</section>

<hr class="max-w-7xl mx-auto border-gray-200">

<%# === FAQ Section === %>
<section data-testid="faq" class="max-w-3xl mx-auto px-4 py-16">
  <h2 class="heading-section text-center mb-8">
    <%= t("homepage.faq_title") %>
  </h2>
  <div class="space-y-6">
    <% t("homepage.faqs").each do |faq| %>
      <div data-testid="faq-item">
        <h3 class="text-base font-semibold text-navy mb-2"><%= faq[:question] %></h3>
        <p class="text-body"><%= faq[:answer] %></p>
      </div>
    <% end %>
  </div>
</section>

<hr class="max-w-7xl mx-auto border-gray-200">

<%# === Image Carousel === %>
<section data-testid="carousel" class="w-full" data-controller="carousel">
  <div class="relative overflow-hidden">
    <div data-carousel-target="track" class="flex transition-transform duration-500">
      <div data-testid="carousel-slide" class="min-w-full">
        <img src="/images/carousel/agence-gare-monaco-2025-9.jpg" alt="Agence Immobilière de la Gare Monaco" class="w-full h-[70vh] object-cover" loading="eager">
      </div>
      <div data-testid="carousel-slide" class="min-w-full">
        <img src="/images/carousel/agence-gare-monaco-2025-12.jpg" alt="Agence Immobilière de la Gare Monaco" class="w-full h-[70vh] object-cover" loading="lazy">
      </div>
      <div data-testid="carousel-slide" class="min-w-full">
        <img src="/images/carousel/agence-gare-monaco-2025-34.jpg" alt="Agence Immobilière de la Gare Monaco" class="w-full h-[70vh] object-cover" loading="lazy">
      </div>
      <div data-testid="carousel-slide" class="min-w-full">
        <img src="/images/carousel/agence-gare-monaco-2025-41.jpg" alt="Agence Immobilière de la Gare Monaco" class="w-full h-[70vh] object-cover" loading="lazy">
      </div>
      <div data-testid="carousel-slide" class="min-w-full">
        <img src="/images/carousel/team3.jpg" alt="Équipe Agence Immobilière de la Gare" class="w-full h-[70vh] object-cover" loading="lazy">
      </div>
    </div>
    <%# Navigation buttons %>
    <button data-action="carousel#prev" class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full p-3 shadow-lg" aria-label="Previous">
      <svg class="w-5 h-5 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </button>
    <button data-action="carousel#next" class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full p-3 shadow-lg" aria-label="Next">
      <svg class="w-5 h-5 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </button>
  </div>
</section>

<%# === Team + Contact Section === %>
