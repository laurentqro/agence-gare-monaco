<% content_for :homepage, "true" %>

<%# === Hero Section === %>
<section data-testid="hero" class="relative h-screen flex items-center justify-center bg-[#090956] overflow-hidden">
  <%# Background video %>
  <video playsinline autoplay muted loop class="absolute inset-0 w-full h-full object-cover">
    <source src="/videos/hero-bg.mp4" type="video/mp4">
  </video>

  <%# Background overlay %>
  <div class="absolute inset-0 bg-black/40 z-10"></div>

  <%# Hero content %>
  <div class="relative z-20 text-center text-white px-4">
    <h1 class="text-3xl md:text-5xl font-bold tracking-wide uppercase mb-4">
      <%= t("homepage.hero_title") %>
    </h1>
    <p class="text-sm md:text-lg font-light tracking-wider">
      <%= t("homepage.hero_subtitle") %>
    </p>
  </div>
</section>

<%# === Category Cards === %>
<section data-testid="category-cards" class="max-w-7xl mx-auto px-4 py-16">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <%# Sales Monaco %>
    <a href="<%= locale_sales_monaco_path %>" class="group block relative rounded-lg shadow-lg hover:shadow-xl transition-shadow overflow-hidden aspect-[4/3]">
      <img src="/images/categories/sales-monaco.jpg" alt="<%= t("homepage.category_sales_monaco") %>" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
      <div class="absolute inset-x-0 bottom-0 bg-gradient-to-r from-[#090956]/80 to-transparent py-4 px-5">
        <h3 class="text-lg font-bold uppercase tracking-wide text-white mb-1">
          <%= t("homepage.category_sales_monaco") %>
        </h3>
        <p class="text-xs text-white/80"><%= t("homepage.category_sales_monaco_desc") %></p>
      </div>
    </a>

    <%# Rentals Monaco %>
    <a href="<%= locale_rentals_monaco_path %>" class="group block relative rounded-lg shadow-lg hover:shadow-xl transition-shadow overflow-hidden aspect-[4/3]">
      <img src="/images/categories/rentals-monaco.jpg" alt="<%= t("homepage.category_rentals_monaco") %>" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
      <div class="absolute inset-x-0 bottom-0 bg-gradient-to-r from-[#090956]/80 to-transparent py-4 px-5">
        <h3 class="text-lg font-bold uppercase tracking-wide text-white mb-1">
          <%= t("homepage.category_rentals_monaco") %>
        </h3>
        <p class="text-xs text-white/80"><%= t("homepage.category_rentals_monaco_desc") %></p>
      </div>
    </a>

    <%# France %>
    <a href="<%= locale_sales_france_path %>" class="group block relative rounded-lg shadow-lg hover:shadow-xl transition-shadow overflow-hidden aspect-[4/3]">
      <img src="/images/categories/france.jpg" alt="<%= t("homepage.category_france") %>" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
      <div class="absolute inset-x-0 bottom-0 bg-gradient-to-r from-[#090956]/80 to-transparent py-4 px-5">
        <h3 class="text-lg font-bold uppercase tracking-wide text-white mb-1">
          <%= t("homepage.category_france") %>
        </h3>
        <p class="text-xs text-white/80"><%= t("homepage.category_france_desc") %></p>
      </div>
    </a>
  </div>
</section>

<hr class="max-w-7xl mx-auto border-gray-200">

<%# === Featured Articles === %>
<section data-testid="featured-articles" class="max-w-7xl mx-auto px-4 py-16">
  <h2 class="text-2xl font-bold text-[#090956] text-center mb-8">
    <%= t("homepage.featured_articles_title") %>
  </h2>
  <% if @latest_articles.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% @latest_articles.each do |article| %>
        <a href="<%= locale_articles_path %>/<%= article.slug %>" class="article-card group block bg-white rounded shadow hover:shadow-md transition">
          <% if article.cover_image_display_url.present? %>
            <div class="aspect-[16/10] overflow-hidden rounded-t">
              <img src="<%= article.cover_image_display_url %>" alt="<%= article.title_for(I18n.locale) %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy">
            </div>
          <% end %>
          <div class="p-5">
            <h3 class="article-title text-sm font-bold text-[#090956] uppercase tracking-wide group-hover:text-[#6E8297]">
              <%= article.title_for(I18n.locale) %>
            </h3>
            <p class="article-meta mt-2 text-xs text-[#6E8297]">
              <% if article.published_at %>
                <time datetime="<%= article.published_at.iso8601 %>"><%= article.published_at.strftime("%Y-%m-%d") %></time>
                /
              <% end %>
              <%= article.category.name %>
            </p>
          </div>
        </a>
      <% end %>
    </div>
  <% end %>
</section>

<hr class="max-w-7xl mx-auto border-gray-200">

<%# === Videos Section === %>
<section data-testid="videos" class="max-w-7xl mx-auto px-4 py-16">
  <h2 class="text-2xl font-bold text-[#090956] text-center mb-8">
    <%= t("homepage.videos_title") %>
  </h2>
  <% if @youtube_videos&.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
      <% @youtube_videos.each do |video| %>
        <div>
          <div class="aspect-video rounded overflow-hidden">
            <iframe src="<%= video.embed_url %>"
                    class="w-full h-full"
                    frameborder="0"
                    loading="lazy"
                    allowfullscreen
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture">
            </iframe>
          </div>
          <p class="text-xs text-[#212529] mt-2"><%= video.title %></p>
        </div>
      <% end %>
    </div>
    <div class="text-center">
      <%= link_to t("homepage.videos_view_channel"), YoutubeVideo::CHANNEL_URL,
            target: "_blank", rel: "noopener noreferrer",
            class: "text-sm text-[#090956] font-semibold hover:underline" %>
    </div>
  <% end %>
</section>

<%# === Team Photo === %>
<section data-testid="team-photo" class="w-full">
  <%= image_tag "team-2026.jpg", alt: t("homepage.about_title"), class: "w-full h-[70vh] object-cover" %>
</section>

<hr class="max-w-7xl mx-auto border-gray-200">

<%# === About Section === %>
<section data-testid="about" class="max-w-7xl mx-auto px-4 py-16">
  <h2 class="text-2xl font-bold text-[#090956] text-center mb-8">
    <%= t("homepage.about_title") %>
  </h2>
  <div class="text-sm leading-relaxed text-[#212529] text-justify space-y-4">
    <%= simple_format(t("homepage.about_text"), {}, wrapper_tag: "p") %>
  </div>
</section>

<hr class="max-w-7xl mx-auto border-gray-200">

<%# === Image Carousel === %>
<section data-testid="carousel" class="w-full" data-controller="carousel">
  <div class="relative overflow-hidden">
    <div data-carousel-target="track" class="flex transition-transform duration-500">
      <div data-testid="carousel-slide" class="min-w-full">
        <img src="/images/carousel/agence-gare-monaco-2025-9.jpg" alt="Agence de la Gare Monaco" class="w-full h-[70vh] object-cover" loading="eager">
      </div>
      <div data-testid="carousel-slide" class="min-w-full">
        <img src="/images/carousel/agence-gare-monaco-2025-12.jpg" alt="Agence de la Gare Monaco" class="w-full h-[70vh] object-cover" loading="lazy">
      </div>
      <div data-testid="carousel-slide" class="min-w-full">
        <img src="/images/carousel/agence-gare-monaco-2025-34.jpg" alt="Agence de la Gare Monaco" class="w-full h-[70vh] object-cover" loading="lazy">
      </div>
      <div data-testid="carousel-slide" class="min-w-full">
        <img src="/images/carousel/agence-gare-monaco-2025-41.jpg" alt="Agence de la Gare Monaco" class="w-full h-[70vh] object-cover" loading="lazy">
      </div>
      <div data-testid="carousel-slide" class="min-w-full">
        <img src="/images/carousel/team3.jpg" alt="Équipe Agence de la Gare" class="w-full h-[70vh] object-cover" loading="lazy">
      </div>
    </div>
    <%# Navigation buttons %>
    <button data-action="carousel#prev" class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full p-3 shadow-lg" aria-label="Previous">
      <svg class="w-5 h-5 text-[#090956]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </button>
    <button data-action="carousel#next" class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full p-3 shadow-lg" aria-label="Next">
      <svg class="w-5 h-5 text-[#090956]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </button>
  </div>
</section>
