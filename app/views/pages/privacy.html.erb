<div class="max-w-4xl mx-auto px-4 py-16">
  <h1 class="heading-page mb-8"><%= t("privacy.title") %></h1>

  <div data-testid="privacy-content" class="text-body space-y-8">
    <p><%= t("privacy.intro_html") %></p>
    <p class="text-xs text-gray-500"><%= t("privacy.update_notice") %></p>

    <%# === Data Controller === %>
    <div>
      <h2 class="heading-section mb-3"><%= t("privacy.controller_title") %></h2>
      <p class="mb-2"><%= t("privacy.controller_text") %></p>
      <address class="not-italic ml-4 space-y-1">
        <p class="font-semibold"><%= t("privacy.controller_name") %></p>
        <p><%= t("privacy.controller_address") %></p>
        <p><%= t("privacy.controller_phone") %></p>
        <p><%= mail_to t("privacy.controller_email"), t("privacy.controller_email") %></p>
      </address>
    </div>

    <%# === Processing Activity: Contact Form === %>
    <div>
      <h2 class="heading-section mb-3"><%= t("privacy.contact_form_title") %></h2>
      <p class="mb-2"><%= t("privacy.contact_form_purpose") %></p>
      <p class="mb-2"><%= t("privacy.contact_form_basis") %></p>
      <p class="mb-2"><%= t("privacy.contact_form_data") %></p>
      <p class="mb-2"><%= t("privacy.contact_form_retention") %></p>
      <p><%= t("privacy.contact_form_recipients") %></p>
    </div>

    <%# === Processing Activity: Property Inquiry === %>
    <div>
      <h2 class="heading-section mb-3"><%= t("privacy.property_inquiry_title") %></h2>
      <p class="mb-2"><%= t("privacy.property_inquiry_purpose") %></p>
      <p class="mb-2"><%= t("privacy.property_inquiry_basis") %></p>
      <p class="mb-2"><%= t("privacy.property_inquiry_data") %></p>
      <p class="mb-2"><%= t("privacy.property_inquiry_retention") %></p>
      <p><%= t("privacy.property_inquiry_recipients") %></p>
    </div>

    <%# === Processing Activity: Analytics === %>
    <div>
      <h2 class="heading-section mb-3"><%= t("privacy.analytics_title") %></h2>
      <p class="mb-2"><%= t("privacy.analytics_purpose") %></p>
      <p class="mb-2"><%= t("privacy.analytics_basis") %></p>
      <p class="mb-2"><%= t("privacy.analytics_tool") %></p>
      <p><%= t("privacy.analytics_no_transfer") %></p>
    </div>

    <%# === Cookies === %>
    <div>
      <h2 class="heading-section mb-3"><%= t("privacy.cookies_title") %></h2>
      <p class="mb-2"><%= t("privacy.cookies_text") %></p>
      <p><%= t("privacy.cookies_plausible") %></p>
    </div>

    <%# === Your Rights === %>
    <div>
      <h2 class="heading-section mb-3"><%= t("privacy.rights_title") %></h2>
      <p class="mb-3"><%= t("privacy.rights_intro") %></p>
      <ul class="list-disc list-inside space-y-2 ml-4 mb-4">
        <li><%= t("privacy.right_information") %></li>
        <li><%= t("privacy.right_access") %></li>
        <li><%= t("privacy.right_rectification") %></li>
        <li><%= t("privacy.right_erasure") %></li>
        <li><%= t("privacy.right_limitation") %></li>
        <li><%= t("privacy.right_opposition") %></li>
        <li><%= t("privacy.right_portability") %></li>
        <li><%= t("privacy.right_automated") %></li>
      </ul>
      <p><%= t("privacy.rights_exercise") %></p>
    </div>

    <%# === Data Protection Officer === %>
    <div>
      <h2 class="heading-section mb-3"><%= t("privacy.dpd_title") %></h2>
      <p class="mb-2"><%= t("privacy.dpd_text") %></p>
      <p class="font-semibold mb-2"><%= t("privacy.dpd_name") %></p>
      <p><%= t("privacy.dpd_contact") %></p>
    </div>

    <%# === Data Security === %>
    <div>
      <h2 class="heading-section mb-3"><%= t("privacy.security_title") %></h2>
      <p><%= t("privacy.security_text") %></p>
    </div>

    <%# === Right to Complain === %>
    <div>
      <h2 class="heading-section mb-3"><%= t("privacy.complaint_title") %></h2>
      <p class="mb-2"><%= t("privacy.complaint_text") %></p>
      <address class="not-italic ml-4 space-y-1">
        <p><%= t("privacy.complaint_apdp_address") %></p>
        <p><%= mail_to t("privacy.complaint_apdp_email"), t("privacy.complaint_apdp_email") %></p>
        <p><%= link_to t("privacy.complaint_apdp_website"), t("privacy.complaint_apdp_website"), target: "_blank", rel: "noopener noreferrer" %></p>
      </address>
    </div>

    <p class="text-xs text-gray-500 pt-4 border-t border-gray-200"><%= t("privacy.last_updated") %></p>
  </div>
</div>
