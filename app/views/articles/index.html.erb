<div class="max-w-5xl mx-auto px-4 py-12">
  <h1 class="text-2xl font-bold text-[#090956] mb-2">
    <% if @category %>
      <%= @category.name %>
    <% else %>
      <%= t("nav.articles") %>
    <% end %>
  </h1>

  <%# Category filter links %>
  <div class="flex flex-wrap gap-2 mb-8">
    <% categories = Category.joins(:articles).where(articles: { published: true }).distinct.order(:name) %>
    <% if categories.any? %>
      <% locale = params[:locale] || I18n.locale.to_s %>
      <% articles_segment = I18n.t("routes.articles", locale: locale) %>
      <a href="/<%= locale %>/<%= articles_segment %>"
         class="px-3 py-1 text-sm rounded border <%= @category.nil? ? 'bg-[#090956] text-white border-[#090956]' : 'border-gray-300 text-gray-600 hover:border-[#090956]' %>">
        All
      </a>
      <% categories.each do |cat| %>
        <a href="/<%= locale %>/<%= articles_segment %>/<%= cat.slug %>"
           class="px-3 py-1 text-sm rounded border <%= @category&.id == cat.id ? 'bg-[#090956] text-white border-[#090956]' : 'border-gray-300 text-gray-600 hover:border-[#090956]' %>">
          <%= cat.name %>
        </a>
      <% end %>
    <% end %>
  </div>

  <% if @articles.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @articles.each do |article| %>
        <% locale = params[:locale] || I18n.locale.to_s %>
        <% articles_segment = I18n.t("routes.articles", locale: locale) %>
        <a href="/<%= locale %>/<%= articles_segment %>/<%= article.slug %>" class="group block bg-white rounded shadow hover:shadow-md transition">
          <div class="p-5">
            <span class="text-xs font-medium text-[#6E8297] uppercase"><%= article.category.name %></span>
            <h2 class="mt-1 text-base font-semibold text-[#090956] group-hover:text-[#6E8297] line-clamp-2">
              <%= article.title_for(I18n.locale) %>
            </h2>
            <p class="mt-2 text-sm text-gray-600 line-clamp-3">
              <%= truncate(strip_tags(article.body_for(I18n.locale)), length: 150) %>
            </p>
            <% if article.published_at %>
              <time datetime="<%= article.published_at.iso8601 %>" class="mt-3 block text-xs text-gray-400">
                <%= l(article.published_at.to_date, format: :long) rescue article.published_at.strftime("%d/%m/%Y") %>
              </time>
            <% end %>
          </div>
        </a>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500">No articles found.</p>
  <% end %>
</div>
