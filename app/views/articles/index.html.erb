<div class="max-w-7xl mx-auto px-4 py-12">
  <h1 class="text-4xl font-bold text-[#090956] mb-2">
    <% if @category %>
      <%= @category.name %>
    <% else %>
      <%= t("nav.articles") %>
    <% end %>
  </h1>

  <%# Category filter links %>
  <div class="flex flex-wrap gap-2 mb-8">
    <% categories = Category.joins(:articles).where(articles: { published: true }).distinct.order(:name) %>
    <% if categories.any? %>
      <% locale = params[:locale] || I18n.locale.to_s %>
      <% articles_segment = I18n.t("routes.articles", locale: locale) %>
      <a href="/<%= locale %>/<%= articles_segment %>"
         class="px-3 py-1 text-sm rounded border <%= @category.nil? ? 'bg-[#090956] text-white border-[#090956]' : 'border-gray-300 text-gray-600 hover:border-[#090956]' %>">
        <%= t("articles.all") %>
      </a>
      <% categories.each do |cat| %>
        <a href="/<%= locale %>/<%= articles_segment %>/<%= cat.slug %>"
           class="px-3 py-1 text-sm rounded border <%= @category&.id == cat.id ? 'bg-[#090956] text-white border-[#090956]' : 'border-gray-300 text-gray-600 hover:border-[#090956]' %>">
          <%= cat.name %>
        </a>
      <% end %>
    <% end %>
  </div>

  <% if @articles.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @articles.each do |article| %>
        <% locale = params[:locale] || I18n.locale.to_s %>
        <% articles_segment = I18n.t("routes.articles", locale: locale) %>
        <a href="/<%= locale %>/<%= articles_segment %>/<%= article.slug %>" class="article-card group block bg-white rounded shadow hover:shadow-md transition">
          <% if article.cover_image_display_url.present? %>
            <div class="aspect-[16/10] overflow-hidden rounded-t">
              <img src="<%= article.cover_image_display_url %>" alt="<%= article.title_for(I18n.locale) %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy">
            </div>
          <% end %>
          <div class="p-5">
            <h2 class="article-title text-sm font-bold text-[#090956] uppercase tracking-wide group-hover:text-[#6E8297]">
              <%= article.title_for(I18n.locale) %>
            </h2>
            <p class="article-meta mt-2 text-xs text-[#6E8297]">
              <% if article.published_at %>
                <time datetime="<%= article.published_at.iso8601 %>"><%= article.published_at.strftime("%Y-%m-%d") %></time>
                /
              <% end %>
              <%= article.category.name %>
            </p>
          </div>
        </a>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500">No articles found.</p>
  <% end %>
</div>
