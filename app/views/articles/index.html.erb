<div class="max-w-7xl mx-auto px-4 py-12">
  <h1 class="heading-page mb-2">
    <% if @category %>
      <%= @category.name_for %>
    <% else %>
      <%= t("nav.articles") %>
    <% end %>
  </h1>

  <%# Category filter links %>
  <div class="flex flex-wrap gap-2 mb-8">
    <% categories = Category.joins(:articles).where(articles: { published: true }).distinct.order(:slug) %>
    <% if categories.any? %>
      <% locale = params[:locale] || I18n.locale.to_s %>
      <% articles_segment = I18n.t("routes.articles", locale: locale) %>
      <a href="/<%= locale %>/<%= articles_segment %>"
         class="px-3 py-1 text-sm rounded border <%= @category.nil? ? 'bg-navy text-white border-navy' : 'border-gray-300 text-gray-600 hover:border-navy' %>">
        <%= t("articles.all") %>
      </a>
      <% categories.each do |cat| %>
        <a href="/<%= locale %>/<%= articles_segment %>/<%= cat.slug_for %>"
           class="px-3 py-1 text-sm rounded border <%= @category&.id == cat.id ? 'bg-navy text-white border-navy' : 'border-gray-300 text-gray-600 hover:border-navy' %>">
          <%= cat.name_for %>
        </a>
      <% end %>
    <% end %>
  </div>

  <% if @articles.any? %>
    <% locale = params[:locale] || I18n.locale.to_s %>
    <% articles_segment = I18n.t("routes.articles", locale: locale) %>
    <% featured = @articles.first %>
    <% rest = @articles.offset(1) %>

    <%= render "shared/article_card_featured", article: featured, article_path: "/#{locale}/#{articles_segment}/#{featured.slug}" %>

    <% if rest.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% rest.each do |article| %>
          <%= render "shared/article_card", article: article, article_path: "/#{locale}/#{articles_segment}/#{article.slug}" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p class="text-gray-500">No articles found.</p>
  <% end %>
</div>
