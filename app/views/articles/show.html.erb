<div class="max-w-3xl mx-auto px-4 py-12">
  <%# Breadcrumb %>
  <div class="mb-6 text-sm text-gray-500">
    <% locale = params[:locale] || I18n.locale.to_s %>
    <% articles_segment = I18n.t("routes.articles", locale: locale) %>
    <a href="/<%= locale %>/<%= articles_segment %>" class="text-[#6E8297] hover:underline"><%= t("nav.articles") %></a>
    <span class="mx-1">/</span>
    <a href="/<%= locale %>/<%= articles_segment %>/<%= @article.category.slug %>" class="text-[#6E8297] hover:underline"><%= @article.category.name %></a>
  </div>

  <%# Article header %>
  <h1 class="text-2xl font-bold text-[#090956] mb-3"><%= @article.title_for(I18n.locale) %></h1>

  <div class="flex items-center gap-3 text-sm text-gray-500 mb-8">
    <span class="text-[#6E8297] font-medium"><%= @article.category.name %></span>
    <% if @article.published_at %>
      <span>&middot;</span>
      <time datetime="<%= @article.published_at.iso8601 %>">
        <%= l(@article.published_at.to_date, format: :long) rescue @article.published_at.strftime("%d/%m/%Y") %>
      </time>
    <% end %>
  </div>

  <%# Article body %>
  <div class="article-body prose prose-sm max-w-none text-[#212529]">
    <%= render_markdown(@article.body_for(I18n.locale)) %>
  </div>
</div>
