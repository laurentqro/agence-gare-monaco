<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("admin.layout.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Agence Gare Monaco">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Domine:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="font-['Domine',Georgia,'Times_New_Roman',serif] text-dark bg-gray-50">
    <div class="flex h-screen overflow-hidden">
      <%# Sidebar navigation %>
      <% if authenticated? %>
        <aside class="w-64 bg-navy text-white flex flex-col flex-shrink-0">
          <div class="p-4 border-b border-white/10">
            <a href="<%= fr_root_path %>" class="inline-flex items-center">
              <span class="bg-white rounded-lg p-1.5 inline-flex">
                <%= image_tag "logo-monogram.png", alt: "Agence Immobilière de la Gare", class: "h-9 w-9" %>
              </span>
            </a>
          </div>
          <% nav_icon_class = "w-5 h-5 flex-shrink-0" %>
          <nav class="flex-1 overflow-y-auto p-4 space-y-1">
            <a href="<%= admin_root_path %>" class="<%= admin_nav_link_class(admin_root_path, exact: true) %>">
              <%# squares-2x2 %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="<%= nav_icon_class %>">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
              </svg>
              <span><%= t("admin.layout.dashboard") %></span>
            </a>
            <a href="<%= admin_properties_path %>" class="<%= admin_nav_link_class(admin_properties_path) %>">
              <%# building-office %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="<%= nav_icon_class %>">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" />
              </svg>
              <span><%= t("admin.layout.properties") %></span>
            </a>
            <a href="<%= admin_articles_path %>" class="<%= admin_nav_link_class(admin_articles_path) %>">
              <%# document-text %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="<%= nav_icon_class %>">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9zm.75 12.75h3m-3 3h3m-6-6h.008v.008H8.25V15zm0 3h.008v.008H8.25V18z" />
              </svg>
              <span><%= t("admin.layout.articles") %></span>
            </a>
            <a href="<%= admin_categories_path %>" class="<%= admin_nav_link_class(admin_categories_path) %>">
              <%# tag %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="<%= nav_icon_class %>">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z" />
              </svg>
              <span><%= t("admin.layout.categories") %></span>
            </a>
            <a href="<%= admin_contacts_path %>" class="<%= admin_nav_link_class(admin_contacts_path) %>">
              <%# users %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="<%= nav_icon_class %>">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
              </svg>
              <span><%= t("admin.layout.contacts") %></span>
            </a>
            <a href="<%= new_admin_outgoing_email_path %>" class="<%= admin_nav_link_class(new_admin_outgoing_email_path) %>">
              <%# paper-airplane %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="<%= nav_icon_class %>">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
              </svg>
              <span><%= t("admin.layout.compose_email") %></span>
            </a>
            <a href="<%= admin_information_requests_path %>" class="<%= admin_nav_link_class(admin_information_requests_path) %>">
              <%# envelope %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="<%= nav_icon_class %>">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
              <span class="flex-1"><%= t("admin.layout.information_requests") %></span>
              <% unread = InformationRequest.unread.count %>
              <% if unread.positive? %>
                <span class="ml-auto inline-flex items-center justify-center min-w-5 h-5 px-1.5 rounded-full bg-accent text-white text-[10px] font-semibold"><%= unread %></span>
              <% end %>
            </a>
          </nav>
          <div class="p-4 border-t border-white/10 text-sm">
            <p class="text-white/70 mb-2"><%= Current.user&.email_address %></p>
            <%= link_to t("admin.layout.logout"), session_path, data: { turbo_method: :delete }, class: "text-white/70 hover:text-white" %>
          </div>
        </aside>
      <% end %>

      <%# Main content %>
      <main class="flex-1 overflow-auto">
        <% if flash[:notice] %>
          <div class="bg-green-50 border-l-4 border-green-400 p-4 m-6 mb-0">
            <p class="text-green-700"><%= flash[:notice] %></p>
          </div>
        <% end %>
        <% if flash[:alert] %>
          <div class="bg-red-50 border-l-4 border-red-400 p-4 m-6 mb-0">
            <p class="text-red-700"><%= flash[:alert] %></p>
          </div>
        <% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
