<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("admin.layout.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Agence Gare Monaco">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="font-['Montserrat',Helvetica,Arial,Verdana,sans-serif] text-dark bg-gray-50">
    <div class="flex min-h-screen">
      <%# Sidebar navigation %>
      <% if authenticated? %>
        <aside class="w-64 bg-navy text-white flex flex-col flex-shrink-0">
          <div class="p-4 border-b border-white/10">
            <a href="<%= admin_root_path %>" class="text-lg font-bold">Agence de la Gare</a>
          </div>
          <nav class="flex-1 p-4 space-y-1">
            <a href="<%= admin_root_path %>" class="block px-3 py-2 rounded hover:bg-white/10"><%= t("admin.layout.dashboard") %></a>
            <a href="<%= admin_properties_path %>" class="block px-3 py-2 rounded hover:bg-white/10"><%= t("admin.layout.properties") %></a>
            <a href="<%= admin_articles_path %>" class="block px-3 py-2 rounded hover:bg-white/10"><%= t("admin.layout.articles") %></a>
            <a href="<%= admin_categories_path %>" class="block px-3 py-2 rounded hover:bg-white/10"><%= t("admin.layout.categories") %></a>
            <a href="<%= admin_contacts_path %>" class="block px-3 py-2 rounded hover:bg-white/10"><%= t("admin.layout.contacts") %></a>
          </nav>
          <div class="p-4 border-t border-white/10 text-sm">
            <p class="text-white/70 mb-2"><%= Current.user&.email_address %></p>
            <%= link_to t("admin.layout.logout"), session_path, data: { turbo_method: :delete }, class: "text-white/70 hover:text-white" %>
          </div>
        </aside>
      <% end %>

      <%# Main content %>
      <main class="flex-1 overflow-auto">
        <% if flash[:notice] %>
          <div class="bg-green-50 border-l-4 border-green-400 p-4 m-6 mb-0">
            <p class="text-green-700"><%= flash[:notice] %></p>
          </div>
        <% end %>
        <% if flash[:alert] %>
          <div class="bg-red-50 border-l-4 border-red-400 p-4 m-6 mb-0">
            <p class="text-red-700"><%= flash[:alert] %></p>
          </div>
        <% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
