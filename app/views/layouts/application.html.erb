<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for?(:title) ? content_for(:title) : (defined?(seo_config) && seo_config[:page_type] ? seo_title(**seo_config) : "Agence Immobilière de la Gare | Monaco") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Agence Gare Monaco">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= noindex_meta_tag %>
    <%= render "shared/seo_tags" if defined?(seo_config) && seo_config[:page_type].present? %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Domine:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <% unless staging? %>
    <script defer data-domain="agencegaremonaco.com" src="https://plausible.io/js/script.js"></script>
    <% end %>
  </head>

  <body class="font-['Domine',Georgia,'Times_New_Roman',serif] text-dark text-base min-h-screen flex flex-col">
    <%= render "shared/navbar", homepage: content_for?(:homepage) %>

    <main class="relative flex-grow flex flex-col">
      <% if content_for?(:page_background) %>
        <div data-testid="page-background" class="fixed inset-0 z-0">
          <%= image_tag "monaco-panorama.jpg", alt: "", class: "w-full h-full object-cover", "aria-hidden": "true" %>
          <div class="absolute inset-0 bg-white/80"></div>
        </div>
      <% end %>
      <div class="relative z-10 flex-grow flex flex-col">
      <% if flash[:notice].present? %>
        <div data-testid="flash-notice" class="max-w-7xl mx-auto px-4 mt-4">
          <div class="bg-green-50 border border-green-200 rounded p-4 text-xs text-green-800">
            <%= flash[:notice] %>
          </div>
        </div>
      <% end %>
      <% if flash[:alert].present? %>
        <div data-testid="flash-alert" class="max-w-7xl mx-auto px-4 mt-4">
          <div class="bg-red-50 border border-red-200 rounded p-4 text-xs text-red-800">
            <%= flash[:alert] %>
          </div>
        </div>
      <% end %>
      <%= yield %>
      </div>
    </main>

    <%= render "shared/footer" %>

  </body>
</html>
