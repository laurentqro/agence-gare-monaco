<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for?(:title) ? content_for(:title) : (defined?(seo_config) && seo_config[:page_type] ? seo_title(**seo_config) : "Agence Immobilière de la Gare | Monaco") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Agence Gare Monaco">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= noindex_meta_tag %>
    <%= render "shared/seo_tags" if defined?(seo_config) && seo_config[:page_type].present? %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <% unless staging? %>
    <script defer data-domain="agencegaremonaco.com" src="https://plausible.io/js/script.js"></script>
    <% end %>
  </head>

  <body class="font-['Montserrat',Helvetica,Arial,Verdana,sans-serif] text-dark text-base">
    <%= render "shared/navbar", homepage: content_for?(:homepage) %>

    <main>
      <% if flash[:notice].present? %>
        <div data-testid="flash-notice" class="max-w-7xl mx-auto px-4 mt-4">
          <div class="bg-green-50 border border-green-200 rounded p-4 text-xs text-green-800">
            <%= flash[:notice] %>
          </div>
        </div>
      <% end %>
      <% if flash[:alert].present? %>
        <div data-testid="flash-alert" class="max-w-7xl mx-auto px-4 mt-4">
          <div class="bg-red-50 border border-red-200 rounded p-4 text-xs text-red-800">
            <%= flash[:alert] %>
          </div>
        </div>
      <% end %>
      <%= yield %>
    </main>

    <%= render "shared/footer" %>

    <!-- Sticky WhatsApp button -->
    <a href="https://wa.me/33662392065" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp"
       class="fixed bottom-6 right-6 z-50 w-14 h-14 bg-[#25D366] rounded-full flex items-center justify-center shadow-lg hover:bg-[#1ebe57] transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-7 h-7">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>
  </body>
</html>
