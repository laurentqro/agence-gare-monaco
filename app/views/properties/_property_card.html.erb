<div data-testid="property-card" class="group bg-white rounded-xl overflow-hidden border border-gray-100 hover:border-gray-200 shadow-sm hover:shadow-lg transition-all duration-300">
  <a href="<%= locale_property_path(property) %>" class="block" data-turbo-frame="_top">
    <%# Property image %>
    <div class="relative aspect-[4/3] bg-gray-100 overflow-hidden">
      <% if property.cover_image %>
        <img src="<%= property.cover_image.medium_url || property.cover_image.remote_url %>"
             alt="<%= property.title_for(I18n.locale) %>"
             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
             loading="lazy"
             srcset="<%= property.cover_image.small_url %> 400w, <%= property.cover_image.medium_url %> 800w, <%= property.cover_image.large_url %> 1200w"
             sizes="(max-width: 768px) 100vw, 50vw">
      <% else %>
        <div class="w-full h-full flex items-center justify-center text-gray-300">
          <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" />
          </svg>
        </div>
      <% end %>

      <%# Badges %>
      <div class="absolute top-3 left-3 flex items-center gap-2">
        <% if property.recent? %>
          <span data-testid="new-badge" class="bg-navy text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md shadow-sm">
            <%= t("listings.new_badge") %>
          </span>
        <% end %>
        <% if property.exclusivity? %>
          <span class="bg-gold text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md shadow-sm">
            Exclusivit&eacute;
          </span>
        <% end %>
      </div>
    </div>

    <%# Content area %>
    <div class="px-5 pt-4 pb-3">
      <%# Title %>
      <h3 class="text-navy font-bold text-sm uppercase tracking-wide leading-snug line-clamp-2 mb-2">
        <%= property.title_for(I18n.locale) %>
      </h3>

      <%# Price %>
      <div class="mb-3">
        <% if property.price.present? %>
          <span class="text-navy text-lg font-bold tracking-tight">
            <%= property.formatted_price %>&euro;
          </span>
          <% if property.transaction_type == "rental" %>
            <span class="text-accent text-xs font-medium ml-0.5"><%= t("property_detail.per_month") %></span>
          <% end %>
          <% if (converted = converted_price_tag(property.price)) %>
            <span data-testid="converted-price" class="text-xs text-accent ml-1.5"><%= converted %></span>
          <% end %>
        <% else %>
          <span class="text-navy text-sm font-semibold italic">
            <%= t("listings.price_on_request") %>
          </span>
        <% end %>
      </div>
    </div>

    <%# Property stats footer %>
    <div class="flex items-center gap-3 text-xs text-accent border-t border-gray-100 px-5 py-3">
      <% if property.num_rooms.present? && property.num_rooms > 0 %>
        <span class="inline-flex items-center gap-1" title="<%= t("listings.rooms") %>">
          <svg class="w-3.5 h-3.5 text-navy/40" fill="currentColor" viewBox="0 0 24 24"><path d="M19 9.3V4h-3v2.6L12 3 2 12h3v8h5v-6h4v6h5v-8h3l-3-2.7zm-9 .7c0-1.1.9-2 2-2s2 .9 2 2h-4z"/></svg>
          <span class="font-semibold text-navy/70"><%= property.num_rooms %></span>
        </span>
      <% end %>
      <% if property.num_bedrooms.present? && property.num_bedrooms > 0 %>
        <span class="inline-flex items-center gap-1" title="<%= t("listings.bedrooms") %>">
          <svg class="w-3.5 h-3.5 text-navy/40" fill="currentColor" viewBox="0 0 24 24"><path d="M7 13c1.66 0 3-1.34 3-3S8.66 7 7 7s-3 1.34-3 3 1.34 3 3 3zm12-6h-8v7H3V6H1v15h2v-3h18v3h2V10c0-2.21-1.79-4-4-4z"/></svg>
          <span class="font-semibold text-navy/70"><%= property.num_bedrooms %></span>
        </span>
      <% end %>
      <% if property.num_bathrooms.present? && property.num_bathrooms > 0 %>
        <span class="inline-flex items-center gap-1" title="<%= t("listings.bathrooms") %>">
          <svg class="w-3.5 h-3.5 text-navy/40" fill="currentColor" viewBox="0 0 24 24"><path d="M7 7c0-1.1.9-2 2-2s2 .9 2 2h2c0-2.21-1.79-4-4-4S5 4.79 5 7v5H2v4c0 2.21 1.79 4 4 4h12c2.21 0 4-1.79 4-4v-4H7V7zm-2 9v-2h14v2c0 1.1-.9 2-2 2H7c-1.1 0-2-.9-2-2z"/></svg>
          <span class="font-semibold text-navy/70"><%= property.num_bathrooms %></span>
        </span>
      <% end %>
      <% if property.num_parkings.present? && property.num_parkings > 0 %>
        <span class="inline-flex items-center gap-1" title="<%= t("listings.parkings") %>">
          <svg class="w-3.5 h-3.5 text-navy/40" fill="currentColor" viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/></svg>
          <span class="font-semibold text-navy/70"><%= property.num_parkings %></span>
        </span>
      <% end %>
      <% if property.living_area.present? && property.living_area > 0 %>
        <span class="inline-flex items-center gap-1" title="<%= t("listings.area") %>">
          <svg class="w-3.5 h-3.5 text-navy/40" fill="currentColor" viewBox="0 0 24 24"><path d="M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 10H3V8h2v4h2V8h2v4h2V8h2v4h2V8h2v4h2V8h2v4h1v2z"/></svg>
          <span class="font-semibold text-navy/70"><%= property.living_area.to_i %> m²</span>
        </span>
      <% end %>
    </div>
  </a>
</div>
