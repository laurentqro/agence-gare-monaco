<% images = property.photos.to_a %>
<% has_carousel = images.size > 1 %>

<div data-testid="property-card" class="group bg-white border border-stone-200/60 shadow-sm hover:shadow-lg transition-all duration-300">
  <%# Image carousel area %>
  <div class="relative aspect-[4/3] bg-stone-100 overflow-hidden"
       <% if has_carousel %>data-controller="card-carousel"<% end %>>
    <a href="<%= locale_property_path(property) %>" class="block w-full h-full" data-turbo-frame="_top">
      <% if images.any? %>
        <% images.each_with_index do |image, i| %>
          <% src_url = image.medium_url || image.remote_url %>
          <% srcset_parts = [
            ("#{image.small_url} 400w" if image.small_url.present?),
            ("#{image.medium_url} 800w" if image.medium_url.present?),
            ("#{image.large_url} 1200w" if image.large_url.present?)
          ].compact %>
          <img src="<%= src_url %>"
               alt="<%= property.title_for(I18n.locale) %>"
               class="absolute inset-0 w-full h-full object-cover transition-opacity duration-300 <%= i == 0 ? 'opacity-100' : 'opacity-0' %>"
               loading="lazy"
               <% if has_carousel %>data-card-carousel-target="slide"<% end %>
               <% if srcset_parts.any? %>
               srcset="<%= srcset_parts.join(", ") %>"
               sizes="(max-width: 768px) 100vw, 50vw"
               <% end %>>
        <% end %>
      <% else %>
        <div data-testid="no-image-placeholder" class="w-full h-full flex items-center justify-center">
          <img src="<%= image_path("logo-monogram.png") %>" alt="" class="w-2/3 max-w-[160px] opacity-20 grayscale">
        </div>
      <% end %>
    </a>

    <% if has_carousel %>
      <button data-testid="carousel-prev" data-action="card-carousel#prev"
              class="absolute left-2 top-1/2 -translate-y-1/2 w-9 h-9 flex items-center justify-center text-white/80 hover:text-white z-10">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button data-testid="carousel-next" data-action="card-carousel#next"
              class="absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 flex items-center justify-center text-white/80 hover:text-white z-10">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </button>
    <% end %>

    <%# Badges %>
    <% if property.exclusivity? %>
      <div class="absolute top-3 left-3 z-10">
        <span class="bg-gold text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 shadow-sm">
          Exclusivit&eacute;
        </span>
      </div>
    <% end %>
  </div>

  <%# Content area %>
  <a href="<%= locale_property_path(property) %>" class="block px-5 pt-4 pb-5" data-turbo-frame="_top">
    <%# Specs line: TYPE | AREA | BEDROOMS %>
    <div data-testid="card-specs" class="flex items-center text-xs tracking-widest uppercase text-navy/60 mb-2">
      <span><%= t("listings.property_types.#{property.property_type}") %></span>
      <% if property.living_area.present? && property.living_area > 0 %>
        <span class="mx-2.5 text-navy/20">|</span>
        <span><%= property.living_area.to_i %> m&sup2;</span>
      <% end %>
      <% if property.num_bedrooms.present? && property.num_bedrooms > 0 %>
        <span class="mx-2.5 text-navy/20">|</span>
        <span class="inline-flex items-center gap-1">
          <%= property.num_bedrooms %>
          <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v9"/></svg>
        </span>
      <% end %>
    </div>

    <%# Location as main heading %>
    <h3 data-testid="card-location" class="text-navy font-semibold text-xl leading-snug mb-1">
      <%= property.city %>
    </h3>

    <%# Title as tagline %>
    <p data-testid="card-tagline" class="text-navy/50 text-sm leading-snug line-clamp-1 mb-3">
      <%= property.title_for(I18n.locale) %>
    </p>

    <%# Price %>
    <div>
      <% if property.price.present? %>
        <span class="text-navy/70 text-sm">
          <%= property.formatted_price %> &euro;
        </span>
        <% if property.transaction_type == "rental" %>
          <span class="text-navy/50 text-xs ml-0.5"><%= t("property_detail.per_month") %></span>
        <% end %>
        <% if (converted = converted_price_tag(property.price)) %>
          <span data-testid="converted-price" class="text-xs text-navy/40 ml-1.5"><%= converted %></span>
        <% end %>
      <% else %>
        <span class="text-navy/50 text-sm italic">
          <%= t("listings.price_on_request") %>
        </span>
      <% end %>
    </div>
  </a>
</div>
