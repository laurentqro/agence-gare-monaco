<div data-testid="property-card" class="group bg-white rounded-xl overflow-hidden border border-gray-100 hover:border-gray-200 shadow-sm hover:shadow-lg transition-all duration-300">
  <a href="<%= locale_property_path(property) %>" class="block" data-turbo-frame="_top">
    <%# Property image %>
    <div class="relative aspect-[4/3] bg-gray-100 overflow-hidden">
      <% if property.cover_image %>
        <% cover = property.cover_image %>
        <% src_url = cover.medium_url || cover.remote_url %>
        <% srcset_parts = [
          ("#{cover.small_url} 400w" if cover.small_url.present?),
          ("#{cover.medium_url} 800w" if cover.medium_url.present?),
          ("#{cover.large_url} 1200w" if cover.large_url.present?)
        ].compact %>
        <img src="<%= src_url %>"
             alt="<%= property.title_for(I18n.locale) %>"
             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
             loading="lazy"
             <% if srcset_parts.any? %>
             srcset="<%= srcset_parts.join(", ") %>"
             sizes="(max-width: 768px) 100vw, 50vw"
             <% end %>>
      <% else %>
        <div data-testid="no-image-placeholder" class="w-full h-full flex items-center justify-center bg-gray-100">
          <img src="<%= image_path("logo-monogram.png") %>" alt="" class="w-2/3 max-w-[160px] opacity-20 grayscale">
        </div>
      <% end %>

      <%# Badges %>
      <div class="absolute top-3 left-3 flex items-center gap-2">
        <% if property.exclusivity? %>
          <span class="bg-gold text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md shadow-sm">
            Exclusivit&eacute;
          </span>
        <% end %>
      </div>
    </div>

    <%# Content area %>
    <div class="px-5 pt-4 pb-3">
      <%# Title %>
      <h3 class="text-navy font-bold text-lg uppercase tracking-wide leading-snug line-clamp-2 mb-2">
        <%= property.title_for(I18n.locale) %>
      </h3>

      <%# Price %>
      <div class="mb-3">
        <% if property.price.present? %>
          <span class="text-accent text-sm font-semibold">
            <%= property.formatted_price %>&euro;
          </span>
          <% if property.transaction_type == "rental" %>
            <span class="text-accent text-xs font-medium ml-0.5"><%= t("property_detail.per_month") %></span>
          <% end %>
          <% if (converted = converted_price_tag(property.price)) %>
            <span data-testid="converted-price" class="text-xs text-accent ml-1.5"><%= converted %></span>
          <% end %>
        <% else %>
          <span class="text-accent text-sm font-semibold italic">
            <%= t("listings.price_on_request") %>
          </span>
        <% end %>
      </div>
    </div>

    <%# Property stats footer — Lucide icons (stroke-based) %>
    <div class="flex items-center gap-4 text-sm text-accent border-t border-gray-100 px-5 py-3.5">
      <% if property.num_rooms.present? && property.num_rooms > 0 %>
        <span class="inline-flex items-center gap-1.5" title="<%= t("listings.rooms") %>">
          <svg class="w-4.5 h-4.5 text-navy/40" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
          <span class="font-semibold text-navy/70"><%= property.num_rooms %></span>
        </span>
      <% end %>
      <% if property.num_bedrooms.present? && property.num_bedrooms > 0 %>
        <span class="inline-flex items-center gap-1.5" title="<%= t("listings.bedrooms") %>">
          <svg class="w-4.5 h-4.5 text-navy/40" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v9"/></svg>
          <span class="font-semibold text-navy/70"><%= property.num_bedrooms %></span>
        </span>
      <% end %>
      <% if property.num_bathrooms.present? && property.num_bathrooms > 0 %>
        <span class="inline-flex items-center gap-1.5" title="<%= t("listings.bathrooms") %>">
          <svg class="w-4.5 h-4.5 text-navy/40" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6 6.5 3.5a1.5 1.5 0 0 0-1-.5C4.683 3 4 3.683 4 4.5V17a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/><line x1="10" x2="8" y1="5" y2="7"/><line x1="2" x2="22" y1="12" y2="12"/><line x1="7" x2="7" y1="19" y2="21"/><line x1="17" x2="17" y1="19" y2="21"/></svg>
          <span class="font-semibold text-navy/70"><%= property.num_bathrooms %></span>
        </span>
      <% end %>
      <% if property.num_parkings.present? && property.num_parkings > 0 %>
        <span class="inline-flex items-center gap-1.5" title="<%= t("listings.parkings") %>">
          <svg class="w-4.5 h-4.5 text-navy/40" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
          <span class="font-semibold text-navy/70"><%= property.num_parkings %></span>
        </span>
      <% end %>
      <% if property.living_area.present? && property.living_area > 0 %>
        <span class="inline-flex items-center gap-1.5" title="<%= t("listings.area") %>">
          <svg class="w-4.5 h-4.5 text-navy/40" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
          <span class="font-semibold text-navy/70"><%= property.living_area.to_i %> m²</span>
        </span>
      <% end %>
    </div>
  </a>
</div>
