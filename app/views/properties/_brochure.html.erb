<details class="relative shrink-0"
         data-controller="menu"
         data-action="keydown.esc->menu#close">
  <summary data-testid="brochure-button" class="menu-trigger">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
    </svg>
    <%= t("property_detail.brochure.label") %>
  </summary>

  <div data-testid="brochure-panel" class="menu-panel left-0">
    <p class="mb-3 text-[10px] uppercase tracking-[0.25em] text-gold"><%= t("property_detail.brochure.heading") %></p>

    <a href="<%= locale_property_path(property) %>/pdf"
       data-testid="pdf-download-link"
       data-turbo="false"
       data-action="click->menu#close"
       class="menu-item">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
      </svg>
      <%= t("property_detail.brochure.with_logo") %>
    </a>

    <a href="<%= locale_property_path(property) %>/pdf?include_logo=0"
       data-testid="pdf-download-no-logo-link"
       data-turbo="false"
       data-action="click->menu#close"
       class="menu-item">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
      </svg>
      <%= t("property_detail.brochure.without_logo") %>
    </a>
  </div>
</details>
