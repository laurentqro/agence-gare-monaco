<div class="max-w-7xl mx-auto px-4 py-8">
  <%# Page heading %>
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-[#090956]"><%= listing_heading %></h1>
    <p class="text-sm text-[#6E8297] mt-1" data-testid="property-count">
      <%= t("listings.property_count", count: @properties.size) %>
    </p>
  </div>

  <%# Filters %>
  <div data-testid="filters" class="mb-8 bg-gray-50 rounded p-4">
    <%= form_tag(request.path, method: :get, class: "flex flex-wrap gap-4 items-end") do %>
      <div class="flex-1 min-w-[150px]">
        <label for="type" class="block text-xs font-medium text-[#090956] mb-1"><%= t("listings.filter_type") %></label>
        <select name="type" id="type" class="w-full border border-gray-300 rounded px-3 py-2 text-xs focus:outline-none focus:border-[#090956]">
          <option value=""><%= t("listings.filter_all_types") %></option>
          <% property_type_options.each do |type| %>
            <option value="<%= type %>" <%= "selected" if params[:type] == type %>><%= type.capitalize %></option>
          <% end %>
        </select>
      </div>

      <% if @country == "MC" && !params[:district_slug] %>
        <div class="flex-1 min-w-[150px]">
          <label for="district" class="block text-xs font-medium text-[#090956] mb-1"><%= t("listings.filter_district") %></label>
          <select name="district" id="district" class="w-full border border-gray-300 rounded px-3 py-2 text-xs focus:outline-none focus:border-[#090956]">
            <option value=""><%= t("listings.filter_all_districts") %></option>
            <% @districts&.each do |district| %>
              <option value="<%= district.slug %>" <%= "selected" if params[:district] == district.slug %>><%= district.name %></option>
            <% end %>
          </select>
        </div>
      <% end %>

      <div>
        <button type="submit" class="bg-white text-[#090956] border border-[#2E4C87] rounded px-6 py-2 text-xs font-medium hover:bg-gray-50 transition-colors">
          <%= t("listings.filter_apply") %>
        </button>
      </div>
    <% end %>
  </div>

  <%# Property grid %>
  <% if @properties.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @properties.each do |property| %>
        <%= render "properties/property_card", property: property %>
      <% end %>
    </div>
  <% else %>
    <div data-testid="empty-state" class="text-center py-16">
      <p class="text-sm text-[#6E8297]"><%= t("listings.no_properties") %></p>
    </div>
  <% end %>
</div>
