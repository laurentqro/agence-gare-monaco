<div class="max-w-7xl mx-auto px-4 py-8">
  <%# Page heading & count %>
  <% type_param = localized_filter_param(:type) %>
  <% district_param = localized_filter_param(:district) %>
  <% selected_types = filter_values_for(:type) %>
  <% selected_districts = filter_values_for(:district) %>

  <div class="flex items-baseline justify-between mb-4">
    <h1 class="text-2xl font-bold text-navy"><%= listing_heading %></h1>
  </div>

  <%# Filters %>
  <div data-testid="filters" class="mb-6 bg-gray-50 border border-gray-200 rounded-xl px-5 py-4">
    <%= form_tag(request.path, method: :get, class: "flex items-center gap-6", data: { turbo_frame: "property-results", turbo_action: "advance" }) do %>
      <div class="flex items-center gap-3" data-testid="multiselect-type" data-controller="multiselect-filter">
        <label class="text-xs font-bold uppercase tracking-wide text-navy shrink-0"><%= t("listings.filter_type") %></label>
        <div class="relative w-52">
          <button type="button" data-action="click->multiselect-filter#toggle" data-multiselect-filter-target="button"
                  class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm text-left bg-white hover:border-navy/40 focus:outline-none focus:border-navy flex items-center justify-between transition-colors shadow-sm">
            <span data-multiselect-filter-target="label" class="text-navy font-medium">
              <%= selected_types.any? ? t("listings.filter_selected_count", count: selected_types.size) : t("listings.filter_all_types") %>
            </span>
            <svg class="w-4 h-4 ml-2 flex-shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div data-multiselect-filter-target="dropdown" class="hidden absolute z-10 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-72 overflow-y-auto">
            <% grouped_type_filter_options.each_with_index do |group, gi| %>
              <% if gi > 0 %><div class="border-t border-gray-200"></div><% end %>
              <div class="py-1">
                <% group.each do |localized_value, _canonical_key, label| %>
                  <label class="flex items-center px-4 py-2 text-sm hover:bg-gray-50 cursor-pointer">
                    <input type="checkbox" name="<%= type_param %>[]" value="<%= localized_value %>"
                           <%= "checked" if selected_types.include?(localized_value) %>
                           data-action="change->multiselect-filter#changed"
                           class="mr-2.5 h-4 w-4 rounded border-gray-300 text-navy focus:ring-navy">
                    <%= label %>
                  </label>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <% if @country == "MC" && !params[:district_slug] %>
        <div class="flex items-center gap-3" data-testid="multiselect-district" data-controller="multiselect-filter">
          <label class="text-xs font-bold uppercase tracking-wide text-navy shrink-0"><%= t("listings.filter_district") %></label>
          <div class="relative w-52">
            <button type="button" data-action="click->multiselect-filter#toggle" data-multiselect-filter-target="button"
                    class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm text-left bg-white hover:border-navy/40 focus:outline-none focus:border-navy flex items-center justify-between transition-colors shadow-sm">
              <span data-multiselect-filter-target="label" class="text-navy font-medium">
                <%= selected_districts.any? ? t("listings.filter_selected_count", count: selected_districts.size) : t("listings.filter_all_districts") %>
              </span>
              <svg class="w-4 h-4 ml-2 flex-shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div data-multiselect-filter-target="dropdown" class="hidden absolute z-10 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-60 overflow-y-auto py-1">
              <% @districts&.each do |district| %>
                <label class="flex items-center px-4 py-2 text-sm hover:bg-gray-50 cursor-pointer">
                  <input type="checkbox" name="<%= district_param %>[]" value="<%= district.slug %>"
                         <%= "checked" if selected_districts.include?(district.slug) %>
                         data-action="change->multiselect-filter#changed"
                         class="mr-2.5 h-4 w-4 rounded border-gray-300 text-navy focus:ring-navy">
                  <%= district.name %>
                </label>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <turbo-frame id="property-results">
    <%# Active filter chips, grouped by filter type %>
    <% chip_groups = { type: selected_types, district: selected_districts }.select { |_, v| v.any? } %>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-8">
      <p class="text-base font-bold text-navy" data-testid="property-count">
        <%= t("listings.property_count", count: @properties.size) %>
      </p>
      <% if chip_groups.any? %>
        <span class="text-gray-300 text-lg">|</span>
        <div data-testid="active-filters" class="contents">
          <% chip_groups.each do |param_name, values| %>
            <div data-testid="filter-chip-group" class="inline-flex items-center gap-1.5">
              <span class="text-xs uppercase tracking-wider font-bold text-accent"><%= t("listings.filter_#{param_name}") %></span>
              <% values.each do |value| %>
                <span data-testid="filter-chip" class="inline-flex items-center gap-1.5 bg-navy text-white text-sm font-medium pl-3.5 pr-2.5 py-1.5 rounded-full">
                  <%= filter_chip_label(param_name, value) %>
                  <a href="<%= url_without_filter_value(param_name, value) %>" data-turbo-frame="_top" data-turbo-action="advance" class="hover:text-red-300 transition-colors"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"/></svg></a>
                </span>
              <% end %>
            </div>
          <% end %>
          <a href="<%= request.path %>" data-turbo-frame="_top" data-turbo-action="advance" class="inline-flex items-center gap-1.5 text-xs font-medium text-accent hover:text-navy">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h5M20 20v-5h-5M4.5 9A8 8 0 0120 12M19.5 15A8 8 0 014 12"/></svg>
            <%= t("listings.filter_clear_all") %>
          </a>
        </div>
      <% end %>
    </div>

    <%# Property grid %>
    <% if @properties.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% @properties.each do |property| %>
          <%= render "properties/property_card", property: property %>
        <% end %>
      </div>
    <% else %>
      <div data-testid="empty-state" class="text-center py-16">
        <p class="text-sm text-accent"><%= t("listings.no_properties") %></p>
      </div>
    <% end %>
  </turbo-frame>
</div>
