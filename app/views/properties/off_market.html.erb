<% content_for :page_background, true %>
<div class="max-w-7xl mx-auto px-4 py-12">
  <h1 class="heading-page mb-8"><%= t("listings.offmarket_title") %></h1>

  <% if @sales.any? || @rentals.any? %>
    <% if @sales.any? %>
      <section data-testid="offmarket-sales" class="mb-12">
        <h2 class="heading-section mb-6"><%= t("listings.offmarket_sales") %></h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <% @sales.each do |property| %>
            <%= render "property_card", property: property, heading_level: :h3 %>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @rentals.any? %>
      <section data-testid="offmarket-rentals" class="mb-12">
        <h2 class="heading-section mb-6"><%= t("listings.offmarket_rentals") %></h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <% @rentals.each do |property| %>
            <%= render "property_card", property: property, heading_level: :h3 %>
          <% end %>
        </div>
      </section>
    <% end %>
  <% else %>
    <div data-testid="offmarket-empty" class="text-center py-16 text-accent">
      <p class="text-lg"><%= t("listings.offmarket_empty") %></p>
    </div>
  <% end %>
</div>
