<% title = @property.title_for(I18n.locale) %>

<div class="max-w-7xl mx-auto px-4 py-8">
  <%# Back link (hidden for off-market properties) %>
  <% unless @property.off_market? %>
    <div data-testid="back-link" class="mb-6">
      <% if @property.transaction_type == "sale" %>
        <a href="<%= locale_sales_path %>" class="text-accent hover:text-navy text-xs">
          &larr; <%= t("property_detail.back_to_sales") %>
        </a>
      <% else %>
        <a href="<%= locale_rentals_path %>" class="text-accent hover:text-navy text-xs">
          &larr; <%= t("property_detail.back_to_rentals") %>
        </a>
      <% end %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <%# Left column: gallery + description %>
    <div class="lg:col-span-2">
      <%# Photo gallery %>
      <% if @photos.any? %>
        <div data-testid="property-gallery" data-controller="gallery" class="mb-8">
          <%# Main image %>
          <div class="relative aspect-[4/3] bg-gray-100 rounded overflow-hidden mb-3">
            <% @photos.each_with_index do |photo, index| %>
              <% srcset_parts = [
                ("#{photo.small_url} 400w" if photo.small_url.present?),
                ("#{photo.medium_url} 800w" if photo.medium_url.present?),
                ("#{photo.large_url} 1200w" if photo.large_url.present?)
              ].compact %>
              <img src="<%= photo.large_url || photo.remote_url %>"
                   alt="<%= t('property_detail.photo_alt', title: title, number: index + 1) %>"
                   class="w-full h-full object-cover absolute inset-0 transition-opacity duration-300 <%= index == 0 ? 'opacity-100' : 'opacity-0' %>"
                   loading="<%= index == 0 ? 'eager' : 'lazy' %>"
                   data-gallery-photo
                   data-gallery-target="photo"
                   data-index="<%= index %>"
                   <% if srcset_parts.any? %>
                   srcset="<%= srcset_parts.join(", ") %>"
                   sizes="(max-width: 768px) 100vw, 66vw"
                   <% end %>>
            <% end %>

            <%# Navigation arrows %>
            <% if @photos.size > 1 %>
              <button data-action="gallery#prev" class="absolute left-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full w-8 h-8 flex items-center justify-center text-navy shadow">
                &lsaquo;
              </button>
              <button data-action="gallery#next" class="absolute right-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white rounded-full w-8 h-8 flex items-center justify-center text-navy shadow">
                &rsaquo;
              </button>
            <% end %>
          </div>

          <%# Thumbnails %>
          <div data-testid="gallery-thumbnails" class="flex gap-2 overflow-x-auto">
            <% @photos.each_with_index do |photo, index| %>
              <button data-action="gallery#goTo" data-gallery-index-param="<%= index %>"
                      class="flex-shrink-0 w-16 h-12 rounded overflow-hidden border-2 <%= index == 0 ? 'border-navy' : 'border-transparent' %>"
                      data-gallery-target="thumbnail">
                <img src="<%= photo.thumb_url || photo.small_url || photo.remote_url %>"
                     alt="<%= t('property_detail.photo_alt', title: title, number: index + 1) %>"
                     class="w-full h-full object-cover"
                     loading="lazy">
              </button>
            <% end %>
          </div>
        </div>
      <% else %>
        <div data-testid="no-image-placeholder" class="aspect-[4/3] bg-gray-100 rounded overflow-hidden mb-8 flex items-center justify-center">
          <img src="<%= image_path("logo-monogram.png") %>" alt="" class="w-1/3 max-w-[200px] opacity-20 grayscale">
        </div>
      <% end %>

      <%# Badges %>
      <div class="flex gap-2 mb-4">
        <% if @property.recent? %>
          <span data-testid="new-badge" class="bg-navy text-white text-[10px] font-bold uppercase px-2 py-0.5 rounded">
            <%= t("listings.new_badge") %>
          </span>
        <% end %>
        <% if @property.exclusivity? %>
          <span data-testid="exclusivity-badge" class="bg-accent text-white text-[10px] font-bold uppercase px-2 py-0.5 rounded">
            <%= t("property_detail.exclusivity") %>
          </span>
        <% end %>
        <% if @property.off_market? %>
          <span data-testid="off-market-badge" class="bg-purple-600 text-white text-[10px] font-bold uppercase px-2 py-0.5 rounded">
            <%= t("property_detail.off_market_badge") %>
          </span>
        <% end %>
      </div>

      <%# Title %>
      <h1 data-testid="property-title" class="heading-page mb-2"><%= title %></h1>

      <%# Price %>
      <p data-testid="property-price" class="text-xl font-bold text-navy mb-6">
        <% if @property.price.present? %>
          <%= @property.formatted_price %> €<%= @property.transaction_type == "rental" ? t("property_detail.per_month") : "" %>
          <% if (converted = converted_price_tag(@property.price)) %>
            <span data-testid="converted-price" class="text-sm font-normal text-accent"><%= converted %></span>
          <% end %>
        <% else %>
          <%= t("listings.price_on_request") %>
        <% end %>
      </p>

      <hr class="border-gray-200 mb-6">

      <%# Description %>
      <div data-testid="property-description" class="text-body mb-8">
        <%= simple_format(@property.description_for(I18n.locale)) %>
      </div>

      <%# Floor plans %>
      <% if @plans.any? %>
        <div data-testid="floor-plans" class="mb-8">
          <h2 class="heading-section mb-4"><%= t("property_detail.floor_plans") %></h2>
          <div class="grid grid-cols-1 gap-4">
            <% @plans.each_with_index do |plan, index| %>
              <div class="bg-gray-50 rounded p-2">
                <img src="<%= plan.large_url || plan.remote_url %>"
                     alt="<%= t('property_detail.plan_alt', title: title) %>"
                     class="w-full h-auto"
                     loading="lazy">
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Documents %>
      <% if @documents.any? %>
        <div data-testid="property-documents" class="mb-8">
          <h2 class="heading-section mb-4"><%= t("property_detail.documents") %></h2>
          <div class="flex flex-col gap-2">
            <% @documents.each do |doc| %>
              <a href="<%= rails_blob_path(doc.file, disposition: "attachment") %>"
                 class="inline-flex items-center gap-2 text-xs text-navy hover:text-accent">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <%= doc.label.presence || doc.file.filename %>
              </a>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Virtual tour (krpano/Panotour) %>
      <% if @property.virtual_tour_url.present? %>
        <div data-testid="virtual-tour" class="mb-8">
          <h2 class="heading-section mb-4"><%= t("property_detail.virtual_tour") %></h2>
          <% if @property.virtual_tour_url.end_with?(".html") %>
            <div class="aspect-video rounded overflow-hidden">
              <iframe src="<%= @property.virtual_tour_url %>"
                      class="w-full h-full"
                      frameborder="0"
                      allow="accelerometer; magnetometer; gyroscope; fullscreen"
                      allowfullscreen
                      loading="lazy"></iframe>
            </div>
          <% else %>
            <a href="<%= @property.virtual_tour_url %>" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-2 bg-white border border-navy text-navy px-4 py-2 rounded text-xs font-semibold hover:bg-gray-50">
              <%= t("property_detail.view_virtual_tour") %>
            </a>
          <% end %>
        </div>
      <% end %>

      <%# Video %>
      <% if @property.video_url.present? %>
        <div data-testid="property-video" class="mb-8">
          <h2 class="heading-section mb-4"><%= t("property_detail.video") %></h2>
          <% youtube_id = @property.video_url[/(?:v=|\/embed\/|youtu\.be\/)([^&?\/]+)/, 1] %>
          <% if youtube_id %>
            <div class="aspect-video rounded overflow-hidden">
              <iframe src="https://www.youtube-nocookie.com/embed/<%= youtube_id %>"
                      class="w-full h-full"
                      frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                      loading="lazy"></iframe>
            </div>
          <% else %>
            <a href="<%= @property.video_url %>" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-2 bg-white border border-navy text-navy px-4 py-2 rounded text-xs font-semibold hover:bg-gray-50">
              <%= t("property_detail.video") %>
            </a>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Right column: details table %>
    <div>
      <div data-testid="property-details" class="bg-gray-50 rounded p-6 sticky top-20">
        <h2 class="heading-section mb-4"><%= title %></h2>
        <table class="w-full text-xs">
          <tbody>
            <tr class="border-b border-gray-200">
              <td class="py-2 text-accent font-medium"><%= t("property_detail.reference") %></td>
              <td class="py-2 text-dark text-right"><%= @property.reference %></td>
            </tr>
            <% if @property.building.present? %>
              <tr class="border-b border-gray-200">
                <td class="py-2 text-accent font-medium"><%= t("property_detail.building") %></td>
                <td class="py-2 text-dark text-right"><%= @property.building.name %></td>
              </tr>
            <% end %>
            <% if @property.district.present? %>
              <tr class="border-b border-gray-200">
                <td class="py-2 text-accent font-medium"><%= t("property_detail.district") %></td>
                <td class="py-2 text-dark text-right"><%= @property.district.name %></td>
              </tr>
            <% end %>
            <tr class="border-b border-gray-200">
              <td class="py-2 text-accent font-medium"><%= t("property_detail.type") %></td>
              <td class="py-2 text-dark text-right capitalize"><%= @property.property_type %><%= @property.subtype.present? ? " (#{@property.subtype})" : "" %></td>
            </tr>
            <% if @property.num_rooms.present? && @property.num_rooms > 0 %>
              <tr class="border-b border-gray-200">
                <td class="py-2 text-accent font-medium"><%= t("property_detail.rooms") %></td>
                <td class="py-2 text-dark text-right"><%= @property.num_rooms %></td>
              </tr>
            <% end %>
            <% if @property.num_bedrooms.present? && @property.num_bedrooms > 0 %>
              <tr class="border-b border-gray-200">
                <td class="py-2 text-accent font-medium"><%= t("property_detail.bedrooms") %></td>
                <td class="py-2 text-dark text-right"><%= @property.num_bedrooms %></td>
              </tr>
            <% end %>
            <% if @property.num_bathrooms.present? && @property.num_bathrooms > 0 %>
              <tr class="border-b border-gray-200">
                <td class="py-2 text-accent font-medium"><%= t("property_detail.bathrooms") %></td>
                <td class="py-2 text-dark text-right"><%= @property.num_bathrooms %></td>
              </tr>
            <% end %>
            <% if @property.living_area.present? && @property.living_area > 0 %>
              <tr class="border-b border-gray-200">
                <td class="py-2 text-accent font-medium"><%= t("property_detail.living_area") %></td>
                <td class="py-2 text-dark text-right"><%= @property.living_area.to_i %> m²</td>
              </tr>
            <% end %>
            <% if @property.total_area.present? && @property.total_area > 0 %>
              <tr class="border-b border-gray-200">
                <td class="py-2 text-accent font-medium"><%= t("property_detail.total_area") %></td>
                <td class="py-2 text-dark text-right"><%= @property.total_area.to_i %> m²</td>
              </tr>
            <% end %>
            <% if @property.terrace_area.present? && @property.terrace_area > 0 %>
              <tr class="border-b border-gray-200">
                <td class="py-2 text-accent font-medium"><%= t("property_detail.terrace_area") %></td>
                <td class="py-2 text-dark text-right"><%= @property.terrace_area.to_i %> m²</td>
              </tr>
            <% end %>
            <% if @property.land_area.present? && @property.land_area > 0 %>
              <tr class="border-b border-gray-200">
                <td class="py-2 text-accent font-medium"><%= t("property_detail.land_area") %></td>
                <td class="py-2 text-dark text-right"><%= @property.land_area.to_i %> m²</td>
              </tr>
            <% end %>
            <% if @property.garden_area.present? && @property.garden_area > 0 %>
              <tr class="border-b border-gray-200">
                <td class="py-2 text-accent font-medium"><%= t("property_detail.garden_area") %></td>
                <td class="py-2 text-dark text-right"><%= @property.garden_area.to_i %> m²</td>
              </tr>
            <% end %>
            <% if @property.floor.present? %>
              <tr class="border-b border-gray-200">
                <td class="py-2 text-accent font-medium"><%= t("property_detail.floor") %></td>
                <td class="py-2 text-dark text-right"><%= @property.floor %></td>
              </tr>
            <% end %>
            <% if @property.num_parkings.present? && @property.num_parkings > 0 %>
              <tr class="border-b border-gray-200">
                <td class="py-2 text-accent font-medium"><%= t("property_detail.parkings") %></td>
                <td class="py-2 text-dark text-right"><%= @property.num_parkings %></td>
              </tr>
            <% end %>
            <% if @property.num_cellars.present? && @property.num_cellars > 0 %>
              <tr class="border-b border-gray-200">
                <td class="py-2 text-accent font-medium"><%= t("property_detail.cellars") %></td>
                <td class="py-2 text-dark text-right"><%= @property.num_cellars %></td>
              </tr>
            <% end %>
            <% if @property.furnished? %>
              <tr class="border-b border-gray-200">
                <td class="py-2 text-accent font-medium"><%= t("property_detail.furnished") %></td>
                <td class="py-2 text-dark text-right">&#10003;</td>
              </tr>
            <% end %>
            <% if @property.service_charges.present? && @property.service_charges > 0 %>
              <tr class="border-b border-gray-200">
                <td class="py-2 text-accent font-medium"><%= t("property_detail.service_charges") %></td>
                <td class="py-2 text-dark text-right">
                  <%= @property.service_charges %> €
                  <% if @property.service_charges_included? %>
                    <span class="text-accent"><%= t("property_detail.service_charges_included") %></span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <%# PDF download button %>
        <div class="mt-4 pt-4 border-t border-gray-200">
          <a href="<%= locale_property_path(@property) %>/pdf"
             data-testid="pdf-download-link"
             class="inline-flex items-center gap-2 w-full justify-center bg-white border border-navy text-navy px-4 py-2 rounded text-xs font-semibold hover:bg-gray-50">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <%= t("property_detail.download_pdf") %>
          </a>
        </div>

        <%# WhatsApp button %>
        <div data-testid="whatsapp-button" class="mt-4">
          <% property_url = "#{SeoHelper::SITE_HOST}#{locale_property_path(@property)}" %>
          <% whatsapp_message = t("contact_form.whatsapp_enquiry_message", reference: @property.reference, url: property_url) %>
          <a href="https://wa.me/33662392065?text=<%= ERB::Util.url_encode(whatsapp_message) %>"
             target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-2 w-full justify-center bg-[#25D366] text-white px-4 py-2 rounded text-xs font-semibold hover:bg-[#1da851]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <%= t("contact_form.whatsapp") %>
          </a>
        </div>
      </div>
    </div>
  </div>

  <%# Enquiry form %>
  <div data-testid="enquiry-form" class="mt-12">
    <hr class="border-gray-200 mb-8">
    <h2 class="heading-section mb-6"><%= t("contact_form.enquiry_title") %></h2>

    <div class="max-w-xl">
      <p class="text-xs text-accent mb-4">
        <%= t("contact_form.enquiry_reference") %>:
        <span class="font-semibold text-dark"><%= @property.reference %></span>
      </p>

      <% enquiry = @submission || ContactSubmission.new %>
      <% if enquiry.errors.any? %>
        <div data-testid="form-errors" class="bg-red-50 border border-red-200 rounded p-4 mb-6">
          <ul class="text-xs text-red-600 space-y-1">
            <% enquiry.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with(model: enquiry, url: contact_submissions_path, method: :post, local: true, class: "space-y-4") do |f| %>
        <%# Honeypot field %>
        <div style="position: absolute; left: -9999px;" aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" name="website" id="website" tabindex="-1" autocomplete="off">
        </div>

        <%= f.hidden_field :property_id, value: @property.id %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="contact_submission_name" class="block text-xs font-medium text-dark mb-1">
              <%= t("contact_form.name") %> *
            </label>
            <%= f.text_field :name, class: "w-full border border-gray-300 rounded px-3 py-2 text-xs focus:border-navy focus:outline-none", required: true %>
          </div>

          <div>
            <label for="contact_submission_email" class="block text-xs font-medium text-dark mb-1">
              <%= t("contact_form.email") %> *
            </label>
            <%= f.email_field :email, class: "w-full border border-gray-300 rounded px-3 py-2 text-xs focus:border-navy focus:outline-none", required: true %>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="contact_submission_phone" class="block text-xs font-medium text-dark mb-1">
              <%= t("contact_form.phone") %>
            </label>
            <%= f.telephone_field :phone, class: "w-full border border-gray-300 rounded px-3 py-2 text-xs focus:border-navy focus:outline-none" %>
          </div>

          <div>
            <label for="contact_submission_country" class="block text-xs font-medium text-dark mb-1">
              <%= t("contact_form.country") %>
            </label>
            <%= f.text_field :country, class: "w-full border border-gray-300 rounded px-3 py-2 text-xs focus:border-navy focus:outline-none" %>
          </div>
        </div>

        <div>
          <label for="contact_submission_message" class="block text-xs font-medium text-dark mb-1">
            <%= t("contact_form.message") %> *
          </label>
          <%= f.text_area :message, rows: 5, class: "w-full border border-gray-300 rounded px-3 py-2 text-xs focus:border-navy focus:outline-none", required: true %>
        </div>

        <div>
          <%= f.submit t("contact_form.send"), class: "bg-white border border-navy text-navy px-6 py-2 rounded text-xs font-semibold hover:bg-gray-50 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>

  <%# Similar properties (hidden for off-market properties) %>
  <% if !@property.off_market? && @similar_properties&.any? %>
    <div data-testid="similar-properties" class="mt-12">
      <hr class="border-gray-200 mb-8">
      <h2 class="heading-section mb-6"><%= t("property_detail.similar_properties") %></h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @similar_properties.each do |property| %>
          <%= render "properties/property_card", property: property %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
