<div class="p-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="heading-page"><%= t("admin.information_requests.title") %></h1>
  </div>

  <% tabs = [ nil, "unread", "enquiry", "contact" ].map do |value|
       { path: admin_information_requests_path({ filter: value }.compact_blank),
         label: t("admin.information_requests.filters.#{value || "all"}"),
         count: @counts[(value || "all").to_sym],
         active: @filter == value }
     end %>

  <div class="flex flex-wrap items-center gap-4 mb-4">
    <%= render "admin/shared/filter_tabs", tabs: tabs %>
  </div>

  <div class="bg-white rounded shadow overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-100 text-left text-xs uppercase tracking-wider border-b-2 border-gray-200">
        <tr>
          <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.information_requests.table.type") %></th>
          <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.information_requests.table.name") %></th>
          <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.information_requests.table.email") %></th>
          <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.information_requests.table.subject") %></th>
          <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.information_requests.table.date") %></th>
          <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.shared.actions") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @submissions.each do |submission| %>
          <tr class="hover:bg-gray-50 <%= "font-semibold" unless submission.read? %>">
            <td class="px-4 py-3">
              <% if submission.form_type == "enquiry" %>
                <%= admin_badge t("admin.information_requests.filters.enquiry"), variant: :accent %>
              <% else %>
                <%= admin_badge t("admin.information_requests.filters.contact") %>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <%= link_to submission.name, admin_information_request_path(submission), class: "text-navy hover:underline" %>
              <% unless submission.read? %>
                <span class="ml-1 inline-block w-2 h-2 rounded-full bg-accent align-middle" title="<%= t("admin.information_requests.unread") %>"></span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-gray-500"><%= submission.email %></td>
            <td class="px-4 py-3 text-gray-500"><%= submission.subject %></td>
            <td class="px-4 py-3 text-gray-500 whitespace-nowrap"><%= l(submission.created_at, format: "%d/%m/%Y %H:%M") %></td>
            <td class="px-4 py-3">
              <div class="flex items-center gap-1">
                <%= admin_action_link t("admin.shared.view"), admin_information_request_path(submission), icon: :eye %>
                <%= admin_action_link t("admin.shared.delete"), admin_information_request_path(submission), icon: :trash, variant: :danger, data: { turbo_method: :delete, turbo_confirm: t("admin.shared.confirm_delete") } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @submissions.empty? %>
      <p class="px-4 py-8 text-center text-gray-400"><%= t("admin.information_requests.empty") %></p>
    <% end %>
  </div>
</div>
