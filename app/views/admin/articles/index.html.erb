<div class="p-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="heading-page"><%= t("admin.articles.title") %></h1>
    <%= link_to t("admin.articles.new_action"), new_admin_article_path, class: "bg-navy text-white px-4 py-2 rounded hover:bg-navy/90" %>
  </div>

  <div class="bg-white rounded shadow overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left">
        <tr>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.articles.table.title") %></th>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.articles.table.category") %></th>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.articles.table.status") %></th>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.articles.table.featured") %></th>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.articles.table.date") %></th>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.shared.actions") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @articles.each do |article| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3"><%= article.title_for(:fr) %></td>
            <td class="px-4 py-3"><%= article.category.name_for(:fr) %></td>
            <td class="px-4 py-3">
              <% if article.published? %>
                <span class="inline-block px-2 py-1 text-xs font-medium bg-green-100 text-green-700 rounded"><%= t("admin.articles.published") %></span>
              <% else %>
                <span class="inline-block px-2 py-1 text-xs font-medium bg-gray-100 text-gray-600 rounded"><%= t("admin.articles.draft") %></span>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <% if article.featured? %>
                <span class="inline-block px-2 py-1 text-xs font-medium bg-yellow-100 text-yellow-700 rounded"><%= t("admin.articles.table.featured") %></span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-gray-500">
              <%= article.published_at&.strftime("%d/%m/%Y") || article.created_at.strftime("%d/%m/%Y") %>
            </td>
            <td class="px-4 py-3 space-x-2">
              <%= link_to t("admin.shared.edit"), edit_admin_article_path(article), class: "text-accent hover:underline" %>
              <%= link_to t("admin.shared.delete"), admin_article_path(article), data: { turbo_method: :delete, turbo_confirm: t("admin.shared.confirm_delete") }, class: "text-red-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
