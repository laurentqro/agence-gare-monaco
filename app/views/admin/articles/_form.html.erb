<%= form_with(model: [:admin, article], class: "space-y-6") do |f| %>
  <% if article.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-400 p-4">
      <p class="text-red-700 font-medium"><%= t("admin.shared.errors", count: article.errors.count) %></p>
      <ul class="mt-2 text-sm text-red-600 list-disc list-inside">
        <% article.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Main content column %>
    <div class="lg:col-span-2 space-y-6">
      <%# Multilingual titles %>
      <fieldset class="bg-white rounded shadow p-6">
        <legend class="text-lg font-semibold text-[#090956] mb-4"><%= t("admin.articles.form.title_legend") %></legend>
        <div class="space-y-4">
          <% I18n.available_locales.each do |locale| %>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"><%= locale.to_s.upcase %></label>
              <input type="text" name="article[title][<%= locale %>]" value="<%= article.title&.dig(locale.to_s) %>"
                     class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
            </div>
          <% end %>
        </div>
      </fieldset>

      <%# Multilingual body %>
      <fieldset class="bg-white rounded shadow p-6">
        <legend class="text-lg font-semibold text-[#090956] mb-4"><%= t("admin.articles.form.body_legend") %></legend>
        <div class="space-y-4">
          <% I18n.available_locales.each do |locale| %>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"><%= locale.to_s.upcase %></label>
              <textarea name="article[body][<%= locale %>]" rows="8"
                        class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]"><%= article.body&.dig(locale.to_s) %></textarea>
            </div>
          <% end %>
        </div>
      </fieldset>
    </div>

    <%# Sidebar column %>
    <div class="space-y-6">
      <div class="bg-white rounded shadow p-6 space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("admin.articles.form.slug") %></label>
          <input type="text" name="article[slug]" value="<%= article.slug %>"
                 placeholder="<%= t("admin.articles.form.slug_placeholder") %>"
                 class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("admin.articles.form.category") %></label>
          <%= f.select :category_id, @categories.map { |c| [c.name, c.id] },
                       { prompt: t("admin.articles.form.select_category") },
                       class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]" %>
        </div>

        <div class="flex items-center gap-2">
          <%= f.check_box :published, class: "rounded border-gray-300 text-[#090956] focus:ring-[#090956]" %>
          <label class="text-sm font-medium text-gray-700"><%= t("admin.articles.form.published") %></label>
        </div>

        <div class="flex items-center gap-2">
          <%= f.check_box :featured, class: "rounded border-gray-300 text-[#090956] focus:ring-[#090956]" %>
          <label class="text-sm font-medium text-gray-700"><%= t("admin.articles.form.featured") %></label>
        </div>
      </div>

      <div class="flex gap-3">
        <%= f.submit article.persisted? ? t("admin.articles.form.update") : t("admin.articles.form.create"),
                     class: "bg-[#090956] text-white px-4 py-2 rounded hover:bg-[#090956]/90 cursor-pointer" %>
        <%= link_to t("admin.shared.cancel"), admin_articles_path, class: "px-4 py-2 border border-gray-300 rounded text-gray-700 hover:bg-gray-50" %>
      </div>
    </div>
  </div>
<% end %>
