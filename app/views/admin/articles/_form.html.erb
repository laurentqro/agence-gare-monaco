<%= form_with(model: [:admin, article], class: "space-y-6") do |f| %>
  <% if article.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-400 p-4">
      <p class="text-red-700 font-medium"><%= t("admin.shared.errors", count: article.errors.count) %></p>
      <ul class="mt-2 text-sm text-red-600 list-disc list-inside">
        <% article.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Main content column %>
    <div class="lg:col-span-2 space-y-6">
      <%# Title (FR) %>
      <fieldset class="bg-white rounded shadow p-6">
        <legend class="heading-section mb-4"><%= t("admin.articles.form.title_legend") %></legend>
        <div>
          <input type="text" name="article[title][fr]" value="<%= article.title&.dig("fr") %>"
                 class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-navy focus:border-navy">
        </div>
      </fieldset>

      <%# Multilingual body %>
      <fieldset class="bg-white rounded shadow p-6">
        <legend class="heading-section mb-4"><%= t("admin.articles.form.body_legend") %></legend>
        <%# French body field with markdown editor %>
        <div data-controller="markdown-editor" data-markdown-editor-preview-url-value="<%= admin_article_preview_path %>" data-markdown-editor-direct-upload-url-value="<%= rails_direct_uploads_url %>">
          <%# Write/Preview tabs %>
          <div class="flex border-b border-gray-200 mb-2">
            <button type="button"
                    data-markdown-editor-target="writeTab"
                    data-action="click->markdown-editor#showWrite"
                    class="px-3 py-1.5 text-sm font-medium border-b-2 border-navy text-navy">
              Écrire
            </button>
            <button type="button"
                    data-markdown-editor-target="previewTab"
                    data-action="click->markdown-editor#showPreview"
                    class="px-3 py-1.5 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700">
              Aperçu
            </button>
          </div>

          <%# Toolbar %>
          <div class="flex flex-wrap gap-1 mb-2" data-markdown-editor-target="toolbar">
            <button type="button" data-action="click->markdown-editor#bold" aria-label="Gras" class="px-2 py-1 text-sm font-bold border border-gray-300 rounded hover:bg-gray-100" title="Gras">B</button>
            <button type="button" data-action="click->markdown-editor#italic" aria-label="Italique" class="px-2 py-1 text-sm italic border border-gray-300 rounded hover:bg-gray-100" title="Italique">I</button>
            <button type="button" data-action="click->markdown-editor#heading2" aria-label="Titre H2" class="px-2 py-1 text-sm font-semibold border border-gray-300 rounded hover:bg-gray-100" title="Titre H2">H2</button>
            <button type="button" data-action="click->markdown-editor#heading3" aria-label="Titre H3" class="px-2 py-1 text-sm font-semibold border border-gray-300 rounded hover:bg-gray-100" title="Titre H3">H3</button>
            <span class="border-l border-gray-300 mx-1"></span>
            <button type="button" data-action="click->markdown-editor#link" aria-label="Lien" class="px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-100" title="Lien">🔗</button>
            <button type="button" data-action="click->markdown-editor#bulletList" aria-label="Liste à puces" class="px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-100" title="Liste à puces">• Liste</button>
            <button type="button" data-action="click->markdown-editor#numberedList" aria-label="Liste numérotée" class="px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-100" title="Liste numérotée">1. Liste</button>
            <button type="button" data-action="click->markdown-editor#quote" aria-label="Citation" class="px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-100" title="Citation">❝ Citation</button>
            <span class="border-l border-gray-300 mx-1"></span>
            <button type="button" data-action="click->markdown-editor#image" aria-label="Image" class="px-2 py-1 text-sm border border-gray-300 rounded hover:bg-gray-100" title="Image">🖼 Image</button>
            <input type="file" accept="image/*" class="hidden" data-markdown-editor-target="fileInput" data-action="change->markdown-editor#imageSelected">
          </div>

          <%# Textarea (Write mode) %>
          <textarea name="article[body][fr]" rows="12"
                    data-markdown-editor-target="textarea"
                    class="w-full border border-gray-300 rounded px-3 py-2 text-sm font-mono focus:ring-navy focus:border-navy"><%= article.body&.dig("fr") %></textarea>

          <%# Preview area %>
          <div id="preview"
               data-markdown-editor-target="preview"
               class="hidden w-full border border-gray-300 rounded px-3 py-2 text-sm min-h-[12rem] article-body">
          </div>
        </div>
      </fieldset>

      <%# SEO Overrides per locale: edit-only, collapsed by default %>
      <% if article.persisted? %>
        <details class="seo-overrides bg-white rounded shadow p-6">
          <summary class="heading-section cursor-pointer select-none"><%= t("admin.articles.form.seo_overrides_legend") %></summary>
          <p class="mt-2 text-xs text-gray-500"><%= t("admin.articles.form.seo_overrides_hint") %></p>

          <div class="mt-4 space-y-6">
            <% Article::TARGET_LOCALES.each do |locale| %>
              <div data-locale="<%= locale %>" class="border-t border-gray-200 pt-4">
                <h3 class="text-sm font-semibold text-gray-800 mb-3 flex items-center gap-2">
                  <span><%= locale.upcase %></span>
                  <% if article.seo_override?(locale) %>
                    <span class="seo-override-active text-xs font-normal text-navy bg-navy/10 rounded px-2 py-0.5"><%= t("admin.articles.form.seo_override_active") %></span>
                  <% end %>
                </h3>

                <div class="space-y-3">
                  <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("admin.articles.form.seo_override_title") %></label>
                    <input type="text" name="article[title_overrides][<%= locale %>]"
                           <% if article.title_overrides&.dig(locale).present? %>value="<%= article.title_overrides[locale] %>"<% end %>
                           placeholder="<%= article.title&.dig(locale) %>"
                           class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-navy focus:border-navy">
                  </div>

                  <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("admin.articles.form.seo_override_meta_description") %></label>
                    <textarea name="article[meta_description_overrides][<%= locale %>]" rows="2" maxlength="160"
                              placeholder="<%= article.meta_description&.dig(locale) %>"
                              class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-navy focus:border-navy"><%= article.meta_description_overrides&.dig(locale) %></textarea>
                  </div>

                  <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("admin.articles.form.seo_override_slug") %></label>
                    <input type="text" name="article[slugs][<%= locale %>]"
                           <% if article.slugs&.dig(locale).present? %>value="<%= article.slugs[locale] %>"<% end %>
                           placeholder="<%= article.slug %>"
                           class="w-full border border-gray-300 rounded px-3 py-2 text-sm font-mono focus:ring-navy focus:border-navy">
                    <p class="mt-1 text-xs text-gray-500"><%= t("admin.articles.form.seo_override_slug_hint") %></p>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>

    <%# Sidebar column %>
    <div class="space-y-6">
      <div class="bg-white rounded shadow p-6 space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("admin.articles.form.slug") %></label>
          <input type="text" name="article[slug]" value="<%= article.slug %>"
                 placeholder="<%= t("admin.articles.form.slug_placeholder") %>"
                 class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-navy focus:border-navy">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("admin.articles.form.meta_description") %></label>
          <textarea name="article[meta_description][fr]" rows="3" maxlength="160"
                    class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-navy focus:border-navy"><%= article.meta_description&.dig("fr") %></textarea>
          <p class="mt-1 text-xs text-gray-500"><%= t("admin.articles.form.meta_description_hint") %></p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("admin.articles.form.category") %></label>
          <%= f.select :category_id, @categories.map { |c| [c.name_for(:fr), c.id] },
                       { prompt: t("admin.articles.form.select_category") },
                       class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-navy focus:border-navy" %>
        </div>

        <div class="flex items-center gap-2">
          <%= f.check_box :published, class: "rounded border-gray-300 text-navy focus:ring-navy" %>
          <label class="text-sm font-medium text-gray-700"><%= t("admin.articles.form.published") %></label>
        </div>

        <div class="flex items-center gap-2">
          <%= f.check_box :featured, class: "rounded border-gray-300 text-navy focus:ring-navy" %>
          <label class="text-sm font-medium text-gray-700"><%= t("admin.articles.form.featured") %></label>
        </div>
      </div>

      <%# Cover image selector %>
      <% images = article.body_image_urls %>
      <% if images.any? %>
        <div class="bg-white rounded shadow p-6 cover-image-selector">
          <label class="block text-sm font-medium text-gray-700 mb-3"><%= t("admin.articles.form.cover_image") %></label>
          <div class="grid grid-cols-2 gap-2">
            <% images.each do |url| %>
              <label class="cursor-pointer block">
                <input type="radio" name="article[cover_image_url]" value="<%= url %>"
                       class="sr-only peer" <%= "checked" if article.cover_image_url == url %>>
                <img src="<%= url %>" alt="" class="w-full aspect-[16/10] object-cover rounded border-2 peer-checked:border-navy border-transparent hover:border-gray-300" loading="lazy">
              </label>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="flex gap-3">
        <%= f.submit article.persisted? ? t("admin.articles.form.update") : t("admin.articles.form.create"),
                     class: "bg-navy text-white px-4 py-2 rounded hover:bg-navy/90 cursor-pointer" %>
        <%= link_to t("admin.shared.cancel"), admin_articles_path, class: "px-4 py-2 border border-gray-300 rounded text-gray-700 hover:bg-gray-50" %>
      </div>
    </div>
  </div>
<% end %>
