<div class="p-8">
  <h1 class="heading-page mb-6"><%= t("admin.dashboard.title") %></h1>
  <p class="text-gray-600 mb-8"><%= t("admin.dashboard.welcome", email: Current.user.email_address) %></p>

  <h2 class="text-lg font-semibold text-gray-900 mb-4"><%= t("admin.dashboard.quick_links.title") %></h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <%= link_to t("admin.dashboard.quick_links.new_article"), new_admin_article_path,
        class: "flex items-center gap-3 p-4 bg-white border border-gray-200 rounded-lg hover:border-[#090956] hover:shadow-sm transition" %>
    <%= link_to t("admin.dashboard.quick_links.new_off_market_property"), new_admin_property_path,
        class: "flex items-center gap-3 p-4 bg-white border border-gray-200 rounded-lg hover:border-[#090956] hover:shadow-sm transition" %>
    <%= link_to t("admin.dashboard.quick_links.new_contact"), new_admin_contact_path,
        class: "flex items-center gap-3 p-4 bg-white border border-gray-200 rounded-lg hover:border-[#090956] hover:shadow-sm transition" %>
    <%= link_to t("admin.dashboard.quick_links.all_properties"), admin_properties_path,
        class: "flex items-center gap-3 p-4 bg-white border border-gray-200 rounded-lg hover:border-[#090956] hover:shadow-sm transition" %>
    <%= link_to t("admin.dashboard.quick_links.all_contacts"), admin_contacts_path,
        class: "flex items-center gap-3 p-4 bg-white border border-gray-200 rounded-lg hover:border-[#090956] hover:shadow-sm transition" %>
  </div>
</div>
