<div class="p-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="heading-page"><%= t("admin.contact_submissions.title") %></h1>
  </div>

  <% tabs = [
       [nil, t("admin.contact_submissions.filters.all"), @counts[:all]],
       ["unread", t("admin.contact_submissions.filters.unread"), @counts[:unread]],
       ["enquiry", t("admin.contact_submissions.filters.enquiry"), @counts[:enquiry]],
       ["contact", t("admin.contact_submissions.filters.contact"), @counts[:contact]]
     ] %>

  <div class="flex flex-wrap items-center gap-4 mb-4">
    <nav class="inline-flex rounded-lg border border-gray-200 bg-white p-1 text-sm">
      <% tabs.each do |value, label, count| %>
        <% active = @filter == value %>
        <%= link_to admin_contact_submissions_path({ filter: value }.compact_blank),
              class: "px-3 py-1.5 rounded-md inline-flex items-center gap-1.5 #{active ? "bg-navy text-white" : "text-gray-600 hover:text-navy"}" do %>
          <%= label %>
          <span class="text-xs <%= active ? "text-white/80" : "text-gray-400" %>"><%= count %></span>
        <% end %>
      <% end %>
    </nav>
  </div>

  <div class="bg-white rounded shadow overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-100 text-left text-xs uppercase tracking-wider border-b-2 border-gray-200">
        <tr>
          <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.contact_submissions.table.type") %></th>
          <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.contact_submissions.table.name") %></th>
          <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.contact_submissions.table.email") %></th>
          <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.contact_submissions.table.subject") %></th>
          <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.contact_submissions.table.date") %></th>
          <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.shared.actions") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @submissions.each do |submission| %>
          <tr class="hover:bg-gray-50 <%= "font-semibold" unless submission.read? %>">
            <td class="px-4 py-3">
              <% if submission.form_type == "enquiry" %>
                <span class="inline-block rounded-full bg-accent/10 text-accent text-xs px-2 py-0.5"><%= t("admin.contact_submissions.filters.enquiry") %></span>
              <% else %>
                <span class="inline-block rounded-full bg-gray-100 text-gray-500 text-xs px-2 py-0.5"><%= t("admin.contact_submissions.filters.contact") %></span>
              <% end %>
            </td>
            <td class="px-4 py-3">
              <%= link_to submission.name, admin_contact_submission_path(submission), class: "text-navy hover:underline" %>
              <% unless submission.read? %>
                <span class="ml-1 inline-block w-2 h-2 rounded-full bg-accent align-middle" title="<%= t("admin.contact_submissions.unread") %>"></span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-gray-500"><%= submission.email %></td>
            <td class="px-4 py-3 text-gray-500"><%= submission.subject %></td>
            <td class="px-4 py-3 text-gray-500 whitespace-nowrap"><%= l(submission.created_at, format: "%d/%m/%Y %H:%M") %></td>
            <td class="px-4 py-3">
              <div class="flex items-center gap-1">
                <%= admin_action_link t("admin.shared.view"), admin_contact_submission_path(submission), icon: :eye %>
                <%= admin_action_link t("admin.shared.delete"), admin_contact_submission_path(submission), icon: :trash, variant: :danger, data: { turbo_method: :delete, turbo_confirm: t("admin.shared.confirm_delete") } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @submissions.empty? %>
      <p class="px-4 py-8 text-center text-gray-400"><%= t("admin.contact_submissions.empty") %></p>
    <% end %>
  </div>
</div>
