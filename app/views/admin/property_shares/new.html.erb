<div class="p-8">
  <h1 class="text-2xl font-bold text-navy mb-6"><%= t("admin.property_shares.title") %></h1>

  <div class="bg-white rounded shadow p-6 mb-6">
    <h2 class="text-lg font-semibold text-navy mb-3"><%= t("admin.property_shares.property_details") %></h2>
    <table class="text-sm">
      <tr>
        <td class="font-medium text-gray-600 pr-4 py-1"><%= t("admin.property_shares.reference") %></td>
        <td class="py-1"><%= @property.reference %></td>
      </tr>
      <tr>
        <td class="font-medium text-gray-600 pr-4 py-1"><%= t("admin.property_shares.title_label") %></td>
        <td class="py-1"><%= @property.title_for(:fr) %></td>
      </tr>
      <% if @property.price.present? %>
      <tr>
        <td class="font-medium text-gray-600 pr-4 py-1"><%= t("admin.property_shares.price") %></td>
        <td class="py-1"><%= @property.formatted_price %> €</td>
      </tr>
      <% end %>
    </table>
  </div>

  <%= form_with(url: admin_property_share_path(@property), method: :post, class: "space-y-6") do |f| %>
    <div class="bg-white rounded shadow p-6">
      <h2 class="text-lg font-semibold text-navy mb-3"><%= t("admin.property_shares.select_contacts") %></h2>

      <% if @contacts.any? %>
        <div class="space-y-2">
          <% @contacts.each do |contact| %>
            <label class="flex items-center gap-3 p-2 rounded hover:bg-gray-50 cursor-pointer">
              <input type="checkbox" name="contact_ids[]" value="<%= contact.id %>" class="rounded border-gray-300 text-navy focus:ring-navy">
              <span class="text-sm">
                <span class="font-medium"><%= contact.first_name %> <%= contact.last_name %></span>
                <span class="text-gray-500">— <%= contact.email %></span>
              </span>
            </label>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500 text-sm"><%= t("admin.property_shares.no_contacts") %> <%= link_to t("admin.property_shares.add_contact"), new_admin_contact_path, class: "text-accent hover:underline" %></p>
      <% end %>
    </div>

    <div class="flex gap-3">
      <%= f.submit t("admin.property_shares.send_email"), class: "bg-navy text-white px-4 py-2 rounded hover:bg-navy/90 cursor-pointer" %>
      <%= link_to t("admin.shared.cancel"), admin_contacts_path, class: "px-4 py-2 border border-gray-300 rounded text-gray-700 hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
