<div class="p-8">
  <h1 class="heading-page mb-2"><%= t("admin.property_shares.title") %></h1>
  <p class="text-sm text-gray-500 mb-6"><%= @property.reference %> — <%= @property.title_for(:fr) %></p>

  <%# The share form is rendered EMPTY and OUTSIDE the recipient lists. Each
      recipient list lives in a Turbo Frame that contains its own search <form>,
      and a <form> may not nest inside another <form> (the browser auto-closes
      the outer one, orphaning the submit button so "Send" does nothing). So the
      fields below associate to this form by id via the form: "share_form"
      attribute instead of being wrapped by it. %>
  <%= form_with url: admin_property_share_path(@property), method: :post, id: "share_form" do |f| %><% end %>

  <%= render "admin/shared/form_errors", model: @property_share %>

  <%# Zero shareable contacts at all (not just an empty search): point the
      admin straight at contact creation instead of bare empty lists. %>
  <% if @recipient_sections.all? { |s| s[:recipients].empty? && s[:query].blank? } %>
    <p class="text-gray-500 text-sm mb-6">
      <%= t("admin.property_shares.no_contacts") %>
      <%= link_to t("admin.property_shares.add_contact"), new_admin_contact_path, class: "text-accent hover:underline" %>
    </p>
  <% end %>

  <%= render "admin/shared/recipient_sections",
        sections: @recipient_sections,
        frame_prefix: "share",
        selected_ids: @selected_contact_ids,
        url: new_admin_property_share_path(@property),
        form_id: "share_form" %>

  <%# share-preview spans everything from the fields card down to the preview
      card (subject, note, PDF options, buttons, iframe); it only needs the
      note textarea (source) and the iframe (frame), but they sit at opposite
      ends of that block, so the controller must wrap the whole stretch.
      Typing the note re-renders the preview with the real mailer output
      (debounced). %>
  <div data-controller="share-preview"
       data-share-preview-url-value="<%= preview_admin_property_share_path(@property) %>">
  <div class="bg-white rounded shadow p-6 mb-6 space-y-4">
    <div>
      <%= label_tag "property_share[subject]", t("admin.property_shares.fields.subject"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= text_field_tag "property_share[subject]", @property_share.subject, form: "share_form",
            class: "w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:border-navy focus:ring-2 focus:ring-navy/30" %>
    </div>
    <div>
      <%= label_tag "property_share[body]", t("admin.property_shares.fields.body"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= text_area_tag "property_share[body]", @property_share.body, rows: 6, form: "share_form",
            placeholder: t("admin.property_shares.fields.body_placeholder"),
            data: { share_preview_target: "source", action: "input->share-preview#changed" },
            class: "w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:border-navy focus:ring-2 focus:ring-navy/30" %>
    </div>
    <div class="space-y-2">
      <label class="flex items-center gap-3 cursor-pointer">
        <input type="hidden" name="property_share[attach_pdf]" value="0" form="share_form">
        <%= check_box_tag "property_share[attach_pdf]", "1", @property_share.attach_pdf, form: "share_form",
              class: "rounded border-gray-300 text-navy focus:ring-navy" %>
        <span class="text-sm"><%= t("admin.property_shares.fields.attach_pdf") %></span>
      </label>
      <%# Only honored when the brochure is attached; harmless otherwise. %>
      <label class="flex items-center gap-3 cursor-pointer pl-7">
        <input type="hidden" name="property_share[include_logo]" value="0" form="share_form">
        <%= check_box_tag "property_share[include_logo]", "1", @property_share.include_logo, form: "share_form",
              class: "rounded border-gray-300 text-navy focus:ring-navy" %>
        <span class="text-sm"><%= t("admin.property_shares.fields.include_logo") %></span>
      </label>
    </div>
  </div>

  <div class="flex gap-3">
    <%= submit_tag t("admin.property_shares.send_email"), form: "share_form", class: "bg-navy text-white px-4 py-2 rounded hover:bg-navy/90 cursor-pointer" %>
    <%= link_to t("admin.shared.cancel"), admin_contacts_path, class: "px-4 py-2 border border-gray-300 rounded text-gray-700 hover:bg-gray-50" %>
  </div>

  <div class="bg-white rounded shadow p-6 mt-6">
    <h2 class="heading-section mb-3"><%= t("admin.property_shares.email_preview") %></h2>
    <div class="border border-gray-200 rounded bg-white" style="max-width: 640px; margin: 0 auto;">
      <iframe sandbox srcdoc="<%= html_escape(@email_preview) %>"
              data-share-preview-target="frame"
              style="width: 100%; min-height: 800px; border: 0; display: block;"
              title="<%= t("admin.property_shares.email_preview") %>"></iframe>
    </div>
  </div>
  </div>
</div>
