<%= form_with(model: [:admin, contact], class: "max-w-lg space-y-4") do |f| %>
  <% if contact.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-400 p-4">
      <p class="text-red-700 font-medium"><%= t("admin.shared.errors", count: contact.errors.count) %></p>
      <ul class="mt-2 text-sm text-red-600 list-disc list-inside">
        <% contact.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("admin.contacts.form.first_name") %></label>
    <%= f.text_field :first_name, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]" %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("admin.contacts.form.last_name") %></label>
    <%= f.text_field :last_name, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]" %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("admin.contacts.form.email") %></label>
    <%= f.email_field :email, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]" %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("admin.contacts.form.phone") %></label>
    <%= f.text_field :phone, placeholder: t("admin.contacts.form.phone_placeholder"), class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]" %>
  </div>

  <div class="flex gap-3">
    <%= f.submit contact.persisted? ? t("admin.contacts.form.update") : t("admin.contacts.form.create"),
                 class: "bg-[#090956] text-white px-4 py-2 rounded hover:bg-[#090956]/90 cursor-pointer" %>
    <%= link_to t("admin.shared.cancel"), admin_contacts_path, class: "px-4 py-2 border border-gray-300 rounded text-gray-700 hover:bg-gray-50" %>
  </div>
<% end %>
