<div class="p-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="heading-page"><%= t("admin.contacts.title") %></h1>
    <%= link_to t("admin.contacts.new_action"), new_admin_contact_path, class: "bg-navy text-white px-4 py-2 rounded hover:bg-navy/90" %>
  </div>

  <% tabs = [
       [nil, t("admin.contacts.filters.all"), @counts[:all]],
       ["contacts", t("admin.contacts.filters.contacts"), @counts[:contacts]],
       ["peers", t("admin.contacts.filters.peers"), @counts[:peers]]
     ] %>

  <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
    <nav class="inline-flex rounded-lg border border-gray-200 bg-white p-1 text-sm">
      <% tabs.each do |value, label, count| %>
        <% active = @filter == value %>
        <%= link_to admin_contacts_path({ filter: value, q: @query }.compact_blank),
              data: { turbo_frame: "_top" },
              class: "px-3 py-1.5 rounded-md inline-flex items-center gap-1.5 #{active ? "bg-navy text-white" : "text-gray-600 hover:text-navy"}" do %>
          <%= label %>
          <span class="text-xs <%= active ? "text-white/80" : "text-gray-400" %>"><%= count %></span>
        <% end %>
      <% end %>
    </nav>

    <%= form_with url: admin_contacts_path, method: :get, data: { turbo_frame: "_top" }, class: "relative w-full sm:w-80" do |f| %>
      <%= f.hidden_field :filter, value: @filter %>
      <%= f.search_field :q, value: @query, placeholder: t("admin.contacts.search_placeholder"),
            class: "w-full rounded-lg border border-gray-300 bg-gray-50 pl-10 pr-3 py-2.5 text-sm shadow-sm placeholder:text-gray-400 focus:bg-white focus:border-navy focus:ring-2 focus:ring-navy/30" %>
      <svg class="absolute left-3 top-3 h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
      </svg>
    <% end %>
  </div>

  <%= turbo_frame_tag "contacts_table" do %>
    <% url = admin_contacts_path %>
    <% frame = "contacts_table" %>
    <div class="bg-white rounded shadow overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-100 text-left text-xs uppercase tracking-wider border-b-2 border-gray-200">
          <tr>
            <th class="px-4 py-3 font-semibold text-gray-700"><%= sort_link "last_name", t("admin.contacts.table.last_name"), url: url, frame: frame %></th>
            <th class="px-4 py-3 font-semibold text-gray-700"><%= sort_link "first_name", t("admin.contacts.table.first_name"), url: url, frame: frame %></th>
            <th class="px-4 py-3 font-semibold text-gray-700"><%= sort_link "company", t("admin.contacts.table.company"), url: url, frame: frame %></th>
            <th class="px-4 py-3 font-semibold text-gray-700"><%= sort_link "email", t("admin.contacts.table.email"), url: url, frame: frame %></th>
            <th class="px-4 py-3 font-semibold text-gray-700"><%= sort_link "phone", t("admin.contacts.table.phone"), url: url, frame: frame %></th>
            <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.contacts.table.type") %></th>
            <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.shared.actions") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @contacts.each do |contact| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 font-medium"><%= contact.last_name %></td>
              <td class="px-4 py-3"><%= contact.first_name %></td>
              <td class="px-4 py-3 text-gray-500"><%= contact.company %></td>
              <td class="px-4 py-3 text-gray-500"><%= contact.email %></td>
              <td class="px-4 py-3 text-gray-500"><%= contact.phone %></td>
              <td class="px-4 py-3">
                <% if contact.peer %>
                  <span class="inline-block rounded-full bg-accent/10 text-accent text-xs px-2 py-0.5"><%= t("admin.contacts.filters.peer_badge") %></span>
                <% else %>
                  <span class="inline-block rounded-full bg-gray-100 text-gray-500 text-xs px-2 py-0.5"><%= t("admin.contacts.filters.contact_badge") %></span>
                <% end %>
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-1">
                  <%= admin_action_link t("admin.shared.edit"), edit_admin_contact_path(contact), icon: :pencil, data: { turbo_frame: "_top" } %>
                  <%= admin_action_link t("admin.shared.delete"), admin_contact_path(contact), icon: :trash, variant: :danger, data: { turbo_method: :delete, turbo_confirm: t("admin.shared.confirm_delete"), turbo_frame: "_top" } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
