<div class="p-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-[#090956]">Contacts</h1>
    <%= link_to "New Contact", new_admin_contact_path, class: "bg-[#090956] text-white px-4 py-2 rounded hover:bg-[#090956]/90" %>
  </div>

  <div class="bg-white rounded shadow overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left">
        <tr>
          <th class="px-4 py-3 font-medium text-gray-600">Last Name</th>
          <th class="px-4 py-3 font-medium text-gray-600">First Name</th>
          <th class="px-4 py-3 font-medium text-gray-600">Email</th>
          <th class="px-4 py-3 font-medium text-gray-600">Phone</th>
          <th class="px-4 py-3 font-medium text-gray-600">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @contacts.each do |contact| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 font-medium"><%= contact.last_name %></td>
            <td class="px-4 py-3"><%= contact.first_name %></td>
            <td class="px-4 py-3 text-gray-500"><%= contact.email %></td>
            <td class="px-4 py-3 text-gray-500"><%= contact.phone %></td>
            <td class="px-4 py-3 space-x-2">
              <%= link_to "Edit", edit_admin_contact_path(contact), class: "text-[#6E8297] hover:underline" %>
              <%= link_to "Delete", admin_contact_path(contact), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-red-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
