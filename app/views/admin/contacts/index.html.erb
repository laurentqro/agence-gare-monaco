<div class="p-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="heading-page"><%= t("admin.contacts.title") %></h1>
    <%= link_to t("admin.contacts.new_action"), new_admin_contact_path, class: "bg-navy text-white px-4 py-2 rounded hover:bg-navy/90" %>
  </div>

  <div class="bg-white rounded shadow overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left">
        <tr>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.contacts.table.last_name") %></th>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.contacts.table.first_name") %></th>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.contacts.table.company") %></th>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.contacts.table.email") %></th>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.contacts.table.phone") %></th>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.shared.actions") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @contacts.each do |contact| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 font-medium"><%= contact.last_name %></td>
            <td class="px-4 py-3"><%= contact.first_name %></td>
            <td class="px-4 py-3 text-gray-500"><%= contact.company %></td>
            <td class="px-4 py-3 text-gray-500"><%= contact.email %></td>
            <td class="px-4 py-3 text-gray-500"><%= contact.phone %></td>
            <td class="px-4 py-3 space-x-2">
              <%= link_to t("admin.shared.edit"), edit_admin_contact_path(contact), class: "text-accent hover:underline" %>
              <%= link_to t("admin.shared.delete"), admin_contact_path(contact), data: { turbo_method: :delete, turbo_confirm: t("admin.shared.confirm_delete") }, class: "text-red-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
