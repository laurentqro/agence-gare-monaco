<%# One stacked audience section (peers or contacts): heading, its own search,
    a live "selected recipients" chip panel, and the scrollable checkbox table.
    Shared by the compose-email and property-share pages. Locals: audience,
    frame, heading, selected_target, selected_label, query, query_param,
    recipients, url (where this section's search form submits) and form_id (the
    page's outer form the checkboxes attach to via the form: attribute; they
    cannot be wrapped by it because this section carries its own search <form>
    and forms may not nest). The recipient-selection Stimulus controller (which
    wraps both sections) reads the checkboxes and renders the chip panel. %>
<section class="mb-8">
  <h2 class="text-lg font-semibold text-navy uppercase tracking-wide mb-4"><%= heading %></h2>

  <%# The search form targets THIS section's frame only, so searching one list
      never re-renders or clears the other. It lives inside the frame so a search
      re-render brings back the same form pre-filled with the current term. %>
  <%= turbo_frame_tag frame do %>
    <%= form_with url: url, method: :get, data: { turbo_frame: frame }, class: "relative w-full sm:w-96 mb-4" do |sf| %>
      <%= sf.search_field query_param, value: query, placeholder: t("admin.recipient_picker.search_placeholder"),
            class: "w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm shadow-sm focus:bg-white focus:border-navy focus:ring-2 focus:ring-navy/30" %>
    <% end %>

    <% if recipients.any? %>
      <div class="overflow-x-auto overflow-y-scroll max-h-80 border border-gray-200 rounded">
        <table class="w-full text-sm">
          <thead class="sticky top-0 z-10 bg-gray-100 text-left text-xs uppercase tracking-wider border-b-2 border-gray-200">
            <tr>
              <th class="px-3 py-2 w-10">
                <input type="checkbox" data-recipient-selection-target="all"
                       data-action="change->recipient-selection#toggleAll"
                       data-audience="<%= audience %>"
                       aria-label="<%= t("admin.recipient_picker.select_all") %>"
                       class="rounded border-gray-300 text-navy focus:ring-navy">
              </th>
              <th class="px-3 py-2 font-semibold text-gray-700"><%= t("admin.contacts.table.last_name") %></th>
              <th class="px-3 py-2 font-semibold text-gray-700"><%= t("admin.contacts.table.email") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% recipients.each do |contact| %>
              <tr class="hover:bg-gray-50">
                <td class="px-3 py-2 w-10">
                  <%# data-recipient-name travels with the checkbox so the JS can
                      label the removable chip even for rows scrolled out of view
                      or filtered away by a search. %>
                  <%# checked survives a validation re-render (the controller
                      passes back the submitted ids); the JS reseeds its chip
                      state from these boxes on connect. %>
                  <input type="checkbox" name="contact_ids[]" value="<%= contact.id %>" form="<%= form_id %>"
                         <%= "checked".html_safe if selected_ids.include?(contact.id.to_s) %>
                         data-recipient-selection-target="item"
                         data-audience="<%= audience %>"
                         data-recipient-name="<%= contact.listing_name %>"
                         class="rounded border-gray-300 text-navy focus:ring-navy">
                </td>
                <td class="px-3 py-2 font-medium" data-recipient-name>
                  <%= contact.listing_name %>
                </td>
                <td class="px-3 py-2 text-gray-500"><%= contact.email %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-gray-500 text-sm"><%= t("admin.recipient_picker.no_results") %></p>
    <% end %>
  <% end %>

  <%# Live "selected" panel: the controller fills it with a removable chip per
      checked recipient of THIS audience. Rendered after the frame so it is not
      swapped away by a search re-render (it reflects the persistent selection,
      not the currently-listed rows). %>
  <div class="mt-4 rounded-lg border border-gray-200 bg-gray-50 p-4">
    <p class="text-sm font-semibold text-navy mb-2"><%= selected_label %></p>
    <div class="flex flex-wrap gap-2 empty:after:content-[attr(data-empty-text)] empty:after:text-sm empty:after:text-gray-400"
         data-recipient-selection-target="<%= selected_target %>"
         data-audience="<%= audience %>"
         data-empty-text="<%= t("admin.recipient_picker.selected.none") %>"></div>
  </div>
</section>
