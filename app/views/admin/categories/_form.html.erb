<%= form_with(model: [:admin, category], class: "max-w-lg space-y-4") do |f| %>
  <% if category.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-400 p-4">
      <p class="text-red-700 font-medium"><%= t("admin.shared.errors", count: category.errors.count) %></p>
      <ul class="mt-2 text-sm text-red-600 list-disc list-inside">
        <% category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("admin.categories.form.name") %></label>
    <%= f.text_field :name, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]" %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1"><%= t("admin.categories.form.slug") %></label>
    <%= f.text_field :slug, placeholder: t("admin.categories.form.slug_placeholder"), class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]" %>
  </div>

  <div class="flex gap-3">
    <%= f.submit category.persisted? ? t("admin.categories.form.update") : t("admin.categories.form.create"),
                 class: "bg-[#090956] text-white px-4 py-2 rounded hover:bg-[#090956]/90 cursor-pointer" %>
    <%= link_to t("admin.shared.cancel"), admin_categories_path, class: "px-4 py-2 border border-gray-300 rounded text-gray-700 hover:bg-gray-50" %>
  </div>
<% end %>
