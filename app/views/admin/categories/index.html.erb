<div class="p-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-[#090956]">Categories</h1>
    <%= link_to "New Category", new_admin_category_path, class: "bg-[#090956] text-white px-4 py-2 rounded hover:bg-[#090956]/90" %>
  </div>

  <div class="bg-white rounded shadow overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left">
        <tr>
          <th class="px-4 py-3 font-medium text-gray-600">Name</th>
          <th class="px-4 py-3 font-medium text-gray-600">Slug</th>
          <th class="px-4 py-3 font-medium text-gray-600">Articles</th>
          <th class="px-4 py-3 font-medium text-gray-600">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @categories.each do |category| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 font-medium"><%= category.name %></td>
            <td class="px-4 py-3 text-gray-500"><%= category.slug %></td>
            <td class="px-4 py-3"><%= category.articles_count %></td>
            <td class="px-4 py-3 space-x-2">
              <%= link_to "Edit", edit_admin_category_path(category), class: "text-[#6E8297] hover:underline" %>
              <%= link_to "Delete", admin_category_path(category), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-red-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
