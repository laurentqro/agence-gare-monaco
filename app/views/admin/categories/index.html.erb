<div class="p-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="heading-page"><%= t("admin.categories.title") %></h1>
    <%= link_to t("admin.categories.new_action"), new_admin_category_path, class: "bg-navy text-white px-4 py-2 rounded hover:bg-navy/90" %>
  </div>

  <div class="bg-white rounded shadow overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-100 text-left text-xs uppercase tracking-wider border-b-2 border-gray-200">
        <tr>
          <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.categories.table.name") %></th>
          <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.categories.table.slug") %></th>
          <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.categories.table.articles") %></th>
          <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.shared.actions") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @categories.each do |category| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 font-medium"><%= category.name_for(:fr) %></td>
            <td class="px-4 py-3 text-gray-500"><%= category.slug %></td>
            <td class="px-4 py-3"><%= category.articles_count %></td>
            <td class="px-4 py-3">
              <div class="flex items-center gap-1">
                <%= admin_action_link t("admin.shared.edit"), edit_admin_category_path(category), icon: :pencil %>
                <%= admin_action_link t("admin.shared.delete"), admin_category_path(category), icon: :trash, variant: :danger, data: { turbo_method: :delete, turbo_confirm: t("admin.shared.confirm_delete") } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
