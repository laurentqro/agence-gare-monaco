<div class="p-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-navy"><%= t("admin.categories.title") %></h1>
    <%= link_to t("admin.categories.new_action"), new_admin_category_path, class: "bg-navy text-white px-4 py-2 rounded hover:bg-navy/90" %>
  </div>

  <div class="bg-white rounded shadow overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left">
        <tr>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.categories.table.name") %></th>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.categories.table.slug") %></th>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.categories.table.articles") %></th>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.shared.actions") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @categories.each do |category| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 font-medium"><%= category.name_for(:fr) %></td>
            <td class="px-4 py-3 text-gray-500"><%= category.slug %></td>
            <td class="px-4 py-3"><%= category.articles_count %></td>
            <td class="px-4 py-3 space-x-2">
              <%= link_to t("admin.shared.edit"), edit_admin_category_path(category), class: "text-accent hover:underline" %>
              <%= link_to t("admin.shared.delete"), admin_category_path(category), data: { turbo_method: :delete, turbo_confirm: t("admin.shared.confirm_delete") }, class: "text-red-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
