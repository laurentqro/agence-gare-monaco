<%= form_with(model: [:admin, property], class: "space-y-6") do |f| %>
  <% if property.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-400 p-4">
      <p class="text-red-700 font-medium"><%= pluralize(property.errors.count, "error") %> prevented this property from being saved:</p>
      <ul class="mt-2 text-sm text-red-600 list-disc list-inside">
        <% property.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Main content column %>
    <div class="lg:col-span-2 space-y-6">
      <%# Core details %>
      <fieldset class="bg-white rounded shadow p-6">
        <legend class="text-lg font-semibold text-[#090956] mb-4">Details</legend>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Reference</label>
            <input type="text" name="property[reference]" value="<%= property.reference %>"
                   class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Price (€)</label>
            <input type="number" name="property[price]" value="<%= property.price %>"
                   class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Transaction Type</label>
            <select name="property[transaction_type]" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
              <option value="">Select...</option>
              <option value="sale" <%= "selected" if property.transaction_type == "sale" %>>Sale</option>
              <option value="rental" <%= "selected" if property.transaction_type == "rental" %>>Rental</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Property Type</label>
            <select name="property[property_type]" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
              <option value="">Select...</option>
              <% %w[studio apartment penthouse villa house office commercial parking cellar].each do |type| %>
                <option value="<%= type %>" <%= "selected" if property.property_type == type %>><%= type.capitalize %></option>
              <% end %>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Subtype</label>
            <input type="text" name="property[subtype]" value="<%= property.subtype %>"
                   class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Floor</label>
            <input type="number" name="property[floor]" value="<%= property.floor %>"
                   class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
          </div>
        </div>
      </fieldset>

      <%# Location %>
      <fieldset class="bg-white rounded shadow p-6">
        <legend class="text-lg font-semibold text-[#090956] mb-4">Location</legend>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Country</label>
            <select name="property[country]" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
              <option value="">Select...</option>
              <option value="MC" <%= "selected" if property.country == "MC" %>>Monaco</option>
              <option value="FR" <%= "selected" if property.country == "FR" %>>France</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">City</label>
            <input type="text" name="property[city]" value="<%= property.city %>"
                   class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">District</label>
            <%= f.select :district_id, @districts.map { |d| [d.name, d.id] },
                         { include_blank: "None" },
                         class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]" %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Building</label>
            <%= f.select :building_id, @buildings.map { |b| [b.name, b.id] },
                         { include_blank: "None" },
                         class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]" %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Address</label>
            <input type="text" name="property[address]" value="<%= property.address %>"
                   class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
          </div>
        </div>
      </fieldset>

      <%# Dimensions %>
      <fieldset class="bg-white rounded shadow p-6">
        <legend class="text-lg font-semibold text-[#090956] mb-4">Dimensions & Rooms</legend>
        <div class="grid grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Rooms</label>
            <input type="number" name="property[num_rooms]" value="<%= property.num_rooms %>"
                   class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Bedrooms</label>
            <input type="number" name="property[num_bedrooms]" value="<%= property.num_bedrooms %>"
                   class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Bathrooms</label>
            <input type="number" name="property[num_bathrooms]" value="<%= property.num_bathrooms %>"
                   class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Parkings</label>
            <input type="number" name="property[num_parkings]" value="<%= property.num_parkings %>"
                   class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Cellars</label>
            <input type="number" name="property[num_cellars]" value="<%= property.num_cellars %>"
                   class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Living Area (m²)</label>
            <input type="number" step="0.01" name="property[living_area]" value="<%= property.living_area %>"
                   class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Total Area (m²)</label>
            <input type="number" step="0.01" name="property[total_area]" value="<%= property.total_area %>"
                   class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Terrace Area (m²)</label>
            <input type="number" step="0.01" name="property[terrace_area]" value="<%= property.terrace_area %>"
                   class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Land Area (m²)</label>
            <input type="number" step="0.01" name="property[land_area]" value="<%= property.land_area %>"
                   class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Garden Area (m²)</label>
            <input type="number" step="0.01" name="property[garden_area]" value="<%= property.garden_area %>"
                   class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
          </div>
        </div>
      </fieldset>

      <%# Multilingual titles %>
      <fieldset class="bg-white rounded shadow p-6">
        <legend class="text-lg font-semibold text-[#090956] mb-4">Title</legend>
        <div class="space-y-4">
          <% I18n.available_locales.each do |locale| %>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"><%= locale.to_s.upcase %></label>
              <input type="text" name="property[title][<%= locale %>]" value="<%= property.title&.dig(locale.to_s) %>"
                     class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
            </div>
          <% end %>
        </div>
      </fieldset>

      <%# Multilingual descriptions %>
      <fieldset class="bg-white rounded shadow p-6">
        <legend class="text-lg font-semibold text-[#090956] mb-4">Description</legend>
        <div class="space-y-4">
          <% I18n.available_locales.each do |locale| %>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1"><%= locale.to_s.upcase %></label>
              <textarea name="property[description][<%= locale %>]" rows="6"
                        class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]"><%= property.description&.dig(locale.to_s) %></textarea>
            </div>
          <% end %>
        </div>
      </fieldset>

      <%# Media %>
      <fieldset class="bg-white rounded shadow p-6">
        <legend class="text-lg font-semibold text-[#090956] mb-4">Media</legend>
        <div class="grid grid-cols-2 gap-4">
          <div class="col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">Video URL</label>
            <input type="url" name="property[video_url]" value="<%= property.video_url %>"
                   class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
          </div>
          <div class="col-span-2">
            <label class="block text-sm font-medium text-gray-700 mb-1">Virtual Tour URL</label>
            <input type="url" name="property[virtual_tour_url]" value="<%= property.virtual_tour_url %>"
                   class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
          </div>
          <div class="flex items-center gap-2">
            <%= f.check_box :has_360_tour, class: "rounded border-gray-300 text-[#090956] focus:ring-[#090956]" %>
            <label class="text-sm font-medium text-gray-700">360° Tour</label>
          </div>
        </div>
      </fieldset>
    </div>

    <%# Sidebar column %>
    <div class="space-y-6">
      <div class="bg-white rounded shadow p-6 space-y-4">
        <div class="flex items-center gap-2">
          <%= f.check_box :published, class: "rounded border-gray-300 text-[#090956] focus:ring-[#090956]" %>
          <label class="text-sm font-medium text-gray-700">Published</label>
        </div>

        <div class="flex items-center gap-2">
          <%= f.check_box :featured, class: "rounded border-gray-300 text-[#090956] focus:ring-[#090956]" %>
          <label class="text-sm font-medium text-gray-700">Featured</label>
        </div>

        <div class="flex items-center gap-2">
          <%= f.check_box :off_market, class: "rounded border-gray-300 text-[#090956] focus:ring-[#090956]" %>
          <label class="text-sm font-medium text-gray-700">Off-market</label>
        </div>

        <div class="flex items-center gap-2">
          <%= f.check_box :exclusivity, class: "rounded border-gray-300 text-[#090956] focus:ring-[#090956]" %>
          <label class="text-sm font-medium text-gray-700">Exclusivity</label>
        </div>

        <div class="flex items-center gap-2">
          <%= f.check_box :furnished, class: "rounded border-gray-300 text-[#090956] focus:ring-[#090956]" %>
          <label class="text-sm font-medium text-gray-700">Furnished</label>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Service Charges (€)</label>
          <input type="number" name="property[service_charges]" value="<%= property.service_charges %>"
                 class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-[#090956] focus:border-[#090956]">
        </div>

        <div class="flex items-center gap-2">
          <%= f.check_box :service_charges_included, class: "rounded border-gray-300 text-[#090956] focus:ring-[#090956]" %>
          <label class="text-sm font-medium text-gray-700">Service charges included</label>
        </div>

        <% if property.immotoolbox_id.present? %>
          <div class="mt-4 p-3 bg-blue-50 rounded text-sm text-blue-700">
            Synced from Immotoolbox (ID: <%= property.immotoolbox_id %>)
            <% if property.manually_edited? %>
              <br><span class="font-medium">Manually edited</span>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="flex gap-3">
        <%= f.submit property.persisted? ? "Update Property" : "Create Property",
                     class: "bg-[#090956] text-white px-4 py-2 rounded hover:bg-[#090956]/90 cursor-pointer" %>
        <%= link_to "Cancel", admin_properties_path, class: "px-4 py-2 border border-gray-300 rounded text-gray-700 hover:bg-gray-50" %>
      </div>
    </div>
  </div>
<% end %>
