<div class="p-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-[#090956]"><%= t("admin.properties.title") %></h1>
    <%= link_to t("admin.properties.new_action"), new_admin_property_path, class: "bg-[#090956] text-white px-4 py-2 rounded hover:bg-[#090956]/90" %>
  </div>

  <div class="bg-white rounded shadow overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left">
        <tr>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.properties.table.reference") %></th>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.properties.table.title") %></th>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.properties.table.type") %></th>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.properties.table.price") %></th>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.properties.table.status") %></th>
          <th class="px-4 py-3 font-medium text-gray-600"><%= t("admin.shared.actions") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @properties.each do |property| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 font-mono text-xs"><%= property.reference %></td>
            <td class="px-4 py-3"><%= property.title_for(:fr) %></td>
            <td class="px-4 py-3 capitalize"><%= property.transaction_type %> · <%= property.property_type %></td>
            <td class="px-4 py-3"><%= property.formatted_price ? "#{property.formatted_price} €" : "—" %></td>
            <td class="px-4 py-3">
              <% if property.published? %>
                <span class="inline-block px-2 py-1 text-xs font-medium bg-green-100 text-green-700 rounded"><%= t("admin.properties.published") %></span>
              <% else %>
                <span class="inline-block px-2 py-1 text-xs font-medium bg-gray-100 text-gray-600 rounded"><%= t("admin.properties.draft") %></span>
              <% end %>
              <% if property.featured? %>
                <span class="inline-block px-2 py-1 text-xs font-medium bg-yellow-100 text-yellow-700 rounded ml-1"><%= t("admin.properties.featured") %></span>
              <% end %>
              <% if property.off_market? %>
                <span class="inline-block px-2 py-1 text-xs font-medium bg-purple-100 text-purple-700 rounded ml-1"><%= t("admin.properties.off_market") %></span>
              <% end %>
            </td>
            <td class="px-4 py-3 space-x-2">
              <%= link_to t("admin.shared.edit"), edit_admin_property_path(property), class: "text-[#6E8297] hover:underline" %>
              <%= link_to t("admin.properties.share"), new_admin_property_share_path(property), class: "text-[#6E8297] hover:underline" %>
              <%= link_to t("admin.shared.delete"), admin_property_path(property), data: { turbo_method: :delete, turbo_confirm: t("admin.shared.confirm_delete") }, class: "text-red-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
