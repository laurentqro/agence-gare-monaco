<div class="p-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="heading-page"><%= t("admin.properties.title") %></h1>
    <%= link_to t("admin.properties.new_action"), new_admin_property_path, class: "bg-navy text-white px-4 py-2 rounded hover:bg-navy/90" %>
  </div>

  <div class="flex gap-2 mb-4">
    <%= link_to t("admin.properties.filter_all"), admin_properties_path,
        class: "px-3 py-1.5 text-sm rounded #{params[:filter].blank? ? 'bg-navy text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
    <%= link_to t("admin.properties.filter_off_market"), admin_properties_path(filter: "off_market"),
        class: "px-3 py-1.5 text-sm rounded #{params[:filter] == 'off_market' ? 'bg-purple-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
  </div>

  <div class="bg-white rounded-lg shadow-sm ring-1 ring-gray-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-100 text-left text-xs uppercase tracking-wider border-b-2 border-gray-200">
        <tr>
          <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.properties.table.title") %></th>
          <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.properties.table.type") %></th>
          <th class="px-4 py-3 font-semibold text-gray-700 text-right"><%= t("admin.properties.table.price") %></th>
          <th class="px-4 py-3 font-semibold text-gray-700"><%= t("admin.properties.table.status") %></th>
          <th class="px-4 py-3 font-semibold text-gray-700 text-right"><%= t("admin.shared.actions") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @properties.each do |property| %>
          <tr class="hover:bg-navy/[0.03] transition-colors">
            <td class="px-4 py-3 align-middle">
              <div class="font-medium text-navy leading-snug max-w-md"><%= property.title_for(:fr) %></div>
              <div class="font-mono text-xs text-gray-400 mt-0.5"><%= property.reference %></div>
            </td>
            <td class="px-4 py-3 align-middle whitespace-nowrap">
              <% transaction_classes = property.transaction_type.to_s == "rental" ? "bg-amber-50 text-amber-700" : "bg-sky-50 text-sky-700" %>
              <span class="inline-block rounded px-1.5 py-0.5 text-xs font-medium <%= transaction_classes %>"><%= admin_transaction_label(property) %></span>
              <div class="text-gray-500 text-xs mt-1"><%= admin_property_type_only_label(property) %></div>
            </td>
            <td class="px-4 py-3 align-middle text-right font-semibold text-gray-800 tabular-nums whitespace-nowrap">
              <%= property.formatted_price ? "#{property.formatted_price} €" : "—" %>
            </td>
            <td class="px-4 py-3 align-middle">
              <div class="flex flex-wrap items-center gap-1">
                <% if property.published? %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded-full"><span class="h-1.5 w-1.5 rounded-full bg-green-500"></span><%= t("admin.properties.published") %></span>
                <% else %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium bg-gray-100 text-gray-600 rounded-full"><span class="h-1.5 w-1.5 rounded-full bg-gray-400"></span><%= t("admin.properties.draft") %></span>
                <% end %>
                <% if property.featured? %>
                  <span class="inline-block px-2 py-0.5 text-xs font-medium bg-yellow-100 text-yellow-700 rounded-full"><%= t("admin.properties.featured") %></span>
                <% end %>
                <% if property.off_market? %>
                  <span class="inline-block px-2 py-0.5 text-xs font-medium bg-purple-100 text-purple-700 rounded-full"><%= t("admin.properties.off_market") %></span>
                <% end %>
              </div>
            </td>
            <td class="px-4 py-3 align-middle">
              <div class="flex items-center justify-end gap-0.5">
                <% if property.immotoolbox_id.present? %>
                  <%= admin_action_link t("admin.shared.view"), admin_property_path(property), icon: :eye %>
                <% else %>
                  <%= admin_action_link t("admin.shared.edit"), edit_admin_property_path(property), icon: :pencil %>
                <% end %>
                <%= admin_action_link t("admin.property_brochures.pdf"), new_admin_property_brochure_path(property), icon: :document %>
                <%= admin_action_link t("admin.properties.share"), new_admin_property_share_path(property), icon: :share %>
                <% if property.immotoolbox_id.blank? %>
                  <%= admin_action_link t("admin.shared.delete"), admin_property_path(property), icon: :trash, variant: :danger, data: { turbo_method: :delete, turbo_confirm: t("admin.shared.confirm_delete") } %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
