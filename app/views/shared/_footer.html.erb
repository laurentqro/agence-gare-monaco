<footer class="bg-navy pt-14 pb-6">
  <div class="max-w-7xl mx-auto px-4">
    <%# Three-column grid %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-16 pb-10 border-b border-white/10">

      <%# Brand column %>
      <div>
        <a href="<%= locale_root_path %>" class="inline-block mb-4">
          <%= image_tag "logo.png", alt: "Agence Immobilière de la Gare", class: "h-10 brightness-0 invert" %>
        </a>
        <p class="text-white/50 text-xs leading-relaxed mb-6"><%= t("footer.tagline", default: "Votre partenaire immobilier à Monaco depuis 1942.") %></p>

        <div class="flex items-center gap-3">
          <a href="https://www.linkedin.com/company/agence-de-la-gare-monaco" class="text-white/40 hover:text-white transition-colors" title="LinkedIn" target="_blank" rel="noopener noreferrer">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://www.facebook.com/agencedelagaremonaco" class="text-white/40 hover:text-white transition-colors" title="Facebook" target="_blank" rel="noopener noreferrer">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://www.instagram.com/agencedelagaremonaco" class="text-white/40 hover:text-white transition-colors" title="Instagram" target="_blank" rel="noopener noreferrer">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="https://www.youtube.com/channel/UC2w6AJOPj37wDZxXjWLRxtg" class="text-white/40 hover:text-white transition-colors" title="YouTube" target="_blank" rel="noopener noreferrer">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
        <div class="mt-10">
          <%= image_tag "logo-cim.svg", alt: "Membre de la Chambre Immobilière Monégasque", class: "h-28" %>
        </div>
      </div>

      <%# Navigation column %>
      <div>
        <h3 class="text-white font-semibold text-xs uppercase tracking-wider mb-4"><%= t("footer.navigation", default: "Navigation") %></h3>
        <ul class="space-y-2.5">
          <li><a href="<%= locale_sales_monaco_path %>" class="text-white/50 hover:text-white text-xs transition-colors"><%= t("nav.buy") %></a></li>
          <li><a href="<%= locale_rentals_monaco_path %>" class="text-white/50 hover:text-white text-xs transition-colors"><%= t("nav.rent") %></a></li>
          <li><a href="<%= locale_offmarket_path %>" class="text-white/50 hover:text-white text-xs transition-colors"><%= t("nav.offmarket") %></a></li>
          <li><a href="<%= locale_contact_path %>" class="text-white/50 hover:text-white text-xs transition-colors"><%= t("nav.sell") %></a></li>
          <li><a href="<%= locale_contact_path %>" class="text-white/50 hover:text-white text-xs transition-colors"><%= t("nav.management") %></a></li>
          <li><a href="<%= locale_articles_path %>" class="text-white/50 hover:text-white text-xs transition-colors"><%= t("nav.articles") %></a></li>
        </ul>
      </div>

      <%# Contact column %>
      <div>
        <h3 class="text-white font-semibold text-xs uppercase tracking-wider mb-4">Contact</h3>
        <address class="not-italic space-y-3 text-xs text-white/50 leading-relaxed">
          <p>3, Rue Langl&eacute;<br>MC 98000 Monaco</p>
          <p>
            <a href="tel:+37793302236" class="hover:text-white transition-colors">(+377) 93 30 22 36</a>
          </p>
          <p>
            <a href="mailto:info@agencegaremonaco.com" class="hover:text-white transition-colors">info@agencegaremonaco.com</a>
          </p>
        </address>
        <a href="<%= locale_contact_path %>" class="inline-block mt-5 bg-gold text-white text-xs font-medium uppercase tracking-wide px-5 py-2.5 rounded hover:bg-gold/85 transition-colors"><%= t("nav.contact") %></a>
      </div>
    </div>

    <%# Bottom bar %>
    <div class="flex flex-col sm:flex-row items-center justify-between gap-2 pt-6">
      <p class="text-[11px] text-white/30">&copy; <%= Date.current.year %> Agence de la Gare.</p>
      <a href="<%= locale_privacy_path %>" class="text-[11px] text-white/30 hover:text-white/60 transition-colors">
        <%= t("nav.privacy", default: "Privacy") %>
      </a>
    </div>
  </div>
</footer>
