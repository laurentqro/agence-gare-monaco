<%# Featured (latest) article — full width, horizontal layout %>
<% article = local_assigns[:article] %>
<% article_path = local_assigns[:article_path] %>
<a href="<%= article_path %>" class="article-card-featured group block bg-white rounded-lg shadow hover:shadow-lg hover:-translate-y-1 transition-all duration-300 mb-8 overflow-hidden md:grid md:grid-cols-2">
  <% if article.cover_image_display_url.present? %>
    <div class="relative aspect-[16/10] md:aspect-auto overflow-hidden">
      <img src="<%= article.cover_image_display_url %>" alt="<%= article.title_for(I18n.locale) %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" loading="lazy">
      <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
      <span class="article-category-badge absolute top-4 left-4 px-3 py-1 text-xs font-semibold rounded bg-navy/90 text-white backdrop-blur-sm">
        <%= article.category.name_for %>
      </span>
    </div>
  <% end %>
  <div class="p-6 md:p-8 flex flex-col justify-center">
    <% unless article.cover_image_display_url.present? %>
      <span class="article-category-badge inline-block mb-3 px-3 py-1 text-xs font-semibold rounded bg-navy/90 text-white w-fit">
        <%= article.category.name_for %>
      </span>
    <% end %>
    <h2 class="article-title text-2xl md:text-3xl font-bold text-navy group-hover:text-accent transition-colors">
      <%= article.title_for(I18n.locale) %>
    </h2>
    <% if article.body_for(I18n.locale).present? %>
      <p class="mt-3 text-sm text-gray-600 line-clamp-3"><%= strip_tags(article.body_for(I18n.locale)).truncate(180) %></p>
    <% end %>
    <p class="article-meta mt-4 text-xs text-accent">
      <% if article.published_at %>
        <time datetime="<%= article.published_at.iso8601 %>"><%= I18n.l(article.published_at.to_date, format: :long) %></time>
      <% end %>
    </p>
  </div>
</a>
