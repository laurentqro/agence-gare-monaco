      <div class="flex items-center gap-3 mt-2">
        <a href="<%= locale_contact_path %>" class="inline-block bg-gold text-white text-xs font-medium uppercase tracking-wide px-4 py-2 rounded hover:bg-gold/85 transition-colors">
