            <% end %>
          </div>
          </div>
        </div>
      </div>

      <%# Mobile Menu Button %>
      <button data-action="mobile-menu#toggle" class="lg:hidden text-navy p-2" aria-label="Menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
