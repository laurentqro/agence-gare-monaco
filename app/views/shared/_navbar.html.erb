<% homepage = local_assigns.fetch(:homepage, false) %>
<nav class="fixed top-0 left-0 right-0 z-50 bg-white shadow" data-controller="mobile-menu">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center justify-between h-24">
      <%# Logo %>
      <a href="<%= locale_root_path %>" class="flex-shrink-0">
        <%= image_tag "logo.png", alt: "Agence Immobilière de la Gare", class: "h-16" %>
      </a>

      <%# Desktop Navigation %>
      <div class="hidden lg:flex items-center space-x-6">
        <a href="<%= locale_sales_monaco_path %>" class="text-navy hover:text-accent text-sm font-medium uppercase tracking-wide transition-colors <%= nav_active_class(locale_sales_monaco_path) %>">
          <%= t("nav.buy") %>
        </a>
        <a href="<%= locale_rentals_monaco_path %>" class="text-navy hover:text-accent text-sm font-medium uppercase tracking-wide transition-colors <%= nav_active_class(locale_rentals_monaco_path) %>">
          <%= t("nav.rent") %>
        </a>
        <a href="<%= locale_offmarket_path %>" class="text-navy hover:text-accent text-sm font-medium uppercase tracking-wide transition-colors <%= nav_active_class(locale_offmarket_path) %>">
          <%= t("nav.offmarket") %>
        </a>
        <a href="<%= locale_vendre_path %>" class="text-navy hover:text-accent text-sm font-medium uppercase tracking-wide transition-colors <%= nav_active_class(locale_vendre_path) %>">
          <%= t("nav.sell") %>
        </a>
        <a href="<%= locale_gestion_path %>" class="text-navy hover:text-accent text-sm font-medium uppercase tracking-wide transition-colors <%= nav_active_class(locale_gestion_path) %>">
          <%= t("nav.management") %>
        </a>
        <a href="<%= locale_articles_path %>" class="text-navy hover:text-accent text-sm font-medium uppercase tracking-wide transition-colors <%= nav_active_class(locale_articles_path) %>">
          <%= t("nav.articles") %>
        </a>
        <a href="<%= locale_contact_path %>" class="bg-gold text-white text-sm font-medium uppercase tracking-wide px-5 py-2.5 rounded hover:bg-gold/85 transition-colors">
          <%= t("nav.contact") %>
        </a>

        <%# Language Switcher (hover on desktop) %>
        <div data-controller="language-switcher" data-current-locale="<%= I18n.locale %>" class="relative"
             data-action="mouseenter->language-switcher#show mouseleave->language-switcher#hide">
          <button class="flex items-center text-navy hover:text-accent transition-colors">
            <%= image_tag "flags/#{flag_image_for(I18n.locale)}.svg", alt: locale_name_for(I18n.locale), class: "w-7 h-5 rounded-sm" %>
          </button>
          <div data-language-switcher-target="menu" class="absolute -left-4 pt-2 origin-top transition-all duration-200 ease-out opacity-0 scale-y-0 pointer-events-none">
          <div class="bg-white rounded py-1.5 min-w-[140px]">
            <% I18n.available_locales.each do |locale| %>
              <% next if locale == I18n.locale %>
              <a href="<%= switch_locale_path(locale) %>"
                 class="flex items-center px-4 py-2 text-sm text-dark hover:bg-gray-50">
                <%= image_tag "flags/#{flag_image_for(locale)}.svg", alt: locale_name_for(locale), class: "w-7 h-5 rounded-sm mr-2.5" %>
                <%= locale_name_for(locale) %>
              </a>
            <% end %>
          </div>
          </div>
        </div>
      </div>

      <%# Mobile Menu Button %>
      <button data-action="mobile-menu#toggle" class="lg:hidden text-navy p-2" aria-label="Menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path data-mobile-menu-target="openIcon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          <path data-mobile-menu-target="closeIcon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <%# Mobile Menu %>
  <div data-mobile-menu-target="menu" class="hidden lg:hidden bg-white border-t border-gray-200">
    <div class="px-4 py-3 space-y-2">
      <a href="<%= locale_sales_monaco_path %>" class="block text-navy hover:text-accent text-xs font-medium uppercase tracking-wide py-2 <%= nav_active_class(locale_sales_monaco_path) %>">
        <%= t("nav.buy") %>
      </a>
      <a href="<%= locale_rentals_monaco_path %>" class="block text-navy hover:text-accent text-xs font-medium uppercase tracking-wide py-2 <%= nav_active_class(locale_rentals_monaco_path) %>">
        <%= t("nav.rent") %>
      </a>
      <a href="<%= locale_offmarket_path %>" class="block text-navy hover:text-accent text-xs font-medium uppercase tracking-wide py-2 <%= nav_active_class(locale_offmarket_path) %>">
        <%= t("nav.offmarket") %>
      </a>
      <a href="<%= locale_vendre_path %>" class="block text-navy hover:text-accent text-xs font-medium uppercase tracking-wide py-2 <%= nav_active_class(locale_vendre_path) %>">
        <%= t("nav.sell") %>
      </a>
      <a href="<%= locale_gestion_path %>" class="block text-navy hover:text-accent text-xs font-medium uppercase tracking-wide py-2 <%= nav_active_class(locale_gestion_path) %>">
        <%= t("nav.management") %>
      </a>
      <a href="<%= locale_articles_path %>" class="block text-navy hover:text-accent text-xs font-medium uppercase tracking-wide py-2 <%= nav_active_class(locale_articles_path) %>">
        <%= t("nav.articles") %>
      </a>
      <a href="<%= locale_contact_path %>" class="inline-block bg-gold text-white text-xs font-medium uppercase tracking-wide px-4 py-2 rounded hover:bg-gold/85 transition-colors mt-2">
        <%= t("nav.contact") %>
      </a>

      <%# Mobile Language Switcher %>
      <div class="pt-2 border-t border-gray-200" data-controller="language-switcher" data-current-locale="<%= I18n.locale %>">
        <div class="flex flex-wrap gap-2">
          <% I18n.available_locales.each do |locale| %>
            <a href="<%= switch_locale_path(locale) %>"
               class="flex items-center px-2 py-1 rounded text-xs text-navy hover:bg-gray-100 <%= 'bg-gray-200' if locale == I18n.locale %>">
              <%= image_tag "flags/#{flag_image_for(locale)}.svg", alt: locale_name_for(locale), class: "w-5 h-4 rounded-sm" %>
            </a>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</nav>

<%# Spacer to push content below fixed navbar (not on homepage — hero is full-height) %>
<% unless homepage %>
  <div class="h-24"></div>
<% end %>
