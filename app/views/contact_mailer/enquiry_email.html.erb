<h2>New Property Enquiry</h2>

<table cellpadding="8" cellspacing="0" border="0" style="border-collapse: collapse; width: 100%; max-width: 600px;">
  <tr>
    <td style="font-weight: bold; color: #6E8297; vertical-align: top; width: 120px;">Name:</td>
    <td style="color: #212529;"><%= @submission.name %></td>
  </tr>
  <tr>
    <td style="font-weight: bold; color: #6E8297; vertical-align: top;">Email:</td>
    <td style="color: #212529;"><%= @submission.email %></td>
  </tr>
  <% if @submission.phone.present? %>
  <tr>
    <td style="font-weight: bold; color: #6E8297; vertical-align: top;">Phone:</td>
    <td style="color: #212529;"><%= @submission.phone %></td>
  </tr>
  <% end %>
  <% if @submission.country.present? %>
  <tr>
    <td style="font-weight: bold; color: #6E8297; vertical-align: top;">Country:</td>
    <td style="color: #212529;"><%= @submission.country %></td>
  </tr>
  <% end %>
  <tr>
    <td style="font-weight: bold; color: #6E8297; vertical-align: top;">Message:</td>
    <td style="color: #212529;"><%= simple_format(@submission.message) %></td>
  </tr>
</table>

<hr style="border: none; border-top: 1px solid #e5e7eb; margin: 20px 0;">

<h3 style="color: #090956;">Property Details</h3>

<table cellpadding="8" cellspacing="0" border="0" style="border-collapse: collapse; width: 100%; max-width: 600px;">
  <tr>
    <td style="font-weight: bold; color: #6E8297; vertical-align: top; width: 120px;">Reference:</td>
    <td style="color: #212529;"><%= @property.reference %></td>
  </tr>
  <tr>
    <td style="font-weight: bold; color: #6E8297; vertical-align: top;">Title:</td>
    <td style="color: #212529;"><%= @property.title_for(:fr) %></td>
  </tr>
  <% if @property.price.present? %>
  <tr>
    <td style="font-weight: bold; color: #6E8297; vertical-align: top;">Price:</td>
    <td style="color: #212529;"><%= @property.formatted_price %> €</td>
  </tr>
  <% end %>
</table>

<p style="margin-top: 20px;">
  <a href="<%= "https://agencegaremonaco.com/biens/#{@property.id}-#{@property.slug_for(:fr)}" %>"
     style="display: inline-block; background-color: #090956; color: #ffffff; padding: 10px 20px; text-decoration: none; border-radius: 4px; font-size: 14px;">
    View Property on Website
  </a>
</p>

<hr style="border: none; border-top: 1px solid #e5e7eb; margin: 20px 0;">
<p style="color: #6E8297; font-size: 12px;">
  This enquiry was sent via the property page on agencegaremonaco.com
</p>
