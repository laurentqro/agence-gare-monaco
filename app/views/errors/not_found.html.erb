<% content_for :title, "404 — Page not found | Agence Immobilière de la Gare" %>

<div class="flex-1 flex flex-col items-center justify-center px-4 py-16">
  <a href="/">
    <%= image_tag "logo.png", alt: "Agence Immobilière de la Gare", class: "h-12 mb-8" %>
  </a>

  <h1 class="text-6xl font-bold text-navy mb-4">404</h1>

  <p data-testid="error-message" class="text-sm text-accent mb-8 text-center max-w-md">
    The page you are looking for does not exist or has been moved.
  </p>

  <div class="flex flex-col sm:flex-row gap-4 items-center mb-10">
    <a href="/" class="bg-white border border-navy text-navy px-6 py-2 rounded text-xs font-semibold hover:bg-gray-50">
      Homepage
    </a>
    <a href="<%= locale_sales_path(:fr) %>" class="text-accent hover:text-navy text-xs underline">
      Browse properties in Monaco
    </a>
  </div>

  <section data-testid="where-to-look-next" class="text-xs text-accent text-center max-w-md">
    <h2 class="font-semibold text-navy mb-2">Where to look next</h2>
    <ul class="space-y-1">
      <li><a href="<%= locale_sales_path(:fr) %>" class="underline hover:text-navy">Properties for sale in Monaco</a> (<a href="<%= locale_sales_path(:en) %>" class="underline hover:text-navy">English</a>)</li>
      <li><a href="<%= locale_rentals_path(:fr) %>" class="underline hover:text-navy">Properties for rent in Monaco</a> (<a href="<%= locale_rentals_path(:en) %>" class="underline hover:text-navy">English</a>)</li>
      <li><a href="<%= locale_articles_path(:fr) %>" class="underline hover:text-navy">Articles and market news</a></li>
      <li><a href="<%= locale_about_path(:en) %>" class="underline hover:text-navy">About the agency</a></li>
      <li><a href="<%= locale_contact_path(:fr) %>" class="underline hover:text-navy">Contact the agency</a></li>
      <li><a href="/sitemap.xml" class="underline hover:text-navy">Sitemap</a> — every public URL, per language</li>
      <li><a href="/llms.txt" class="underline hover:text-navy">llms.txt</a> — site summary and usage guidance for AI agents</li>
    </ul>
  </section>
</div>
