<% districts = PropertyValuator::DISTRICT_NAMES.sort_by { |_, name| name }
   form_action = locale_estimate_path
   font_sans = "font-['Montserrat',ui-sans-serif,system-ui,sans-serif]"
   has_result = @result.present?
   district_key = t("estimate.param.district")
   surface_key = t("estimate.param.surface")
   year_key = t("estimate.param.construction_year") %>

<%# ============================================================================
    HERO + FORM — always rendered. The form sits above the result so the user
    can tweak any input and re-submit without losing context. Hero collapses
    to a slim band once a result exists, so the result stays above the fold.
============================================================================ %>
<section class="relative bg-navy text-white overflow-hidden">
  <% unless has_result %>
    <div class="absolute inset-0">
      <%= image_tag "monaco-panorama.jpg", alt: "", "aria-hidden": "true",
                    class: "w-full h-full object-cover opacity-25" %>
      <div class="absolute inset-0 bg-gradient-to-b from-navy/85 via-navy/75 to-navy"></div>
    </div>
  <% end %>

  <div class="relative max-w-6xl mx-auto px-6 lg:px-10 <%= has_result ? 'pt-12 pb-20' : 'pt-20 pb-28' %>">
    <p class="<%= font_sans %> text-[11px] font-semibold tracking-[0.3em] uppercase text-gold mb-6">
      <%= t("estimate.hero_eyebrow") %>
    </p>
    <% unless has_result %>
      <h1 class="font-['Domine',Georgia,serif] text-5xl md:text-6xl lg:text-7xl leading-[1.05] tracking-tight font-medium max-w-4xl">
        <%= t("estimate.title") %>
      </h1>
      <div class="mt-10 w-16 h-px bg-gold"></div>
      <p class="<%= font_sans %> mt-10 max-w-2xl text-base text-white/75 leading-relaxed font-light">
        <%= t("estimate.intro") %>
      </p>
    <% else %>
      <h1 class="font-['Domine',Georgia,serif] text-3xl md:text-4xl leading-tight tracking-tight font-medium">
        <%= t("estimate.title") %>
      </h1>
    <% end %>
  </div>
</section>

<section class="relative bg-[#FAF8F4] <%= has_result ? '' : 'pb-20 flex-grow' %>">
  <div class="max-w-4xl mx-auto px-6 lg:px-10 -mt-20 relative z-10 <%= 'pb-12' if has_result %>">

    <% if @errors.present? %>
      <div data-testid="estimate-errors"
           class="mb-6 bg-white border-l-4 border-red-500 px-6 py-4 shadow-sm">
        <p class="<%= font_sans %> text-[11px] font-semibold tracking-[0.25em] uppercase text-red-600 mb-1">
          <%= t("estimate.errors.title") %>
        </p>
        <ul class="text-sm text-dark/85 space-y-1">
          <% @errors.each do |err| %><li><%= err %></li><% end %>
        </ul>
      </div>
    <% end %>

    <%# GET so the result URL carries the inputs and is directly shareable %>
    <form action="<%= form_action %>" method="get"
          class="bg-white shadow-[0_30px_60px_-20px_rgba(9,9,86,0.15)] border border-gray-100 px-8 md:px-12 py-10 md:py-12">

      <p class="<%= font_sans %> text-[10px] font-semibold tracking-[0.3em] uppercase text-gold mb-8">
        <%= t("estimate.form.summary_label") %>
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-8 mb-10">
        <div class="md:col-span-1">
          <label for="district"
                 class="<%= font_sans %> block text-[10px] font-semibold tracking-[0.25em] uppercase text-navy/60 mb-3">
            <%= t("estimate.form.district_label") %>
          </label>
          <div class="relative">
            <select name="<%= district_key %>" id="district" required
                    class="appearance-none w-full bg-transparent border-0 border-b border-navy/20
                           pb-2 pt-1 pr-8 text-lg text-navy font-['Domine',serif]
                           focus:outline-none focus:border-gold transition-colors">
              <option value="" disabled <%= "selected" if @form.nil? || @form[:district].blank? %>></option>
              <% districts.each do |slug, name| %>
                <option value="<%= slug %>" <%= "selected" if @form && @form[:district] == slug %>>
                  <%= name %>
                </option>
              <% end %>
            </select>
            <svg class="pointer-events-none absolute right-1 bottom-3 w-3 h-3 text-navy/50"
                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>

        <div class="md:col-span-1">
          <label for="surface"
                 class="<%= font_sans %> block text-[10px] font-semibold tracking-[0.25em] uppercase text-navy/60 mb-3">
            <%= t("estimate.form.surface_label") %>
          </label>
          <input type="number" name="<%= surface_key %>" id="surface" min="1" step="1" required
                 value="<%= @form && @form[:surface] %>"
                 class="w-full bg-transparent border-0 border-b border-navy/20
                        pb-2 pt-1 text-lg text-navy font-['Domine',serif]
                        focus:outline-none focus:border-gold transition-colors">
        </div>

        <div class="md:col-span-1">
          <label for="construction_year"
                 class="<%= font_sans %> block text-[10px] font-semibold tracking-[0.25em] uppercase text-navy/60 mb-3">
            <%= t("estimate.form.construction_year_label") %>
          </label>
          <input type="number" name="<%= year_key %>" id="construction_year"
                 min="1880" max="<%= Date.current.year %>" step="1" required
                 value="<%= @form && @form[:construction_year] %>"
                 class="w-full bg-transparent border-0 border-b border-navy/20
                        pb-2 pt-1 text-lg text-navy font-['Domine',serif]
                        focus:outline-none focus:border-gold transition-colors">
        </div>
      </div>

      <div class="flex justify-end">
        <button type="submit"
                class="<%= font_sans %> group inline-flex items-center gap-3 bg-navy text-white
                       text-[11px] font-semibold tracking-[0.25em] uppercase
                       px-8 py-4 hover:bg-gold transition-colors duration-300">
          <span><%= has_result ? t("estimate.form.recompute") : t("estimate.form.submit") %></span>
          <% if has_result %>
            <%# Circular refresh arrow — signals "rerun the calculation" %>
            <svg class="w-4 h-4 transition-transform duration-500 group-hover:rotate-180"
                 fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round"
                    d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
            </svg>
          <% else %>
            <%# Right arrow — signals "submit / move forward" %>
            <svg class="w-3 h-3 transition-transform group-hover:translate-x-1"
                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          <% end %>
        </button>
      </div>
    </form>
  </div>
</section>

<% unless has_result %>

  <%# ============================================================================
      EDITORIAL CONTENT — methodology, factors, why a visit matters.
      Renders only when no result is on screen so the result page stays focused.
  ============================================================================ %>
  <section data-testid="estimate-content" class="bg-[#FAF8F4]">

    <%# --- METHOD: 3-step methodology, ivory background, dark type --- %>
    <div data-testid="estimate-content-method"
         class="max-w-6xl mx-auto px-6 lg:px-10 pt-24 md:pt-32 pb-20 md:pb-24">
      <p class="<%= font_sans %> text-[10px] font-semibold tracking-[0.3em] uppercase text-gold mb-5">
        <%= t("estimate.content.method.eyebrow") %>
      </p>
      <h2 class="font-['Domine',serif] text-3xl md:text-4xl lg:text-5xl leading-[1.1] tracking-tight text-navy font-medium max-w-2xl">
        <%= t("estimate.content.method.title") %>
      </h2>
      <div class="mt-8 w-12 h-px bg-gold"></div>

      <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-x-12 gap-y-14">
        <% [ :step1, :step2, :step3 ].each_with_index do |step, idx| %>
          <div>
            <p class="<%= font_sans %> text-[10px] font-semibold tracking-[0.3em] uppercase text-navy/40 mb-5">
              <%= "%02d" % (idx + 1) %>
            </p>
            <h3 class="font-['Domine',serif] text-xl md:text-2xl leading-snug tracking-tight text-navy font-medium">
              <%= t("estimate.content.method.#{step}_title") %>
            </h3>
            <div class="mt-5 w-8 h-px bg-navy/20"></div>
            <p class="<%= font_sans %> mt-5 text-sm leading-relaxed text-navy/70 font-light">
              <%= t("estimate.content.method.#{step}_body") %>
            </p>
          </div>
        <% end %>
      </div>
    </div>

    <%# --- FACTORS: 3 cards on a navy band --- %>
    <div data-testid="estimate-content-factors"
         class="relative bg-navy text-white overflow-hidden">
      <div class="absolute inset-0 opacity-[0.04] pointer-events-none"
           style="background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px); background-size: 80px 80px;"></div>
      <div class="relative max-w-6xl mx-auto px-6 lg:px-10 py-24 md:py-28">
        <p class="<%= font_sans %> text-[10px] font-semibold tracking-[0.3em] uppercase text-gold mb-5">
          <%= t("estimate.content.factors.eyebrow") %>
        </p>
        <h2 class="font-['Domine',serif] text-3xl md:text-4xl lg:text-5xl leading-[1.1] tracking-tight font-medium max-w-3xl">
          <%= t("estimate.content.factors.title") %>
        </h2>
        <div class="mt-8 w-12 h-px bg-gold"></div>

        <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-x-px gap-y-12 md:gap-y-0 bg-white/10">
          <% [ :location, :property, :market ].each do |key| %>
            <div class="bg-navy px-0 md:px-10 py-2 md:py-4">
              <h3 class="font-['Domine',serif] text-2xl leading-tight tracking-tight font-medium">
                <%= t("estimate.content.factors.#{key}_title") %>
              </h3>
              <div class="mt-4 w-8 h-px bg-gold/60"></div>
              <p class="<%= font_sans %> mt-5 text-sm leading-relaxed text-white/70 font-light">
                <%= t("estimate.content.factors.#{key}_body") %>
              </p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# --- EXPERT: editorial bridge to the visit --- %>
    <div data-testid="estimate-content-expert"
         class="bg-[#FAF8F4]">
      <div class="max-w-3xl mx-auto px-6 lg:px-10 py-24 md:py-32 text-center">
        <p class="<%= font_sans %> text-[10px] font-semibold tracking-[0.3em] uppercase text-gold mb-5">
          <%= t("estimate.content.expert.eyebrow") %>
        </p>
        <h2 class="font-['Domine',serif] text-3xl md:text-4xl lg:text-5xl leading-[1.1] tracking-tight text-navy font-medium">
          <%= t("estimate.content.expert.title") %>
        </h2>
        <div class="mt-8 mx-auto w-12 h-px bg-gold"></div>
        <p class="<%= font_sans %> mt-10 text-base md:text-lg leading-relaxed text-navy/75 font-light">
          <%= t("estimate.content.expert.body") %>
        </p>
      </div>
    </div>
  </section>

  <%# ============================================================================
      FAQ — native disclosure (details/summary) so it works without JS.
  ============================================================================ %>
  <section data-testid="estimate-faq" class="bg-white border-t border-navy/5">
    <div class="max-w-4xl mx-auto px-6 lg:px-10 py-24 md:py-32">
      <p class="<%= font_sans %> text-[10px] font-semibold tracking-[0.3em] uppercase text-gold mb-5">
        <%= t("estimate.faq.eyebrow") %>
      </p>
      <h2 class="font-['Domine',serif] text-3xl md:text-4xl lg:text-5xl leading-[1.1] tracking-tight text-navy font-medium">
        <%= t("estimate.faq.title") %>
      </h2>
      <div class="mt-8 w-12 h-px bg-gold"></div>

      <div class="mt-16 divide-y divide-navy/10 border-t border-navy/10">
        <% %i[accuracy free difference why method factors time].each do |key| %>
          <details class="group">
            <summary class="cursor-pointer list-none flex items-start justify-between gap-6 py-7
                            hover:text-gold transition-colors duration-200">
              <span class="font-['Domine',serif] text-lg md:text-xl leading-snug tracking-tight text-navy
                           group-hover:text-gold transition-colors">
                <%= t("estimate.faq.items.#{key}.q") %>
              </span>
              <%# Plus → minus rotation; SVG with two strokes, vertical stroke fades on open %>
              <span class="shrink-0 mt-1 relative w-4 h-4 text-navy/60 group-hover:text-gold transition-colors">
                <span class="absolute inset-x-0 top-1/2 h-px bg-current -translate-y-1/2"></span>
                <span class="absolute inset-y-0 left-1/2 w-px bg-current -translate-x-1/2
                             transition-transform duration-300 group-open:rotate-90 group-open:opacity-0"></span>
              </span>
            </summary>
            <div class="pb-8 pr-10 -mt-1">
              <p class="<%= font_sans %> text-sm md:text-[15px] leading-relaxed text-navy/70 font-light max-w-3xl">
                <%= t("estimate.faq.items.#{key}.a") %>
              </p>
            </div>
          </details>
        <% end %>
      </div>
    </div>
  </section>

<% end %>

<% if has_result
     district_slug = @result[:inputs][:district]
     district_name = PropertyValuator::DISTRICT_NAMES[district_slug]
     district_baseline = PropertyValuator::CURRENT_PRICES[district_slug]
     history = PropertyValuator::PRICE_HISTORY[district_slug]
     years = PropertyValuator::HISTORY_YEARS

     spark_w = 600
     spark_h = 80
     min_h, max_h = history.minmax
     span = (max_h - min_h).nonzero? || 1
     points = history.each_with_index.map do |v, i|
       x = (i.to_f / (history.size - 1) * spark_w).round(1)
       y = (spark_h - ((v - min_h).to_f / span) * spark_h).round(1)
       [ x, y ]
     end
     polyline = points.map { |x, y| "#{x},#{y}" }.join(" ")
     last_x, last_y = points.last
     growth_pct = (((history.last - history.first).to_f / history.first) * 100).round(1)

     low = @result[:low_estimate]
     high = @result[:high_estimate]
     mid = @result[:total_estimate]
     mid_pct = ((mid - low).to_f / (high - low) * 100).round(1)
     uncertainty = high - low

     # Delta vs district baseline: how the user's price/m² compares to district avg
     delta_vs_baseline = ((@result[:price_per_m2] - district_baseline).to_f / district_baseline * 100).round(1)
     start_price = history.first
     end_price = history.last

     surface = @result[:inputs][:surface]
     construction_year = @result[:inputs][:construction_year]
%>

  <%# RESULT BILLBOARD %>
  <section data-testid="estimate-result"
           class="relative bg-navy text-white overflow-hidden">
    <%# Decorative grid background %>
    <div class="absolute inset-0 opacity-[0.04] pointer-events-none"
         style="background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px); background-size: 80px 80px;">
    </div>

    <%# Subtle inner vignette so the block has its own atmosphere distinct from footer navy %>
    <div class="absolute inset-0 pointer-events-none"
         style="background: radial-gradient(ellipse at center, transparent 0%, transparent 55%, rgba(0,0,0,0.35) 100%);"></div>

    <div class="relative max-w-6xl mx-auto px-6 lg:px-10 py-16 md:py-20">

      <%# Eyebrow %>
      <div class="flex items-baseline gap-6 mb-10">
        <p class="<%= font_sans %> text-[10px] font-semibold tracking-[0.3em] uppercase text-gold">
          <%= t("estimate.result.title") %>
        </p>
        <span class="text-white/30 text-xs"><%= district_name %></span>
      </div>

      <%# === HERO ROW: Total + Price/m² === %>
      <div class="grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] gap-y-12 gap-x-12 lg:gap-x-16 mb-16 items-end">
        <%# Total estimate %>
        <%# Font size shrinks for 8-digit values so 100M+ properties don't wrap. %>
        <% total_size_class = mid >= 100_000_000 ? "text-4xl md:text-5xl lg:text-6xl" :
                              mid >= 10_000_000  ? "text-5xl md:text-6xl lg:text-7xl" :
                                                   "text-6xl md:text-7xl lg:text-8xl" %>
        <div class="min-w-0">
          <p class="<%= font_sans %> text-[10px] font-semibold tracking-[0.3em] uppercase text-white/50 mb-4">
            <%= t("estimate.result.total") %>
          </p>
          <p class="font-['Domine',serif] <%= total_size_class %> leading-[0.95] tracking-tight font-medium whitespace-nowrap">
            <%= number_with_delimiter(mid, delimiter: " ") %><span class="text-white/40 ml-2" style="font-size: 0.6em;">€</span>
          </p>
        </div>

        <%# Price/m² + delta %>
        <div class="lg:border-l lg:border-white/10 lg:pl-12">
          <p class="<%= font_sans %> text-[10px] font-semibold tracking-[0.3em] uppercase text-white/50 mb-4">
            <%= t("estimate.result.price_per_m2") %>
          </p>
          <p class="font-['Domine',serif] text-3xl md:text-4xl leading-tight tracking-tight font-medium whitespace-nowrap">
            <%= number_with_delimiter(@result[:price_per_m2], delimiter: " ") %><span class="<%= font_sans %> text-white/50 text-sm font-normal tracking-wide ml-2">€/m²</span>
          </p>
          <%# Delta vs district baseline — the comparison, not the raw number %>
          <% delta_color = delta_vs_baseline >= 0 ? "text-gold" : "text-white/70" %>
          <% delta_arrow = delta_vs_baseline >= 0 ? "↑" : "↓" %>
          <p class="<%= font_sans %> mt-4 text-xs leading-relaxed">
            <span class="<%= delta_color %> font-semibold tracking-wide">
              <%= delta_arrow %> <%= delta_vs_baseline.abs %>&thinsp;%
            </span>
            <span class="text-white/40"><%= t("estimate.result.delta_baseline_suffix", district: district_name) %></span>
          </p>
        </div>

      </div>

      <%# === RANGE BAR — full width, with uncertainty story === %>
      <div class="mb-20">
        <p class="<%= font_sans %> text-[10px] font-semibold tracking-[0.3em] uppercase text-white/50 mb-4">
          <%= t("estimate.result.band_label") %>
        </p>

        <div class="relative h-px bg-white/15">
          <div class="absolute inset-y-0 left-0 right-0 bg-gradient-to-r from-white/10 via-gold/40 to-white/10"></div>
          <div class="absolute -top-1.5 w-3 h-3 bg-gold rounded-full ring-4 ring-navy"
               style="left: <%= mid_pct %>%; transform: translateX(-50%);"></div>
          <div class="absolute -top-1 left-0 w-1.5 h-1.5 bg-white/40 rounded-full"></div>
          <div class="absolute -top-1 right-0 w-1.5 h-1.5 bg-white/40 rounded-full"
               style="transform: translateX(50%);"></div>
        </div>

        <div class="<%= font_sans %> mt-5 flex items-baseline justify-between text-sm">
          <div>
            <span class="text-white/40 text-[10px] tracking-[0.2em] uppercase"><%= t("estimate.result.range_low") %></span>
            <span class="font-['Domine',serif] text-xl ml-3"><%= number_with_delimiter(low, delimiter: " ") %> €</span>
          </div>
          <div class="text-right">
            <span class="text-white/40 text-[10px] tracking-[0.2em] uppercase"><%= t("estimate.result.range_high") %></span>
            <span class="font-['Domine',serif] text-xl ml-3"><%= number_with_delimiter(high, delimiter: " ") %> €</span>
          </div>
        </div>
      </div>

      <%# === SPARKLINE — full width, with annotated endpoints === %>
      <div class="mb-16">
        <div class="flex items-baseline justify-between mb-6">
          <p class="<%= font_sans %> text-[10px] font-semibold tracking-[0.3em] uppercase text-white/50">
            <%= district_name %> · <%= t("estimate.result.chart_title") %>
          </p>
          <p class="<%= font_sans %> text-sm">
            <span class="text-white/40"><%= t("estimate.result.year_label", year: years.first) %></span>
            <span class="font-['Domine',serif] text-base ml-1"><%= number_with_delimiter(start_price, delimiter: " ") %> €</span>
            <span class="text-white/30 mx-3">→</span>
            <span class="text-white/40"><%= t("estimate.result.year_label", year: years.last) %></span>
            <span class="font-['Domine',serif] text-base text-gold ml-1"><%= number_with_delimiter(end_price, delimiter: " ") %> €</span>
            <span class="<%= font_sans %> text-gold ml-3 font-semibold">
              <%= growth_pct >= 0 ? "+" : "" %><%= growth_pct %>&thinsp;%
            </span>
          </p>
        </div>

        <div class="relative" data-controller="price-chart">
          <svg viewBox="0 0 <%= spark_w %> <%= spark_h + 30 %>"
               preserveAspectRatio="none"
               class="w-full h-32"
               data-price-chart-target="svg"
               xmlns="http://www.w3.org/2000/svg">
            <polygon
              points="0,<%= spark_h %> <%= polyline %> <%= spark_w %>,<%= spark_h %>"
              fill="url(#sparkGradient)" opacity="0.4" />
            <polyline points="<%= polyline %>" fill="none" stroke="#C5A355" stroke-width="2.5"
                      stroke-linecap="round" stroke-linejoin="round" />
            <%# Start marker %>
            <circle cx="<%= points.first[0] %>" cy="<%= points.first[1] %>" r="3" fill="#C5A355" opacity="0.5" />
            <%# End marker %>
            <circle cx="<%= last_x %>" cy="<%= last_y %>" r="5" fill="#C5A355" />
            <circle cx="<%= last_x %>" cy="<%= last_y %>" r="10" fill="#C5A355" opacity="0.25" />

            <%# Hover guide line (vertical, follows cursor's year) %>
            <line data-price-chart-target="guide"
                  x1="0" y1="0" x2="0" y2="<%= spark_h %>"
                  stroke="#C5A355" stroke-width="1" stroke-dasharray="2,3"
                  opacity="0.5" class="opacity-0 transition-opacity pointer-events-none" />

            <%# Hover dot (highlights the active data point) %>
            <circle data-price-chart-target="dot"
                    r="5" fill="#C5A355" stroke="#090956" stroke-width="2"
                    class="opacity-0 transition-opacity pointer-events-none" />

            <%# Invisible hit zones — one per year, full chart height %>
            <% points.each_with_index do |(x, y), i|
                 prev_x = i == 0 ? 0 : (points[i-1][0] + x) / 2.0
                 next_x = i == points.size - 1 ? spark_w : (x + points[i+1][0]) / 2.0
                 width = (next_x - prev_x).round(2)
            %>
              <rect x="<%= prev_x.round(2) %>" y="0"
                    width="<%= width %>" height="<%= spark_h %>"
                    fill="transparent"
                    data-cx="<%= x %>"
                    data-cy="<%= y %>"
                    data-year="<%= years[i] %>"
                    data-price="<%= number_with_delimiter(history[i], delimiter: " ") %> €/m²"
                    data-action="mouseenter->price-chart#show mouseleave->price-chart#hide touchstart->price-chart#show"
                    style="cursor: pointer;" />
            <% end %>

            <defs>
              <linearGradient id="sparkGradient" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#C5A355" stop-opacity="0.5" />
                <stop offset="100%" stop-color="#C5A355" stop-opacity="0" />
              </linearGradient>
            </defs>
          </svg>

          <%# Floating tooltip — anchored to cursor's data point, positioned in JS %>
          <div data-price-chart-target="tooltip"
               class="<%= font_sans %> opacity-0 transition-opacity duration-150 pointer-events-none
                      absolute top-0 left-0
                      bg-navy border border-gold/40 px-3 py-2 shadow-xl whitespace-nowrap z-10">
            <p class="text-[9px] tracking-[0.25em] uppercase text-gold mb-1"
               data-price-chart-target="tooltipYear">2025</p>
            <p class="font-['Domine',serif] text-base text-white"
               data-price-chart-target="tooltipPrice">71 167 €/m²</p>
          </div>

          <div class="<%= font_sans %> flex justify-between mt-2 text-[10px] text-white/40 tracking-wide">
            <span>2016</span>
            <span>2020</span>
            <span class="text-gold">2025</span>
          </div>
        </div>
      </div>

      <%# === BRIDGE — the 51%/49% statistic frames why a visit matters === %>
      <div class="pt-12 border-t border-white/10">
        <p class="<%= font_sans %> text-sm text-white/70 leading-relaxed max-w-3xl">
          <%= t("estimate.result.bridge_html",
                explained: '<span class="text-gold font-semibold">51&thinsp;%</span>'.html_safe,
                remainder: '<span class="text-gold font-semibold">49&thinsp;%</span>'.html_safe) %>
        </p>
        <p class="<%= font_sans %> mt-6 text-[10px] tracking-[0.2em] uppercase text-white/30">
          <%= t("estimate.result.source_label") %>
          <a href="https://imsee.mc/thematiques/economie/publications/observatoire-de-l-immobilier"
             target="_blank" rel="noopener noreferrer"
             class="hover:text-gold transition-colors underline decoration-white/20 underline-offset-4">
            <%= t("estimate.result.source_attribution") %>
          </a>
        </p>
      </div>
    </div>
  </section>

  <%# === EXPERT FORM — dedicated section under the result billboard === %>
  <% expert_submission = @submission || InformationRequest.new %>
  <section data-testid="estimate-expert-form" class="bg-[#FAF8F4]">
    <div class="max-w-6xl mx-auto px-6 lg:px-10 py-20 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-[5fr_7fr] gap-x-16 gap-y-10">

        <%# Left rail: framing + reassurance %>
        <div>
          <p class="<%= font_sans %> text-[10px] font-semibold tracking-[0.3em] uppercase text-gold mb-5">
            <%= t("estimate.expert_form.eyebrow") %>
          </p>
          <h2 class="font-['Domine',serif] text-3xl md:text-4xl leading-[1.1] tracking-tight text-navy font-medium">
            <%= t("estimate.expert_form.title") %>
          </h2>
          <div class="mt-6 w-12 h-px bg-gold"></div>
          <p class="<%= font_sans %> mt-6 text-sm leading-relaxed text-navy/70 max-w-md">
            <%= t("estimate.expert_form.lede") %>
          </p>
          <p class="<%= font_sans %> mt-8 text-[10px] tracking-[0.2em] uppercase text-navy/40">
            <%= t("estimate.expert_form.privacy_note") %>
          </p>
        </div>

        <%# Right rail: the form itself %>
        <div class="bg-white shadow-[0_30px_60px_-20px_rgba(9,9,86,0.15)] border border-navy/5 px-8 md:px-10 py-10">
          <% if expert_submission.errors.any? %>
            <div data-testid="form-errors" class="mb-6 border-l-4 border-red-500 bg-red-50 px-5 py-3">
              <ul class="<%= font_sans %> text-xs text-red-700 space-y-1">
                <% expert_submission.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%= form_with(model: expert_submission, url: information_requests_path, method: :post, local: true,
                       html: { class: "space-y-6", "data-turbo": "false" }) do |f| %>

            <%# Honeypot %>
            <div class="absolute -left-[9999px]">
              <label for="estimate_website">Website</label>
              <input type="text" name="website" id="estimate_website" tabindex="-1" autocomplete="off">
            </div>

            <%# Carries the inputs that produced the estimate so the expert receives full context %>
            <input type="hidden" name="return_to" value="estimate">
            <input type="hidden" name="estimate[district]" value="<%= @result[:inputs][:district] %>">
            <input type="hidden" name="estimate[surface]" value="<%= @result[:inputs][:surface] %>">
            <input type="hidden" name="estimate[construction_year]" value="<%= @result[:inputs][:construction_year] %>">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-6">
              <div>
                <label for="information_request_name"
                       class="<%= font_sans %> block text-[10px] font-semibold tracking-[0.25em] uppercase text-navy/60 mb-2">
                  <%= t("estimate.expert_form.name_label") %>
                </label>
                <%= f.text_field :name, required: true,
                      placeholder: t("estimate.expert_form.name_placeholder"),
                      class: "w-full bg-transparent border-0 border-b border-navy/20
                              pb-2 pt-1 text-base text-navy font-['Domine',serif]
                              placeholder:text-navy/25 placeholder:font-light
                              focus:outline-none focus:border-gold transition-colors" %>
              </div>
              <div>
                <label for="information_request_phone"
                       class="<%= font_sans %> block text-[10px] font-semibold tracking-[0.25em] uppercase text-navy/60 mb-2">
                  <%= t("estimate.expert_form.phone_label") %>
                </label>
                <%= f.telephone_field :phone,
                      placeholder: t("estimate.expert_form.phone_placeholder"),
                      class: "w-full bg-transparent border-0 border-b border-navy/20
                              pb-2 pt-1 text-base text-navy font-['Domine',serif]
                              placeholder:text-navy/25 placeholder:font-light
                              focus:outline-none focus:border-gold transition-colors" %>
              </div>
            </div>

            <div>
              <label for="information_request_email"
                     class="<%= font_sans %> block text-[10px] font-semibold tracking-[0.25em] uppercase text-navy/60 mb-2">
                <%= t("estimate.expert_form.email_label") %>
              </label>
              <%= f.email_field :email, required: true,
                    placeholder: t("estimate.expert_form.email_placeholder"),
                    class: "w-full bg-transparent border-0 border-b border-navy/20
                            pb-2 pt-1 text-base text-navy font-['Domine',serif]
                            placeholder:text-navy/25 placeholder:font-light
                            focus:outline-none focus:border-gold transition-colors" %>
            </div>

            <div class="pt-2 flex justify-end">
              <%= f.submit t("estimate.expert_form.submit"),
                    class: "#{font_sans} group inline-flex items-center gap-3 bg-navy text-white
                            text-[11px] font-semibold tracking-[0.25em] uppercase
                            px-8 py-4 hover:bg-gold hover:text-navy transition-colors duration-300 cursor-pointer" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>
<% end %>
